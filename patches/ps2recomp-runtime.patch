+#pragma once
+// PS2 IPU (image processing unit), the parts games use to play IPU movies:
+// BCLR, IDEC (intra MPEG macroblocks -> RGB32/RGB16 via CSC), FDEC, SETIQ
+// (ignored: the default intra matrix is used), SETVQ (ignored), SETTH.
+// Commands run to completion when written; input comes from a callback that
+// fetches the next quadword from the toIPU DMA (channel 4), output macroblocks
+// queue up for the fromIPU DMA (channel 3).
+#include <array>
+#include <cstdint>
+#include <deque>
+#include <functional>
+#include <vector>
+
+class Ps2Ipu
+{
+public:
+    using FetchFn = std::function<bool(uint8_t qword[16])>;
+
+    explicit Ps2Ipu(FetchFn fetch);
+
+    void reset();
+    void writeCmd(uint32_t value);
+    uint32_t readCmd() const { return m_cmdResult; }
+    void writeCtrl(uint32_t value);
+    uint32_t readCtrl() const;
+    uint32_t readBp() const;
+    uint32_t readTop();
+
+    // Output FIFO (fromIPU).
+    size_t outputQwords() const { return (m_out.size() - m_outRead) / 16u; }
+    bool popOutput(uint8_t qword[16]);
+
+    // Quadwords fetched from the input but not yet consumed (what BP/IFC/FP report).
+    size_t bufferedQwords() const { return m_in.size(); }
+
+private:
+    // Bit reader over fetched input quadwords.
+    bool ensureBits(uint32_t bits);
+    uint32_t peekBits(uint32_t bits);
+    void skipBits(uint32_t bits);
+    uint32_t getBits(uint32_t bits) { const uint32_t v = peekBits(bits); skipBits(bits); return v; }
+    void alignByte();
+    void dropConsumed();
+
+    void idec(uint32_t cmd);
+    bool decodeIntraBlock(int component, int16_t coeffs[64], bool mpeg2, bool altScan, bool vlcB15,
+                          int quantScale, int dcMultiplier);
+    int decodeVlc(const uint16_t (*table)[2], int count);
+    int decodeDcSize(bool luma);
+    int decodeMbai();
+
+    FetchFn m_fetch;
+    std::deque<std::array<uint8_t, 16>> m_in;
+    uint32_t m_bitPos = 0;      // within m_in.front()
+    uint32_t m_pendingBp = 0;   // BCLR position for the next fetched quadword
+    bool m_starved = false;
+
+    std::vector<uint8_t> m_out;
+    size_t m_outRead = 0;
+
+    uint32_t m_ctrl = 0;
+    uint32_t m_cmdResult = 0;
+    uint32_t m_th0 = 0, m_th1 = 0;
+    int m_dcPred[3]{};
+};
