+        Vu1ProgramStats &p = g_vu1Stats[startPC];
+        ++p.calls;
+        p.cycles += cycles;
+        p.hostNs += hostNs;
+        if (st.ebit)
+            ++p.ended;
+        else if (cycles >= budget)
+            ++p.budget;
+        if (cycles > p.maxCycles)
+            p.maxCycles = cycles;
+    }
