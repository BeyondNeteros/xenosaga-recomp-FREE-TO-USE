+// Top VU1 programs by host time since the last report, then resets.
+std::string ps2x_vu1StatsReport()
+{
+    std::vector<std::pair<uint32_t, Vu1ProgramStats>> rows;
+    {
+        std::lock_guard<std::mutex> lock(g_vu1StatsMutex);
+        rows.assign(g_vu1Stats.begin(), g_vu1Stats.end());
+        g_vu1Stats.clear();
+    }
+    std::sort(rows.begin(), rows.end(), [](const auto &a, const auto &b) { return a.second.hostNs > b.second.hostNs; });
+    std::string out;
+    char line[256];
+    for (size_t i = 0; i < rows.size() && i < 6; ++i)
+    {
+        const Vu1ProgramStats &p = rows[i].second;
+        std::snprintf(line, sizeof(line),
+                      "  vu1 prog 0x%04x: %llu calls, %.0f cyc/call (max %llu), %.1f us/call, %.1f ns/cyc, ebit %llu budget %llu\n",
+                      rows[i].first, (unsigned long long)p.calls, double(p.cycles) / p.calls, (unsigned long long)p.maxCycles,
+                      p.hostNs / 1000.0 / p.calls, p.cycles ? double(p.hostNs) / p.cycles : 0.0,
+                      (unsigned long long)p.ended, (unsigned long long)p.budget);
+        out += line;
+    }
+    return out;
+}
