+    // Program ended (E-bit pair and its delay pair done); pc = next pair.
+    static PS2X_VU1_INLINE bool nEnd(Vu &vu, uint32_t pc, uint64_t pairs)
+    {
+        vu.m_state.pc = pc;
+        vu.m_cycle += pairs;
+        vu.m_state.cycles = vu.m_cycle;
+        return true;
+    }
+};
