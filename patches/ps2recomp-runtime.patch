+    // hybrid CPUs (P- and E-cores) Windows puts higher-priority threads on
+    // P-cores: the VIF1/VU1 worker sets the frame rate, the GS band helpers
+    // have headroom.
+    void setHostThreadPriority(int priority)
+    {
+#ifdef _WIN32
+        static const bool enabled = [] {
+            const char *env = std::getenv("PS2X_THREAD_PRIORITIES");
+            return !(env && env[0] == '0');
+        }();
+        if (enabled)
+            SetThreadPriority(GetCurrentThread(), priority);
+#else
+        (void)priority;
+#endif
+    }
+}
+
+void PS2Memory::vif1WorkerLoop()
+{
+    t_onVif1Worker = true;
+    setHostThreadPriority(2); // THREAD_PRIORITY_HIGHEST
+    std::unique_lock<std::mutex> lock(m_vif1Mutex);
+    for (;;)
+    {
+        m_vif1Cv.wait(lock, [&] { return m_vif1Stop || m_vif1JobReady; });
+        if (m_vif1Stop)
+            return;
+        m_vif1JobReady = false;
+        std::vector<PendingTransfer> job;
+        job.swap(m_vif1Job);
+        lock.unlock();
+        for (const PendingTransfer &p : job)
+            processVIF1Data(p.chainData.data(), static_cast<uint32_t>(p.chainData.size()));
+        if (m_gifArbiter)
+            m_gifArbiter->drain();
+        lock.lock();
+        m_vif1JobDone = true;
+        m_vif1Cv.notify_all();
+    }
+}
+
+namespace
+{
+    // PS2X_VIF1_SYNCLOG=1: which host call sites make the EE wait for the
+    // VIF1/VU1 worker, by return address (resolve with addr2line).
+    uint32_t g_vif1WaitAddress = 0;
+    void noteVif1Wait(void *site, uint64_t ns)
+    {
+        site = reinterpret_cast<void *>(reinterpret_cast<uintptr_t>(site) ^ (static_cast<uintptr_t>(g_vif1WaitAddress) << 32));
+        g_vif1WaitAddress = 0;
+        static const bool enabled = std::getenv("PS2X_VIF1_SYNCLOG") != nullptr;
+        if (!enabled)
+            return;
+        struct Entry { void *site; uint64_t count; uint64_t ns; };
+        static Entry entries[64]{};
+        static auto nextPrint = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+        for (Entry &e : entries)
+        {
+            if (e.site == site || e.site == nullptr)
+            {
+                e.site = site;
+                ++e.count;
+                e.ns += ns;
+                break;
+            }
+        }
+        const auto now = std::chrono::steady_clock::now();
+        if (now < nextPrint)
+            return;
+        nextPrint = now + std::chrono::seconds(5);
+        std::printf("[vif1-wait]");
+        for (Entry &e : entries)
+        {
+            if (e.site && e.count)
+                std::printf(" %p:%llu/%.1fms", e.site, static_cast<unsigned long long>(e.count), e.ns / 1e6);
+            e = Entry{};
+            e.ns = 0;
+        }
+        std::printf("\n");
+    }
+}
+
+void PS2Memory::syncVif1()
+{
+    if (!m_vif1Busy.load(std::memory_order_acquire) || t_onVif1Worker)
+        return;
+    {
+        ps2_profile::Scope waitScope(ps2_profile::Vif1Wait);
+        const auto waitStart = std::chrono::steady_clock::now();
+        std::unique_lock<std::mutex> lock(m_vif1Mutex);
+        m_vif1Cv.wait(lock, [&] { return m_vif1JobDone; });
+        m_vif1JobDone = false;
+        noteVif1Wait(__builtin_return_address(0),
+                     static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                         std::chrono::steady_clock::now() - waitStart).count()));
+    }
+    m_vif1Busy.store(false, std::memory_order_release);
+    g_vif1Peeks.store(0u, std::memory_order_relaxed);
+    completeDmacChannel(0x10009000u, 1u);
+    m_ioRegisters[0x10009020u] = 0u; // QWC
+    if (m_vif1CompleteHook)
+        m_vif1CompleteHook();
+}
+
+bool PS2Memory::pollVif1()
+{
+    if (!m_vif1Busy.load(std::memory_order_acquire) || t_onVif1Worker)
+        return false;
+    {
+        std::lock_guard<std::mutex> lock(m_vif1Mutex);
+        if (!m_vif1JobDone)
+            return false;
+    }
+    syncVif1();
+    return true;
 }
 
