+bool VU1Interpreter::staticEntryOk(const StaticBlock &block) const
+{
+    const uint64_t entry = m_cycle;
+    for (const StaticLane &l : block.liveIns)
+    {
+        const uint64_t limit = entry + l.offset;
+        if (limit >= m_readyMax)
+            break; // sorted by offset: every later live-in is ready too
+        if (l.kind == 1)
+        {
+            if (m_viReady[l.reg] > limit)
+                return false;
+            continue;
+        }
+        const std::array<uint64_t, 4> &lanes = l.kind == 0 ? m_vfReady[l.reg] : m_accReady;
+        for (uint32_t c = 0; c < 4u; ++c)
+            if (((l.lane >> c) & 1u) && lanes[c] > limit)
+                return false;
+    }
+    if (block.fdivFirst != 0xFFFFu && m_fdiv.valid && m_fdiv.readyCycle > entry + block.fdivFirst)
+        return false;
+    if (block.efuOpFirst != 0xFFFFu && m_efuResourceReady > entry + block.efuOpFirst)
+        return false;
+    if (block.efuEntryFirst != 0xFFFFu)
+        for (const ScalarPipelineEntry &e : m_efu)
+            if (e.valid && e.readyCycle > entry + block.efuEntryFirst)
+                return false;
+    if (block.hasXgkick && m_xgkick.active)
+        return false;
+    return true;
+}
+
+// Runs a block on its precomputed schedule: same per-pair code and the same
+// per-cycle commits/XGKICK progress as the dynamic loop (cycle by cycle while
+// a kick is active; otherwise pending commits are applied at the next pair's
+// cycle, which only flags/FDIV could observe and they are ordered by their
+// own ready cycles).
+bool VU1Interpreter::runStaticBlock(const StaticBlock &block, uint32_t startIndex, uint32_t codeSize, uint8_t *vuData,
+                                    uint32_t dataSize, GS &gs, PS2Memory *memory)
+{
+    if (block.compiled)
+        return block.compiled(*this, block, startIndex, codeSize, vuData, dataSize, gs, memory);
+    const uint64_t entry = m_cycle;
+    bool ended = false;
+    for (uint32_t i = 0; i < block.pairCount; ++i)
+    {
+        if (i > 0u)
+        {
+            const uint64_t target = entry + block.offsets[i];
+            if (m_xgkick.active)
+                advanceTo(target);
+            else
+            {
+                m_cycle = target;
+                m_state.cycles = target;
+            }
+            if (m_cycle >= m_nextCommit)
+                commitReadyPipelines();
+        }
+        const DecodedInstructionPair &decoded = m_decodedCodeCache[startIndex + i];
+        if (const uint8_t plain = block.plain[i])
+        {
+            if (plain & 8u)
+            {
+                // Leaves the branch-VI backup it may have recorded in place.
+                execPairDirect(decoded, vuData, dataSize, gs, memory, false);
+            }
+            else
+            {
+                if (plain & 2u)
+                    execUpper(decoded.upper);
+                if (plain & 4u)
+                    execLower(decoded.lower, vuData, dataSize, gs, memory, decoded.upper);
+                m_viBranchBackupValid = false;
+            }
+            m_state.vf[0][0] = 0.0f;
+            m_state.vf[0][1] = 0.0f;
+            m_state.vf[0][2] = 0.0f;
+            m_state.vf[0][3] = 1.0f;
+            m_state.vi[0] = 0;
+            m_state.pc += 8u;
+            continue;
+        }
+        execPairDirect(decoded, vuData, dataSize, gs, memory, false);
+        ended = finishPair(decoded, codeSize);
+        if (ended && i + 1u != block.pairCount)
+            break; // cannot happen with the block rules; keep the state sane
+    }
+    return finishStaticBlock(block, entry, ended);
+}
