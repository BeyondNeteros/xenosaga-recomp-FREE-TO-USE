+                uint stored = imageLoad(uDepth, p).r;
+                pass = s4.x == 2 ? z >= stored : z > stored;
+            }
+        }
+        if (pass)
+        {
+            if (writeRgb || writeA)
+            {
+                ivec4 d = ivec4(dst & 255u, (dst >> 8) & 255u, (dst >> 16) & 255u, dst >> 24);
+                ivec3 rgb = c.rgb;
+                if (s4.z != 0 && !(s7.z != 0 && (c.a & 128) == 0))
+                {
+                    int ca = s5.z == 0 ? c.a : (s5.z == 1 ? d.a : s6.x);
+                    for (int i = 0; i < 3; ++i)
+                    {
+                        int v = ((pick(s5.x, c[i], d[i]) - pick(s5.y, c[i], d[i])) * ca >> 7) + pick(s5.w, c[i], d[i]);
+                        rgb[i] = clamp(v, 0, 255);
+                    }
+                }
+                int a = c.a;
+                if (writeA && s4.w != 0) a |= 128;
+                uint pixel = uint(rgb.r) | (uint(rgb.g) << 8) | (uint(rgb.b) << 16) | (uint(a) << 24);
+                if (s9.x != 0u) pixel = (pixel & ~s9.x) | (dst & s9.x);
+                if (writeRgb && !writeA) pixel = (pixel & 0x00FFFFFFu) | (dst & 0xFF000000u);
+                imageStore(uFrame, p, uvec4(pixel));
+            }
+            if (writeZ && s4.y != 0)
+                imageStore(uDepth, p, uvec4(z & s9.y));
+        }
+    }
+    endInvocationInterlockARB();
+}
+)GLSL";
+
+#pragma pack(push, 1)
+    struct GpuVertex
+    {
+        float x, y, z;
+        float s, t, q;
+        uint8_t r, g, b, a;
+        float fog;
+    };
+#pragma pack(pop)
+
+    struct StateBlock
+    {
+        int32_t s0[4], s1[4], s2[4], s3[4], s4[4], s5[4], s6[4], s7[4], s8[4];
+        uint32_t s9[4];
+    };
+
+    struct DrawKey
+    {
+        StateBlock block;
+        GLuint frameTex, depthTex, tex;
+        int32_t scissor[4];
+        GLenum mode;
+        bool operator==(const DrawKey &o) const { return std::memcmp(this, &o, sizeof(DrawKey)) == 0; }
+    };
+
+    inline bool isT8(uint8_t psm) { return psm == GS_PSM_T8 || psm == GS_PSM_T8H; }
+    inline bool isT4(uint8_t psm) { return psm == GS_PSM_T4 || psm == GS_PSM_T4HL || psm == GS_PSM_T4HH; }
+
+    uint32_t texaExpand(const GSTexaReg &texa, uint8_t psm, uint32_t texel)
+    {
+        const bool rgbZero = (texel & 0x00FFFFFFu) == 0u;
+        uint8_t a = static_cast<uint8_t>(texel >> 24);
+        if (psm == GS_PSM_CT24)
+            a = (texa.aem && rgbZero) ? 0u : texa.ta0;
+        else if ((a & 0x80u) != 0u)
+            a = texa.ta1;
+        else
+            a = (texa.aem && rgbZero) ? 0u : texa.ta0;
+        return (texel & 0x00FFFFFFu) | (static_cast<uint32_t>(a) << 24);
+    }
+
+    uint32_t expand5551(uint32_t c)
+    {
+        const uint32_t r = (c & 0x1Fu) << 3, g = ((c >> 5) & 0x1Fu) << 3, b = ((c >> 10) & 0x1Fu) << 3;
+        return r | (g << 8) | (b << 16) | ((c & 0x8000u) ? 0x80000000u : 0u);
+    }
+
+    // Texture page geometry for a pixel format (8 KB pages).
+    void pageSize(uint8_t psm, uint32_t &w, uint32_t &h)
+    {
+        switch (psm)
+        {
+        case GS_PSM_CT16:
+        case GS_PSM_CT16S:
+        case GS_PSM_Z16:
+        case GS_PSM_Z16S:
+            w = 64u;
+            h = 64u;
+            break;
+        case GS_PSM_T8:
+            w = 128u;
+            h = 64u;
+            break;
+        case GS_PSM_T4:
+            w = 128u;
+            h = 128u;
+            break;
+        default:
+            w = 64u;
+            h = 32u;
+            break;
+        }
+    }
+
+    // Pages per row of a buffer `bw` (in 64-pixel units) wide.
+    uint32_t pagesWide(uint8_t psm, uint32_t bw)
+    {
+        uint32_t w, h;
+        pageSize(psm, w, h);
+        return std::max(1u, (std::max(bw, 1u) * 64u + w - 1u) / w);
+    }
+}
