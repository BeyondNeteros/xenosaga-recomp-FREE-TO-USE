+// SPU2 output (ps2xIOP) through a raylib audio stream: the audio thread
+// pulls 48 kHz stereo straight from the emulated sound chip, so pitch stays
+// right even when the game runs below full speed. PS2X_SPU2_OUTPUT=0 mutes it.
+static ps2x::iop::IopSubsystem *s_spu2Source = nullptr;
+
+static void Spu2AudioCallback(void *buffer, unsigned int frames)
+{
+    if (s_spu2Source)
+        s_spu2Source->renderAudio(static_cast<int16_t *>(buffer), frames);
+    else
+        std::memset(buffer, 0, static_cast<size_t>(frames) * 4u);
+    // PS2X_SPU2_WAV=<file>: also record the output as raw 48 kHz stereo s16.
+    static FILE *record = []() -> FILE * {
+        const char *path = std::getenv("PS2X_SPU2_WAV");
+        return path ? std::fopen(path, "wb") : nullptr;
+    }();
+    if (record)
+        std::fwrite(buffer, 4u, frames, record);
+}
+
+static void startSpu2AudioStream(ps2x::iop::IopSubsystem *iop)
+{
+    const char *env = std::getenv("PS2X_SPU2_OUTPUT");
+    if ((env && env[0] == '0') || !IsAudioDeviceReady() || !iop)
+        return;
+    s_spu2Source = iop;
+    SetAudioStreamBufferSizeDefault(2048);
+    static AudioStream stream = LoadAudioStream(48000, 16, 2);
+    SetAudioStreamCallback(stream, Spu2AudioCallback);
+    PlayAudioStream(stream);
+}
