+        {
+            entry->issueCycle = vu.m_cycle;
+            entry->readyCycle = vu.m_cycle + Vu::kFmacLatency;
+            entry->mac = static_cast<uint32_t>(kReverse4[zeros]) | (static_cast<uint32_t>(kReverse4[signs]) << 4);
+            entry->status = (zeros ? 0x1u : 0u) | (signs ? 0x2u : 0u);
+            entry->extraSticky = (productSigns ? 0x2u : 0u) | (productZeros ? 0x1u : 0u) | vu.m_deadSticky;
+            vu.m_deadSticky = 0u;
+            entry->writesMac = true;
+            entry->writesStatus = true;
+        }
+
+        storeLanes(toAcc ? vu.m_state.acc : vu.m_state.vf[fd(instr)], result, laneMask);
+        return true;
+    }
+
+    // Fast path for one upper instruction (NOP, simple ops, FMAC); false =
+    // run the generic interpreter path.
+    template <bool DeadFlags = false>
+    static PS2X_VU1_INLINE bool upper(Vu &vu, uint32_t instr)
+    {
+        using namespace vu1fast;
+        const uint32_t op = instr & 0x3Fu;
+        const bool toAcc = op >= 0x3Cu;
+        const uint32_t special = (instr & 3u) | ((instr >> 4) & 0x7Cu);
+        if (toAcc && (special == 0x2Fu || special == 0x30u))
+        {
+            vu.m_currentUpperInstruction = instr; // NOP: the generic path changes nothing else
+            return true;
+        }
+        if (simple(vu, instr, op, toAcc, special))
+            return true;
+        const FastOp fop = kFastOps[toAcc ? special : op];
+        if (fop.kind == FastNone)
+            return false;
+        return fmac<DeadFlags>(vu, instr, fop, toAcc);
+    }
+
+    // ---- helpers for generated native blocks (see vu1gen.py)
+    static PS2X_VU1_INLINE uint64_t cycle(const Vu &vu) { return vu.m_cycle; }
+
+    // Advance to the next pair's scheduled cycle, exactly as runStaticBlock.
+    static PS2X_VU1_INLINE void step(Vu &vu, uint64_t target)
+    {
+        if (vu.m_xgkick.active)
+            vu.advanceTo(target);
+        else
+        {
+            vu.m_cycle = target;
+            vu.m_state.cycles = target;
+        }
+        if (vu.m_cycle >= vu.m_nextCommit)
+            vu.commitReadyPipelines();
+    }
+
+    template <uint32_t U, bool DeadFlags = false>
+    static PS2X_VU1_INLINE void upperC(Vu &vu)
+    {
+        if (!upper<DeadFlags>(vu, U))
+            vu.execUpperGeneric(U); // pushes a normal entry (and folds dead sticky bits)
+    }
+
+    // Lower instruction with a constant word: the most common loads/stores
+    // and integer ops inline (same code as VU1Interpreter::execLower), the
+    // rest through the interpreter.
+    template <uint32_t L, uint32_t U>
+    static PS2X_VU1_INLINE void lowerC(Vu &vu, uint8_t *data, uint32_t dataSize, GS &gs, PS2Memory *memory)
+    {
+        using namespace vu1fast;
+        constexpr uint32_t opHi = (L >> 25) & 0x7Fu;
+        constexpr uint8_t viT = static_cast<uint8_t>((L >> 16) & 0xFu);
+        constexpr uint8_t viS = static_cast<uint8_t>((L >> 11) & 0xFu);
+        constexpr uint8_t viD = static_cast<uint8_t>((L >> 6) & 0xFu);
+        constexpr uint8_t vfT = ft(L);
+        constexpr uint8_t vfS = fs(L);
+        constexpr uint8_t d = dest(L);
+        constexpr int16_t imm11 = static_cast<int16_t>(static_cast<int32_t>(L << 21) >> 21);
+        constexpr uint32_t funct = L & 0x3Fu;
+        constexpr uint32_t funct2 = (L & 0x3u) | ((L >> 4) & 0x7Cu);
+        const auto loadVf = [&](uint32_t addr, uint8_t reg)
+        {
+            addr &= (dataSize - 1);
+            if (addr + 16 <= dataSize)
+                storeLanes(vu.m_state.vf[reg], _mm_loadu_ps(reinterpret_cast<const float *>(data + addr)), kReverse4[d]);
+        };
+        const auto storeVf = [&](uint32_t addr, uint8_t reg)
+        {
+            addr &= (dataSize - 1);
+            if (addr + 16 <= dataSize)
+            {
+                uint32_t words[4];
+                std::memcpy(words, vu.m_state.vf[reg], sizeof(words));
+                if (!vu.m_xgkick.active && data == vu.m_activeVuData)
+                {
+                    // A queued store becomes visible one cycle later, before
+                    // the next pair runs; only an active XGKICK (PATH1 reads
+                    // VU memory every cycle) could see the difference.
+                    uint32_t *dst = reinterpret_cast<uint32_t *>(data + addr);
+                    if constexpr ((d & 8u) != 0u) dst[0] = words[0];
+                    if constexpr ((d & 4u) != 0u) dst[1] = words[1];
+                    if constexpr ((d & 2u) != 0u) dst[2] = words[2];
+                    if constexpr ((d & 1u) != 0u) dst[3] = words[3];
+                }
+                else
+                    vu.queueStore(addr, words, d);
+            }
+        };
+
+        if constexpr (L == 0x00000000u || L == 0x8000033Cu)
+        {
+            // NOP
+        }
+        else if constexpr (opHi == 0x00u) // LQ
+            loadVf(static_cast<uint32_t>(static_cast<int32_t>(vu.m_state.vi[viS] + imm11)) * 16u, vfT);
+        else if constexpr (opHi == 0x01u) // SQ
+            storeVf(static_cast<uint32_t>(static_cast<int32_t>(vu.m_state.vi[viT] + imm11)) * 16u, vfS);
+        else if constexpr (opHi == 0x04u) // ILW
+        {
+            uint32_t addr = static_cast<uint32_t>(static_cast<int32_t>(vu.m_state.vi[viS] + imm11)) * 16u;
+            addr &= (dataSize - 1);
+            if (addr + 16 <= dataSize)
+            {
+                constexpr int comp = (d & 0x8) ? 0 : (d & 0x4) ? 1 : (d & 0x2) ? 2 : 3;
+                uint32_t v;
+                std::memcpy(&v, data + addr + comp * 4, 4);
+                if constexpr (viT != 0)
+                    vu.m_state.vi[viT] = static_cast<int32_t>(static_cast<int16_t>(v & 0xFFFF));
+            }
+        }
+        else if constexpr (opHi == 0x05u) // ISW
+        {
+            uint32_t addr = static_cast<uint32_t>(static_cast<int32_t>(vu.m_state.vi[viS] + imm11)) * 16u;
+            addr &= (dataSize - 1);
+            if (addr + 16 <= dataSize)
+            {
+                const uint32_t val = static_cast<uint32_t>(static_cast<uint16_t>(vu.m_state.vi[viT] & 0xFFFF));
+                const uint32_t words[4] = {val, val, val, val};
+                vu.queueStore(addr, words, d);
+            }
+        }
+        else if constexpr (opHi == 0x08u || opHi == 0x09u) // IADDIU / ISUBIU
+        {
+            constexpr int16_t imm = static_cast<int16_t>(static_cast<int16_t>(L & 0x7FF) | ((L >> 10) & 0x7800));
+            if constexpr (viT != 0)
+            {
+                if constexpr (opHi == 0x08u)
+                    vu.m_state.vi[viT] = static_cast<int16_t>(vu.m_state.vi[viS] + imm);
+                else
+                    vu.m_state.vi[viT] = static_cast<int16_t>(vu.m_state.vi[viS] - imm);
+            }
+        }
+        else if constexpr (opHi == 0x40u && funct == 0x30u) // IADD
+        {
+            if constexpr (viD != 0)
+                vu.m_state.vi[viD] = static_cast<int16_t>(vu.m_state.vi[viS] + vu.m_state.vi[viT]);
+        }
+        else if constexpr (opHi == 0x40u && funct == 0x31u) // ISUB
+        {
+            if constexpr (viD != 0)
+                vu.m_state.vi[viD] = static_cast<int16_t>(vu.m_state.vi[viS] - vu.m_state.vi[viT]);
+        }
+        else if constexpr (opHi == 0x40u && funct == 0x32u) // IADDI
+        {
+            constexpr int16_t imm5 = static_cast<int16_t>(static_cast<int32_t>((L >> 6) & 0x1F) << 27 >> 27);
+            if constexpr (viT != 0)
+                vu.m_state.vi[viT] = static_cast<int16_t>(vu.m_state.vi[viS] + imm5);
+        }
+        else if constexpr (opHi == 0x40u && funct == 0x34u) // IAND
+        {
+            if constexpr (viD != 0)
+                vu.m_state.vi[viD] = vu.m_state.vi[viS] & vu.m_state.vi[viT];
+        }
+        else if constexpr (opHi == 0x40u && funct == 0x35u) // IOR
+        {
+            if constexpr (viD != 0)
+                vu.m_state.vi[viD] = vu.m_state.vi[viS] | vu.m_state.vi[viT];
+        }
+        else if constexpr (opHi == 0x40u && funct >= 0x3Cu && funct2 == 0x30u) // MOVE
+            storeLanes(vu.m_state.vf[vfT], _mm_loadu_ps(vu.m_state.vf[vfS]), kReverse4[d]);
+        else if constexpr (opHi == 0x40u && funct >= 0x3Cu && funct2 == 0x31u) // MR32
+        {
+            const __m128 v = _mm_loadu_ps(vu.m_state.vf[vfS]);
+            storeLanes(vu.m_state.vf[vfT], _mm_shuffle_ps(v, v, _MM_SHUFFLE(0, 3, 2, 1)), kReverse4[d]);
+        }
+        else if constexpr (opHi == 0x40u && funct >= 0x3Cu && funct2 == 0x34u) // LQI
+        {
+            loadVf(static_cast<uint32_t>(static_cast<uint16_t>(vu.m_state.vi[viS])) * 16u, vfT);
+            if constexpr (viS != 0)
+                vu.m_state.vi[viS] = static_cast<int16_t>(vu.m_state.vi[viS] + 1);
+        }
+        else if constexpr (opHi == 0x40u && funct >= 0x3Cu && funct2 == 0x35u) // SQI
+        {
+            storeVf(static_cast<uint32_t>(static_cast<uint16_t>(vu.m_state.vi[viT])) * 16u, vfS);
+            if constexpr (viT != 0)
+                vu.m_state.vi[viT] = static_cast<int16_t>(vu.m_state.vi[viT] + 1);
+        }
+        else if constexpr (opHi == 0x40u && funct >= 0x3Cu && funct2 == 0x3Cu) // MTIR (fsf in bits 22:21)
+        {
+            constexpr uint32_t comp = (L >> 21) & 0x3u;
+            uint32_t bits;
+            std::memcpy(&bits, &vu.m_state.vf[vfS][comp], 4);
+            if constexpr (viT != 0)
+                vu.m_state.vi[viT] = static_cast<int32_t>(static_cast<int16_t>(bits & 0xFFFFu));
+        }
+        else if constexpr (opHi == 0x40u && funct >= 0x3Cu && funct2 == 0x3Du) // MFIR
+        {
+            const int32_t value = static_cast<int32_t>(static_cast<int16_t>(vu.m_state.vi[viS] & 0xFFFF));
+            storeLanes(vu.m_state.vf[vfT], _mm_castsi128_ps(_mm_set1_epi32(value)), kReverse4[d]);
+        }
+        else if constexpr (opHi == 0x20u || opHi == 0x21u || opHi == 0x24u || opHi == 0x25u ||
+                           opHi == 0x28u || opHi == 0x29u || (opHi >= 0x2Cu && opHi <= 0x2Fu))
+        {
+            // Branches (same code as execLower; native blocks are VU1, 16 KB
+            // of microcode). Conditions read VI through the branch backup.
+            constexpr uint32_t pcMask = 0x3FFFu;
+            const auto branchVi = [&](uint8_t reg) -> int16_t
+            {
+                if (reg == 0u)
+                    return 0;
+                if (vu.m_viBranchBackupValid && vu.m_viBranchBackupReg == reg)
+                    return static_cast<int16_t>(vu.m_viBranchBackupValue);
+                return static_cast<int16_t>(vu.m_state.vi[reg]);
+            };
+            bool taken = true;
+            uint32_t target;
+            if constexpr (opHi == 0x24u || opHi == 0x25u) // JR / JALR
+                target = (static_cast<uint32_t>(static_cast<uint16_t>(branchVi(viS))) * 8u) & pcMask;
+            else
+            {
+                target = (vu.m_state.pc + 8u + static_cast<uint32_t>(static_cast<int32_t>(imm11) * 8)) & pcMask;
+                if constexpr (opHi == 0x28u)
+                    taken = branchVi(viS) == branchVi(viT);
+                else if constexpr (opHi == 0x29u)
+                    taken = branchVi(viS) != branchVi(viT);
+                else if constexpr (opHi == 0x2Cu)
+                    taken = branchVi(viS) < 0;
+                else if constexpr (opHi == 0x2Du)
+                    taken = branchVi(viS) > 0;
+                else if constexpr (opHi == 0x2Eu)
+                    taken = branchVi(viS) <= 0;
+                else if constexpr (opHi == 0x2Fu)
+                    taken = branchVi(viS) >= 0;
+            }
+            if constexpr ((opHi == 0x21u || opHi == 0x25u) && viT != 0) // BAL / JALR link
+                vu.m_state.vi[viT] = static_cast<int32_t>((vu.m_state.pc + 16u) / 8u);
+            if (taken)
+            {
+                vu.m_state.branchPending = true;
+                vu.m_state.branchTarget = target;
+                vu.m_state.branchDelay = 1;
+            }
+        }
+        else
+            vu.execLower(L, data, dataSize, gs, memory, U);
+    }
+
+    // finishPair with the pair's words as constants (E/D/T bits and whether
+    // the lower op is a branch fold away). Same logic as
+    // VU1Interpreter::finishPair.
+    template <uint32_t U, uint32_t L>
+    static PS2X_VU1_INLINE bool finishPairC(Vu &vu, uint32_t codeSize)
+    {
+        constexpr bool eBit = (U & 0x40000000u) != 0u;
+        constexpr bool dBit = (U & 0x10000000u) != 0u;
+        constexpr bool tBit = (U & 0x08000000u) != 0u;
+        constexpr uint32_t opHi = (L >> 25) & 0x7Fu;
+        constexpr bool lowerBranch = (U & 0x80000000u) == 0u && opHi >= 0x20u && opHi <= 0x2Fu;
+        bool ended = false;
+        vu.m_state.vf[0][0] = 0.0f;
+        vu.m_state.vf[0][1] = 0.0f;
+        vu.m_state.vf[0][2] = 0.0f;
+        vu.m_state.vf[0][3] = 1.0f;
+        vu.m_state.vi[0] = 0;
+        uint32_t nextPc = vu.m_state.pc + 8u;
+        if (nextPc >= codeSize)
+            nextPc = 0u;
+        vu.m_state.pc = nextPc;
+        if (vu.m_state.branchPending)
+        {
+            if (vu.m_state.branchDelay == 0u)
+            {
+                vu.m_state.pc = vu.m_state.branchTarget & 0x3FFFu;
+                vu.m_state.branchPending = false;
+            }
+            else
+                --vu.m_state.branchDelay;
+        }
+        const bool dHalt = dBit && vu.m_state.dBitEnabled;
+        const bool tHalt = tBit && vu.m_state.tBitEnabled;
+        const bool haltBit = dHalt || tHalt;
+        const bool haltBranch = haltBit && lowerBranch;
+        if (vu.m_state.haltAfterDelaySlot)
+        {
+            vu.m_state.stoppedByD = vu.m_pendingHaltD;
+            vu.m_state.stoppedByT = vu.m_pendingHaltT;
+            ended = true;
+        }
+        else if (vu.m_state.ebit)
+            ended = true;
+        else if (haltBit && !haltBranch)
+        {
+            vu.m_state.stoppedByD = dHalt;
+            vu.m_state.stoppedByT = tHalt;
+            ended = true;
+        }
+        else if constexpr (eBit)
+            vu.m_state.ebit = true;
+        else if (haltBranch)
+        {
+            vu.m_state.haltAfterDelaySlot = true;
+            vu.m_pendingHaltD = dHalt;
+            vu.m_pendingHaltT = tHalt;
+        }
+        return ended;
+    }
+
+    // End of a "plain" pair (see StaticBlock::plain).
+    static PS2X_VU1_INLINE void plainEnd(Vu &vu)
+    {
+        vu.m_viBranchBackupValid = false;
+        vu.m_state.vf[0][0] = 0.0f;
+        vu.m_state.vf[0][1] = 0.0f;
+        vu.m_state.vf[0][2] = 0.0f;
+        vu.m_state.vf[0][3] = 1.0f;
+        vu.m_state.vi[0] = 0;
+        vu.m_state.pc += 8u;
+    }
+
+    static PS2X_VU1_INLINE const Vu::DecodedInstructionPair &decoded(const Vu &vu, uint32_t pairIndex)
+    {
+        return vu.m_decodedCodeCache[pairIndex];
+    }
+
+    // execPairDirect (without markPairWrites) with constant instruction words.
+    template <uint32_t U, uint32_t L>
+    static PS2X_VU1_INLINE void pair(Vu &vu, const Vu::DecodedInstructionPair &dec, uint8_t *data, uint32_t dataSize,
+                                     GS &gs, PS2Memory *memory)
+    {
+        uint8_t writtenVi = 0u;
+        int32_t oldVi = 0;
+        const uint16_t viWrite = dec.lowerUsage.viWrite & 0xFFFEu;
+        if (viWrite != 0u)
+        {
+            writtenVi = static_cast<uint8_t>(__builtin_ctz(viWrite));
+            oldVi = vu.m_state.vi[writtenVi];
+        }
+        if constexpr ((U & 0x80000000u) != 0u) // I-bit: the lower word is the immediate
+        {
+            upperC<U>(vu);
+            const uint32_t bits = L;
+            float immediate;
+            std::memcpy(&immediate, &bits, sizeof(immediate));
+            vu.m_state.i = vu.normalizeOperand(immediate);
+        }
+        else if (dec.upperVfShadowReg != 0u)
+        {
+            float oldVf[4];
+            float upperVf[4];
+            std::memcpy(oldVf, vu.m_state.vf[dec.upperVfShadowReg], sizeof(oldVf));
+            upperC<U>(vu);
+            std::memcpy(upperVf, vu.m_state.vf[dec.upperVfShadowReg], sizeof(upperVf));
+            std::memcpy(vu.m_state.vf[dec.upperVfShadowReg], oldVf, sizeof(oldVf));
+            lowerC<L, U>(vu, data, dataSize, gs, memory);
+            std::memcpy(vu.m_state.vf[dec.upperVfShadowReg], upperVf, sizeof(upperVf));
+        }
+        else
+        {
+            upperC<U>(vu);
+            lowerC<L, U>(vu, data, dataSize, gs, memory);
+        }
+        vu.m_viBranchBackupValid = false;
+        if (writtenVi != 0u && dec.lowerUsage.delaysNextBranchRead)
+            vu.recordViWriteForBranch(writtenVi, oldVi);
+    }
+
+    // pair<>() when the next pair's lower op is not a branch: nothing reads
+    // the branch-VI backup (it is only valid for the very next pair), so it
+    // is not recorded. End with plainEnd().
+    template <uint32_t U, uint32_t L>
+    static PS2X_VU1_INLINE void pairNB(Vu &vu, const Vu::DecodedInstructionPair &dec, uint8_t *data, uint32_t dataSize,
+                                       GS &gs, PS2Memory *memory)
+    {
+        if constexpr ((U & 0x80000000u) != 0u) // I-bit: the lower word is the immediate
+        {
+            upperC<U>(vu);
+            const uint32_t bits = L;
+            float immediate;
+            std::memcpy(&immediate, &bits, sizeof(immediate));
+            vu.m_state.i = vu.normalizeOperand(immediate);
+        }
+        else if (dec.upperVfShadowReg != 0u)
+        {
+            float oldVf[4];
+            float upperVf[4];
+            std::memcpy(oldVf, vu.m_state.vf[dec.upperVfShadowReg], sizeof(oldVf));
+            upperC<U>(vu);
+            std::memcpy(upperVf, vu.m_state.vf[dec.upperVfShadowReg], sizeof(upperVf));
+            std::memcpy(vu.m_state.vf[dec.upperVfShadowReg], oldVf, sizeof(oldVf));
+            lowerC<L, U>(vu, data, dataSize, gs, memory);
+            std::memcpy(vu.m_state.vf[dec.upperVfShadowReg], upperVf, sizeof(upperVf));
+        }
+        else
+        {
+            upperC<U>(vu);
+            lowerC<L, U>(vu, data, dataSize, gs, memory);
+        }
+    }
+
+    static PS2X_VU1_INLINE bool finishPair(Vu &vu, const Vu::DecodedInstructionPair &dec, uint32_t codeSize)
+    {
+        return vu.finishPair(dec, codeSize);
