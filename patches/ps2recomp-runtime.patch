+void GSCpuBackend::DrawPendingBand(uint32_t band)
+{
+    // Queued primitives are drawn later and on other threads: use one
+    // rounding mode for all of them (round to nearest, the async GS
+    // thread's default; MXCSR RC = 0). Flush-to-zero / denormals-are-zero
+    // while rasterizing: same output on the tutorial capture, a few percent
+    // faster.
+    const unsigned int previousCsr = _mm_getcsr();
+    _mm_setcsr((previousCsr & ~0x6000u) | 0x8040u);
+    t_band = band;
+    t_bandCount = m_bandCount;
+    t_ownsRowY = -1;
+    for (const PendingPrimitive &prim : m_pending)
+    {
+        t_clut = m_clutSnapshots[prim.clut].data();
+        t_texVram = prim.fromSnapshot ? m_feedbackSnapshot.data() : nullptr;
+        DrawPrimitive(prim.batch);
+    }
+    t_band = 0;
+    t_bandCount = 1;
+    t_clut = nullptr;
+    t_texVram = nullptr;
+    _mm_setcsr(previousCsr);
