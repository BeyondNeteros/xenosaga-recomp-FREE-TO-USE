+// Registry of native programs, keyed by the entry pc and a hash of exactly
+// the code pairs the program was compiled from (vu1native::codeHash over its
+// ranges, mirrored in vu1prog.py), so leftover microcode elsewhere in VU1
+// memory does not matter.
+namespace vu1native
+{
+    // Returns true when the program ended; false = continue in the
+    // interpreter at state().pc.
+    using ProgramFn = bool (*)(VU1Interpreter &vu, uint8_t *data, uint32_t dataSize, uint64_t maxPairs);
+    struct ProgramEntry
+    {
+        uint64_t codeHash;       // codeHash over ranges
+        uint32_t pc;             // entry pc
+        const uint16_t *ranges;  // [start, end) byte pairs
+        uint32_t rangeCount;
+        ProgramFn fn;
+    };
+    void registerPrograms(const ProgramEntry *entries, size_t count);
+    // PS2X_VU1_PROGRAMS=0 disables native programs; tools may switch them.
+    void setEnabled(bool on);
+    bool enabled();
+
+    inline uint64_t codeHash(const uint8_t *code, const uint16_t *ranges, uint32_t rangeCount)
+    {
+        uint64_t h = 0x243F6A8885A308D3ull;
+        for (uint32_t r = 0; r < rangeCount; ++r)
+            for (uint32_t i = ranges[2 * r]; i + 8u <= ranges[2 * r + 1]; i += 8u)
+            {
+                uint64_t w;
+                std::memcpy(&w, code + i, 8);
+                h ^= w;
+                h = ((h << 29) | (h >> 35)) * 0x9E3779B97F4A7C15ull;
+            }
+        return h;
+    }
+}
