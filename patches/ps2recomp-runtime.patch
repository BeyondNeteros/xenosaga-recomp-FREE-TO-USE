+    bool parseBool(const std::string &value, bool fallback)
+    {
+        std::string v;
+        for (char c : value)
+            v.push_back(static_cast<char>(std::tolower(static_cast<unsigned char>(c))));
+        if (v == "1" || v == "true" || v == "yes" || v == "on")
+            return true;
+        if (v == "0" || v == "false" || v == "no" || v == "off")
+            return false;
+        return fallback;
+    }
