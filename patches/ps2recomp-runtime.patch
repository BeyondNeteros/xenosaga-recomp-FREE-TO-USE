+            productSigns = _mm_movemask_ps(product) & laneMask;
+            productZeros = zeroOperand;
+            const __m128 acc = normalize4(_mm_loadu_ps(vu.m_state.acc));
+            result = fop.kind == FastMadd ? _mm_add_ps(acc, product) : _mm_sub_ps(acc, product);
