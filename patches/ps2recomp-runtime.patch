+    // One upper instruction, flags committed at once.
+    template <uint32_t I>
+    static PS2X_VU1_INLINE void nUpper(Vu &vu)
+    {
+        using namespace vu1fast;
+        constexpr uint32_t op = I & 0x3Fu;
+        constexpr bool toAcc = op >= 0x3Cu;
+        constexpr uint32_t special = (I & 3u) | ((I >> 4) & 0x7Cu);
+        if constexpr (toAcc && (special == 0x2Fu || special == 0x30u))
