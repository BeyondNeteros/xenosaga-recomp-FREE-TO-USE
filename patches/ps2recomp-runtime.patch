@@ -0,0 +1,673 @@
+#include "iop_spu2.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace ps2x::iop
+{
+    namespace
+    {
+        // Per-core register offsets (core 1 = +0x400).
+        constexpr uint32_t kVoiceParamsEnd = 0x180u; // voice v at v * 0x10
+        constexpr uint32_t kVmixl = 0x188u;
+        constexpr uint32_t kVmixr = 0x190u;
+        constexpr uint32_t kAttr = 0x19Au;
+        constexpr uint32_t kIrqaHigh = 0x19Cu;
+        constexpr uint32_t kIrqaLow = 0x19Eu;
+        constexpr uint32_t kKon = 0x1A0u;
+        constexpr uint32_t kKoff = 0x1A4u;
+        constexpr uint32_t kTsaHigh = 0x1A8u;
+        constexpr uint32_t kTsaLow = 0x1AAu;
+        constexpr uint32_t kDataPort = 0x1ACu;
+        constexpr uint32_t kVoiceAddrBase = 0x1C0u; // voice v at 0x1C0 + v * 0xC
+        constexpr uint32_t kVoiceAddrEnd = 0x1C0u + 24u * 0xCu;
+        constexpr uint32_t kEndx = 0x340u;
+        constexpr uint32_t kStatx = 0x344u;
+        // Common area.
+        constexpr uint32_t kCommonBase = 0x760u;
+        constexpr uint32_t kMasterVolume[2] = {0x760u, 0x788u}; // MVOLL, MVOLR follows
+        constexpr uint32_t kIrqInfo = 0x7C2u;
+
+        constexpr int32_t kAdpcmFilter[5][2] = {{0, 0}, {60, 0}, {115, -52}, {98, -55}, {122, -60}};
+        constexpr uint32_t kRamMask = Spu2::kRamWords - 1u;
+
+        // PS2X_SPU2_LOG=<n>: print the first n register accesses.
+        int g_logBudget = []() {
+            const char *env = std::getenv("PS2X_SPU2_LOG");
+            return env ? std::atoi(env) : 0;
+        }();
+        // PS2X_SPU2_EVENTS=<n>: print the first n key-ons and DMA transfers.
+        int g_eventBudget = []() {
+            const char *env = std::getenv("PS2X_SPU2_EVENTS");
+            return env ? std::atoi(env) : 0;
+        }();
+    }
+
+    Spu2::Spu2()
+        : m_ram(kRamWords, 0u), m_ring(static_cast<size_t>(kRingFrames) * 2u, int16_t{0})
+    {
+    }
+
+    void Spu2::reset()
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        m_regs.fill(0u);
+        std::fill(m_ram.begin(), m_ram.end(), uint16_t{0});
+        m_cores = {};
+        m_reverb = {};
+        m_irqInfo = 0;
+        m_interruptPending = false;
+    }
+
+    int32_t Spu2::fixedVolume(uint16_t value)
+    {
+        // Bit 15 selects a sweep (not modelled yet: treat as full volume);
+        // otherwise a 15-bit signed volume.
+        if (value & 0x8000u)
+            return 0x7FFF;
+        return static_cast<int16_t>(static_cast<uint16_t>(value << 1));
+    }
+
+    void Spu2::checkIrq(int core, uint32_t address, uint32_t words)
+    {
+        (void)core;
+        for (int c = 0; c < 2; ++c)
+        {
+            const uint32_t base = static_cast<uint32_t>(c) * 0x400u;
+            if ((regValue(base + kAttr) & 0x40u) == 0u)
+                continue;
+            const uint32_t irqa = join(regValue(base + kIrqaHigh), regValue(base + kIrqaLow));
+            if (((irqa - address) & kRamMask) < words)
+            {
+                m_irqInfo |= static_cast<uint16_t>(4u << c);
+                m_interruptPending = true;
+            }
+        }
+    }
+
+    void Spu2::markStreamWritten(uint32_t address, uint32_t words)
+    {
+        for (uint32_t i = 0; i < m_chunkFresh.size(); ++i)
+        {
+            const uint32_t start = kStreamBase + i * 0x200u;
+            if (((start - address) & kRamMask) < words || ((address - start) & kRamMask) < 0x200u)
+                m_chunkFresh[i] = true;
+        }
+    }
+
+    void Spu2::keyOn(int core, int voice)
+    {
+        Voice &v = m_cores[core].voices[voice];
+        if (g_eventBudget > 0)
+        {
+            --g_eventBudget;
+            const uint32_t base = static_cast<uint32_t>(core) * 0x400u + static_cast<uint32_t>(voice) * 0x10u;
+            const uint16_t head = m_ram[v.startAddress & kRamMask & ~7u];
+            std::fprintf(stderr, "[spu2] kon c%d v%02d ssa=0x%05x lsa=0x%05x pitch=0x%04x adsr=%04x/%04x vol=%04x/%04x hdr=%04x\n",
+                         core, voice, v.startAddress, v.loopAddress, regValue(base + 4u), regValue(base + 6u),
+                         regValue(base + 8u), regValue(base + 0u), regValue(base + 2u), head);
+        }
+        v.active = true;
+        v.nextAddress = v.startAddress;
+        v.loopSetBySoftware = false;
+        v.counter = 0;
+        v.sampleIndex = 28;
+        v.blockFlags = 0;
+        v.history1 = v.history2 = 0;
+        v.previous = v.current = 0;
+        v.phase = EnvelopePhase::Attack;
+        v.level = 0;
+        v.envelopeWait = 0;
+        v.hasBlock = false;
+        m_cores[core].endFlags &= ~(1u << voice);
+    }
+
+    void Spu2::keyOff(int core, int voice)
+    {
+        Voice &v = m_cores[core].voices[voice];
+        if (v.phase != EnvelopePhase::Off)
+        {
+            v.phase = EnvelopePhase::Release;
+            v.envelopeWait = 0;
+        }
+    }
+
+    void Spu2::decodeBlock(int core, Voice &v)
+    {
+        const uint32_t address = v.nextAddress & kRamMask & ~7u;
+        checkIrq(core, address, 8u);
+        if (address - kStreamBase < kStreamWords && (address & 0x1FFu) == 0u)
+        {
+            bool &fresh = m_chunkFresh[(address - kStreamBase) >> 9];
+            m_streamChunks.fetch_add(1u, std::memory_order_relaxed);
+            if (!fresh)
+                m_staleChunks.fetch_add(1u, std::memory_order_relaxed);
+            fresh = false;
+        }
+        uint8_t block[16];
+        for (uint32_t i = 0; i < 8u; ++i)
+        {
+            const uint16_t word = m_ram[(address + i) & kRamMask];
+            block[i * 2u] = static_cast<uint8_t>(word);
+            block[i * 2u + 1u] = static_cast<uint8_t>(word >> 8);
+        }
+        const uint8_t header = block[0];
+        const uint8_t flags = block[1];
+        if ((flags & 4u) && !v.loopSetBySoftware)
+            v.loopAddress = address;
+        int shift = header & 0xF;
+        if (shift > 12)
+            shift = 9;
+        const int filter = std::min<int>((header >> 4) & 7, 4);
+        const int32_t f0 = kAdpcmFilter[filter][0];
+        const int32_t f1 = kAdpcmFilter[filter][1];
+        for (int i = 0; i < 28; ++i)
+        {
+            const int nibble = (block[2 + i / 2] >> ((i & 1) * 4)) & 0xF;
+            int32_t sample = static_cast<int16_t>(static_cast<uint16_t>(nibble << 12)) >> shift;
+            sample += (v.history1 * f0 + v.history2 * f1 + 32) >> 6;
+            sample = std::clamp(sample, -32768, 32767);
+            v.decoded[i] = static_cast<int16_t>(sample);
+            v.history2 = v.history1;
+            v.history1 = sample;
+        }
+        v.blockFlags = flags;
+        v.sampleIndex = 0;
+    }
+
+    int16_t Spu2::nextSample(int core, Voice &v)
+    {
+        if (v.sampleIndex >= 28)
+        {
+            const int voiceIndex = static_cast<int>(&v - m_cores[core].voices.data());
+            if (v.hasBlock)
+            {
+                // Finished a block: follow its loop flags.
+                if (v.blockFlags & 1u)
+                {
+                    m_cores[core].endFlags |= 1u << voiceIndex;
+                    v.nextAddress = v.loopAddress;
+                    if ((v.blockFlags & 2u) == 0u)
+                    {
+                        // Loop end without repeat: the voice stops.
+                        v.phase = EnvelopePhase::Off;
+                        v.level = 0;
+                        v.active = false;
+                        return 0;
+                    }
+                }
+                else
+                {
+                    v.nextAddress = (v.nextAddress + 8u) & kRamMask;
+                }
+            }
+            decodeBlock(core, v);
+            v.hasBlock = true;
+        }
+        return v.decoded[v.sampleIndex++];
+    }
+
+    void Spu2::stepEnvelope(int core, int voiceIndex, Voice &v)
+    {
+        if (v.phase == EnvelopePhase::Off)
+            return;
+        if (v.envelopeWait > 0 && --v.envelopeWait > 0)
+            return;
+        const uint32_t base = static_cast<uint32_t>(core) * 0x400u + static_cast<uint32_t>(voiceIndex) * 0x10u;
+        const uint16_t adsr1 = regValue(base + 6u);
+        const uint16_t adsr2 = regValue(base + 8u);
+        int rate = 0;
+        bool exponential = false;
+        bool decrease = false;
+        switch (v.phase)
+        {
+        case EnvelopePhase::Attack:
+            rate = (adsr1 >> 8) & 0x7F;
+            exponential = (adsr1 & 0x8000u) != 0u;
+            break;
+        case EnvelopePhase::Decay:
+            rate = ((adsr1 >> 4) & 0xF) << 2;
+            exponential = true;
+            decrease = true;
+            break;
+        case EnvelopePhase::Sustain:
+            rate = (adsr2 >> 6) & 0x7F;
+            exponential = (adsr2 & 0x8000u) != 0u;
+            decrease = (adsr2 & 0x4000u) != 0u;
+            break;
+        case EnvelopePhase::Release:
+            rate = (adsr2 & 0x1F) << 2;
+            exponential = (adsr2 & 0x20u) != 0u;
+            decrease = true;
+            break;
+        default:
+            return;
+        }
+        // psx-spx "ADSR": wait 1 << max(0, shift - 11) samples, then add
+        // step << max(0, 11 - shift) (exponential variants as documented).
+        const int shift = rate >> 2;
+        const int stepBits = rate & 3;
+        const int step = decrease ? (-8 + stepBits) : (7 - stepBits);
+        int32_t cycles = 1 << std::max(0, shift - 11);
+        int32_t delta = step << std::max(0, 11 - shift);
+        if (exponential && !decrease && v.level > 0x6000)
+            cycles *= 4;
+        if (exponential && decrease)
+            delta = (delta * v.level) >> 15;
+        v.level = std::clamp(v.level + delta, 0, 0x7FFF);
+        v.envelopeWait = cycles;
+
+        switch (v.phase)
+        {
+        case EnvelopePhase::Attack:
+            if (v.level >= 0x7FFF)
+            {
+                v.phase = EnvelopePhase::Decay;
+                v.envelopeWait = 0;
+            }
+            break;
+        case EnvelopePhase::Decay:
+        {
+            const int32_t sustainLevel = ((adsr1 & 0xF) + 1) * 0x800;
+            if (v.level <= sustainLevel)
+            {
+                v.phase = EnvelopePhase::Sustain;
+                v.envelopeWait = 0;
+            }
+            break;
+        }
+        case EnvelopePhase::Release:
+            if (v.level <= 0)
+            {
+                v.phase = EnvelopePhase::Off;
+                v.active = false;
+            }
+            break;
+        default:
+            break;
+        }
+    }
+
+    uint16_t Spu2::read16(uint32_t physical)
+    {
+        const uint16_t value = read16Locked(physical);
+        if (g_logBudget > 0)
+        {
+            --g_logBudget;
+            std::fprintf(stderr, "[spu2] read  0x%03x -> 0x%04x\n", (physical - kRegisterBase) & 0x7FEu, value);
+        }
+        return value;
+    }
+
+    uint16_t Spu2::read16Locked(uint32_t physical)
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        const uint32_t offset = (physical - kRegisterBase) & ~1u;
+        if (offset >= kCommonBase)
+        {
+            if (offset == kIrqInfo)
+            {
+                const uint16_t value = m_irqInfo;
+                m_irqInfo = 0;
+                return value;
+            }
+            return regValue(offset);
+        }
+        const int core = offset >= 0x400u ? 1 : 0;
+        const uint32_t local = offset & 0x3FFu;
+        Core &c = m_cores[core];
+        if (local < kVoiceParamsEnd)
+        {
+            const int voice = static_cast<int>(local >> 4);
+            const uint32_t field = local & 0xFu;
+            if (field == 0xAu) // ENVX
+                return static_cast<uint16_t>(c.voices[voice].level);
+            if (field == 0xCu || field == 0xEu) // VOLXL / VOLXR
+                return static_cast<uint16_t>((fixedVolume(regValue(offset - 0xCu)) >> 1) & 0x7FFF); // VOLL / VOLR
+            return regValue(offset);
+        }
+        if (local >= kVoiceAddrBase && local < kVoiceAddrEnd)
+        {
+            const uint32_t rel = local - kVoiceAddrBase;
+            const int voice = static_cast<int>(rel / 0xCu);
+            const uint32_t field = rel % 0xCu;
+            if (field == 8u)
+                return static_cast<uint16_t>((c.voices[voice].nextAddress >> 16) & 0xFu);
+            if (field == 0xAu)
+                return static_cast<uint16_t>(c.voices[voice].nextAddress);
+            return regValue(offset);
+        }
+        switch (local)
+        {
+        case kEndx:
+            return static_cast<uint16_t>(c.endFlags);
+        case kEndx + 2u:
+            return static_cast<uint16_t>(c.endFlags >> 16);
+        case kStatx:
+            // 0 after reset (libsd's init waits for that); 0x80 once a DMA
+            // has finished (transfers complete immediately here).
+            return c.status;
+        case kTsaHigh:
+            return static_cast<uint16_t>((c.transferAddress >> 16) & 0xFu);
+        case kTsaLow:
+            return static_cast<uint16_t>(c.transferAddress);
+        case kKon:
+        case kKon + 2u:
+        case kKoff:
+        case kKoff + 2u:
+            return 0u;
+        default:
+            return regValue(offset);
+        }
+    }
+
+    void Spu2::write16(uint32_t physical, uint16_t value)
+    {
+        if (g_logBudget > 0)
+        {
+            --g_logBudget;
+            std::fprintf(stderr, "[spu2] write 0x%03x <- 0x%04x\n", (physical - kRegisterBase) & 0x7FEu, value);
+        }
+        std::lock_guard<std::mutex> lock(m_mutex);
+        const uint32_t offset = (physical - kRegisterBase) & ~1u;
+        reg(offset) = value;
+        if (offset >= kCommonBase)
+        {
+            if (offset == kIrqInfo)
+                m_irqInfo = 0;
+            return;
+        }
+        const int core = offset >= 0x400u ? 1 : 0;
+        const uint32_t local = offset & 0x3FFu;
+        Core &c = m_cores[core];
+        if (local >= kVoiceAddrBase && local < kVoiceAddrEnd)
+        {
+            const uint32_t rel = local - kVoiceAddrBase;
+            const int voice = static_cast<int>(rel / 0xCu);
+            const uint32_t field = rel % 0xCu;
+            const uint32_t pairBase = offset - (field & 2u); // high half of the pair (fields 0/4/8)
+            const uint32_t joined = join(regValue(pairBase), regValue(pairBase + 2u));
+            Voice &v = c.voices[voice];
+            if (field < 4u)
+                v.startAddress = joined;
+            else if (field < 8u)
+            {
+                v.loopAddress = joined;
+                v.loopSetBySoftware = true;
+            }
+            else
+                v.nextAddress = joined;
+            return;
+        }
+        switch (local)
+        {
+        case kKon:
+        case kKon + 2u:
+        {
+            const int first = local == kKon ? 0 : 16;
+            for (int bit = 0; bit < 16 && first + bit < 24; ++bit)
+                if (value & (1u << bit))
+                    keyOn(core, first + bit);
+            break;
+        }
+        case kKoff:
+        case kKoff + 2u:
+        {
+            const int first = local == kKoff ? 0 : 16;
+            for (int bit = 0; bit < 16 && first + bit < 24; ++bit)
+                if (value & (1u << bit))
+                    keyOff(core, first + bit);
+            break;
+        }
+        case kTsaHigh:
+        case kTsaLow:
+            c.transferAddress = join(regValue(static_cast<uint32_t>(core) * 0x400u + kTsaHigh),
+                                     regValue(static_cast<uint32_t>(core) * 0x400u + kTsaLow));
+            break;
+        case kDataPort:
+            checkIrq(core, c.transferAddress, 1u);
+            m_ram[c.transferAddress & kRamMask] = value;
+            c.transferAddress = (c.transferAddress + 1u) & kRamMask;
+            break;
+        case kEndx:
+            c.endFlags &= ~0xFFFFu;
+            break;
+        case kEndx + 2u:
+            c.endFlags &= 0xFFFFu;
+            break;
+        default:
+            break;
+        }
+    }
+
+    void Spu2::dmaWrite(int core, const uint8_t *source, size_t bytes)
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        Core &c = m_cores[core & 1];
+        const uint32_t words = static_cast<uint32_t>(bytes / 2u);
+        if (g_eventBudget > 0)
+        {
+            --g_eventBudget;
+            std::fprintf(stderr, "[spu2] %s c%d tsa=0x%05x words=0x%x\n", "dma write", core, c.transferAddress, words);
+        }
+        checkIrq(core, c.transferAddress, words);
+        markStreamWritten(c.transferAddress, words);
+        for (uint32_t i = 0; i < words; ++i)
+        {
+            uint16_t word;
+            std::memcpy(&word, source + i * 2u, sizeof(word));
+            m_ram[(c.transferAddress + i) & kRamMask] = word;
+        }
+        c.status |= 0x80u;
+        c.transferAddress = (c.transferAddress + words) & kRamMask;
+    }
+
+    void Spu2::dmaRead(int core, uint8_t *destination, size_t bytes)
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        Core &c = m_cores[core & 1];
+        const uint32_t words = static_cast<uint32_t>(bytes / 2u);
+        if (g_eventBudget > 0)
+        {
+            --g_eventBudget;
+            std::fprintf(stderr, "[spu2] %s c%d tsa=0x%05x words=0x%x\n", "dma read ", core, c.transferAddress, words);
+        }
+        checkIrq(core, c.transferAddress, words);
+        for (uint32_t i = 0; i < words; ++i)
+        {
+            const uint16_t word = m_ram[(c.transferAddress + i) & kRamMask];
+            std::memcpy(destination + i * 2u, &word, sizeof(word));
+        }
+        c.status |= 0x80u;
+        c.transferAddress = (c.transferAddress + words) & kRamMask;
+    }
+
+    bool Spu2::synced() noexcept
+    {
+        static const bool value = []() {
+            const char *env = std::getenv("PS2X_SPU2_SYNC");
+            return !(env && env[0] == '0');
+        }();
+        return value;
+    }
+
+    void Spu2::produce(size_t frames)
+    {
+        int16_t block[2u * 64u];
+        while (frames > 0u)
+        {
+            const size_t count = std::min<size_t>(frames, 64u);
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                renderLocked(block, count);
+            }
+            frames -= count;
+            const uint64_t write = m_ringWrite.load(std::memory_order_relaxed);
+            const uint64_t read = m_ringRead.load(std::memory_order_acquire);
+            if (write - read + count > kRingFrames)
+            {
+                m_dropped.fetch_add(count, std::memory_order_relaxed);
+                continue;
+            }
+            for (size_t i = 0; i < count; ++i)
+            {
+                const size_t slot = static_cast<size_t>((write + i) % kRingFrames) * 2u;
+                m_ring[slot] = block[i * 2u];
+                m_ring[slot + 1u] = block[i * 2u + 1u];
+            }
+            m_ringWrite.store(write + count, std::memory_order_release);
+        }
+    }
+
+    void Spu2::render(int16_t *output, size_t frames)
+    {
+        if (!synced())
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            renderLocked(output, frames);
+            return;
+        }
+        // Play the IOP-time output with a cushion of about 64 ms: the IOP runs
+        // in bursts on the game thread. A slight speed change (at most 1.5%)
+        // keeps the cushion level; an empty ring waits to refill.
+        constexpr double kTarget = 3072.0;
+        uint64_t read = m_ringRead.load(std::memory_order_relaxed);
+        const uint64_t write = m_ringWrite.load(std::memory_order_acquire);
+        uint64_t available = write - read;
+        if (!m_playing)
+        {
+            if (static_cast<double>(available) < kTarget)
+            {
+                std::memset(output, 0, frames * 4u);
+                return;
+            }
+            m_playing = true;
+            m_averageFill = static_cast<double>(available);
+            m_fraction = 0.0;
+        }
+        if (static_cast<double>(available) > kTarget * 4.0)
+        {
+            // Far behind (the game ran ahead, or a stall ended): skip ahead.
+            read = write - static_cast<uint64_t>(kTarget);
+            available = static_cast<uint64_t>(kTarget);
+            m_averageFill = kTarget;
+        }
+        m_averageFill += (static_cast<double>(available) - m_averageFill) * 0.05;
+        const double ratio = 1.0 + std::clamp((m_averageFill - kTarget) / kTarget * 0.02, -0.015, 0.015);
+        size_t frame = 0;
+        for (; frame < frames; ++frame)
+        {
+            if (write - read < 2u)
+            {
+                m_underruns.fetch_add(1u, std::memory_order_relaxed);
+                m_playing = false;
+                break;
+            }
+            const size_t a = static_cast<size_t>(read % kRingFrames) * 2u;
+            const size_t b = static_cast<size_t>((read + 1u) % kRingFrames) * 2u;
+            for (int ch = 0; ch < 2; ++ch)
+            {
+                const double value = m_ring[a + ch] + (m_ring[b + ch] - m_ring[a + ch]) * m_fraction;
+                m_last[ch] = static_cast<int16_t>(value);
+                output[frame * 2u + ch] = m_last[ch];
+            }
+            m_fraction += ratio;
+            while (m_fraction >= 1.0)
+            {
+                m_fraction -= 1.0;
+                ++read;
+            }
+        }
+        // Underrun: fade out from the last sample instead of clicking.
+        for (size_t i = frame; i < frames; ++i)
+        {
+            for (int ch = 0; ch < 2; ++ch)
+            {
+                m_last[ch] = static_cast<int16_t>((m_last[ch] * 15) / 16);
+                output[i * 2u + ch] = m_last[ch];
+            }
+        }
+        m_ringRead.store(read, std::memory_order_release);
+    }
+
+    void Spu2::renderLocked(int16_t *output, size_t frames)
+    {
+        for (size_t frame = 0; frame < frames; ++frame)
+        {
+            int32_t coreOut[2][2] = {{0, 0}, {0, 0}};
+            for (int core = 0; core < 2; ++core)
+            {
+                const uint32_t coreBase = static_cast<uint32_t>(core) * 0x400u;
+                const uint32_t mixLeft = regValue(coreBase + kVmixl) | (static_cast<uint32_t>(regValue(coreBase + kVmixl + 2u)) << 16);
+                const uint32_t mixRight = regValue(coreBase + kVmixr) | (static_cast<uint32_t>(regValue(coreBase + kVmixr + 2u)) << 16);
+                // Effect (reverb) sends: VMIXEL 0x18C, VMIXER 0x194.
+                const uint32_t wetMixLeft = regValue(coreBase + 0x18Cu) | (static_cast<uint32_t>(regValue(coreBase + 0x18Eu)) << 16);
+                const uint32_t wetMixRight = regValue(coreBase + 0x194u) | (static_cast<uint32_t>(regValue(coreBase + 0x196u)) << 16);
+                int32_t left = 0;
+                int32_t right = 0;
+                int32_t wetLeft = 0;
+                int32_t wetRight = 0;
+                for (int voiceIndex = 0; voiceIndex < 24; ++voiceIndex)
+                {
+                    Voice &v = m_cores[core].voices[voiceIndex];
+                    if (!v.active)
+                        continue;
+                    const uint32_t base = coreBase + static_cast<uint32_t>(voiceIndex) * 0x10u;
+                    const uint32_t pitch = std::min<uint32_t>(regValue(base + 4u), 0x3FFFu);
+                    v.counter += pitch;
+                    while (v.counter >= 0x1000u && v.active)
+                    {
+                        v.counter -= 0x1000u;
+                        v.previous = v.current;
+                        v.current = nextSample(core, v);
+                    }
+                    const int32_t interpolated = v.previous + (((v.current - v.previous) * static_cast<int32_t>(v.counter)) >> 12);
+                    stepEnvelope(core, voiceIndex, v);
+                    const int32_t sample = (interpolated * v.level) >> 15;
+                    const int32_t voiceLeft = (sample * fixedVolume(regValue(base + 0u))) >> 15;
+                    const int32_t voiceRight = (sample * fixedVolume(regValue(base + 2u))) >> 15;
+                    if (mixLeft & (1u << voiceIndex))
+                        left += voiceLeft;
+                    if (mixRight & (1u << voiceIndex))
+                        right += voiceRight;
+                    if (wetMixLeft & (1u << voiceIndex))
+                        wetLeft += voiceLeft;
+                    if (wetMixRight & (1u << voiceIndex))
+                        wetRight += voiceRight;
+                }
+                // Effect bus through a simple stereo reverb (two feedback
+                // delays per channel) and the core's effect volume (EVOLL/R
+                // at master + 4/6). Not the SPU2's own reverb program yet,
+                // but voices sent only to the effect bus are no longer silent.
+                Reverb &rv = m_reverb[core];
+                const uint32_t masterBase = kMasterVolume[core];
+                const int32_t wetIn[2] = {wetLeft, wetRight};
+                int32_t wetOut[2];
+                for (int ch = 0; ch < 2; ++ch)
+                {
+                    const size_t tapA = (rv.position + Reverb::kSize - Reverb::kDelayA[ch]) % Reverb::kSize;
+                    const size_t tapB = (rv.position + Reverb::kSize - Reverb::kDelayB[ch]) % Reverb::kSize;
+                    const int32_t delayed = (rv.line[ch][tapA] + rv.line[ch][tapB]) / 2;
+                    rv.line[ch][rv.position] = std::clamp(wetIn[ch] + ((delayed * 5) >> 3), -32768, 32767);
+                    wetOut[ch] = ((wetIn[ch] + delayed) * fixedVolume(regValue(masterBase + 4u + ch * 2u))) >> 15;
+                }
+                rv.position = (rv.position + 1u) % Reverb::kSize;
+                coreOut[core][0] = left + wetOut[0];
+                coreOut[core][1] = right + wetOut[1];
+            }
+            // Core 0 feeds core 1; core 1 goes to the output. Each through its
+            // master volume.
+            int32_t mixed[2];
+            for (int ch = 0; ch < 2; ++ch)
+            {
+                const int32_t core0 = (coreOut[0][ch] * fixedVolume(regValue(kMasterVolume[0] + ch * 2u))) >> 15;
+                const int32_t core1 = coreOut[1][ch] + core0;
+                mixed[ch] = (core1 * fixedVolume(regValue(kMasterVolume[1] + ch * 2u))) >> 15;
+            }
+            output[frame * 2u] = static_cast<int16_t>(std::clamp(mixed[0], -32768, 32767));
+            output[frame * 2u + 1u] = static_cast<int16_t>(std::clamp(mixed[1], -32768, 32767));
+        }
+    }
+}
