+    // A sprite that samples its own frame buffer (same address, width and
+    // format) but only ever reads pixels at or after the one being drawn, in
+    // top-to-bottom, left-to-right order: drawn alone it always sees the
+    // values from before the sprite, so it can be drawn from a VRAM copy on
+    // any number of threads. (Xenosaga's full-screen shift/blur passes.)
+    bool isForwardFeedbackSprite(const GSPrimitiveBatch &batch, const PrimRanges &r)
+    {
+        const GSDrawState &state = batch.state;
+        const GSContext &ctx = state.context;
+        const GSTex0Reg &tex = ctx.tex0;
+        if (state.prim.type != GS_PRIM_SPRITE || !state.prim.tme || batch.vertexCount < 2u)
+            return false;
+        if (r.z && (overlaps(r.zlo, r.zhi, r.flo, r.fhi) || overlaps(r.tlo, r.thi, r.zlo, r.zhi)))
+            return false;
+        if ((tex.psm != GS_PSM_CT32 && tex.psm != GS_PSM_CT24) || tex.psm != ctx.frame.psm ||
+            tex.tbw != ctx.frame.fbw || tex.tbp0 != GSInternal::framePageBaseToBlock(ctx.frame.fbp))
+            return false;
+        // Coordinates must stay inside the texture, so REPEAT/CLAMP leave them alone.
+        const uint8_t wrapU = static_cast<uint8_t>(ctx.clamp & 0x3u);
+        const uint8_t wrapV = static_cast<uint8_t>((ctx.clamp >> 2) & 0x3u);
+        if (wrapU > 1u || wrapV > 1u)
+            return false;
+
+        // Same rectangle and texture setup as DrawSprite.
+        const GSVertex &v0 = batch.vertices[0];
+        const GSVertex &v1 = batch.vertices[1];
+        const int ofx = ctx.xyoffset.ofx >> 4;
+        const int ofy = ctx.xyoffset.ofy >> 4;
+        int x0 = static_cast<int>(v0.x) - ofx, y0 = static_cast<int>(v0.y) - ofy;
+        int x1 = static_cast<int>(v1.x) - ofx, y1 = static_cast<int>(v1.y) - ofy;
+        if (x0 > x1)
+            std::swap(x0, x1);
+        if (y0 > y1)
+            std::swap(y0, y1);
+        const int spanX = std::max(1, x1 - x0);
+        const int spanY = std::max(1, y1 - y0);
+        if (x0 + spanX - 1 < ctx.scissor.x0 || x0 > ctx.scissor.x1 || y0 + spanY - 1 < ctx.scissor.y0 || y0 > ctx.scissor.y1)
+            return true; // draws nothing
+        const int drawX0 = clampInt(x0, ctx.scissor.x0, ctx.scissor.x1);
+        const int drawY0 = clampInt(y0, ctx.scissor.y0, ctx.scissor.y1);
+        const int drawX1 = clampInt(x0 + spanX - 1, ctx.scissor.x0, ctx.scissor.x1);
+        const int drawY1 = clampInt(y0 + spanY - 1, ctx.scissor.y0, ctx.scissor.y1);
+        const int texW = state.textureWidth;
+        const int texH = state.textureHeight;
+        float u0f, v0f, u1f, v1f;
+        if (state.prim.fst)
+        {
+            u0f = static_cast<float>(v0.u >> 4);
+            v0f = static_cast<float>(v0.v >> 4);
+            u1f = static_cast<float>(v1.u >> 4);
+            v1f = static_cast<float>(v1.v >> 4);
+        }
+        else
+        {
+            const float q0 = fabsQ(v0.q);
+            const float q1 = fabsQ(v1.q);
+            u0f = (v0.s / q0) * static_cast<float>(texW);
+            v0f = (v0.t / q0) * static_cast<float>(texH);
+            u1f = (v1.s / q1) * static_cast<float>(texW);
+            v1f = (v1.t / q1) * static_cast<float>(texH);
+        }
+        const float spriteW = static_cast<float>(spanX);
+        const float spriteH = static_cast<float>(spanY);
+
+        bool needColumns = false; // some row reads its own row
+        for (int y = drawY0; y <= drawY1; ++y)
+        {
+            const float ty = (static_cast<float>(y - y0) + 0.5f) / spriteH;
+            int lo, hi;
+            spriteTexelRange(state, v0f + (v1f - v0f) * ty, texH, lo, hi);
+            if (lo < y || hi >= texH)
+                return false;
+            needColumns |= lo == y;
+        }
+        for (int x = drawX0; x <= drawX1; ++x)
+        {
+            const float tx = (static_cast<float>(x - x0) + 0.5f) / spriteW;
+            int lo, hi;
+            spriteTexelRange(state, u0f + (u1f - u0f) * tx, texW, lo, hi);
+            if (lo < 0 || hi >= texW || (needColumns && lo < x))
+                return false;
+        }
+        return true;
+    }
+}
