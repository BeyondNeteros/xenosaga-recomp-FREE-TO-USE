+    void handleHostHotkeys()
+    {
+        HostSettings &s = g_hostSettings;
+        const bool alt = IsKeyDown(KEY_LEFT_ALT) || IsKeyDown(KEY_RIGHT_ALT);
+        if (IsKeyPressed(KEY_F11) || (alt && IsKeyPressed(KEY_ENTER)))
+        {
+            ToggleBorderlessWindowed();
+            showNotice(IsWindowState(FLAG_BORDERLESS_WINDOWED_MODE) ? "Fullscreen" : "Windowed");
+        }
+        if (IsKeyPressed(KEY_F3))
+            s.showFps = !s.showFps;
+        if (IsKeyPressed(KEY_F4))
+        {
+            s.filter = s.filter == "sharp" ? "smooth" : (s.filter == "smooth" ? "pixel" : "sharp");
+            showNotice("Filter: " + s.filter);
+        }
+        if (IsKeyPressed(KEY_F5))
+        {
+            setAspect(s.aspect == "4:3" ? "16:9" : (s.aspect == "16:9" ? "stretch" : (s.aspect == "stretch" ? "native" : "4:3")));
+            showNotice("Picture: " + s.aspect);
+        }
+        if (IsKeyPressed(KEY_F12))
+            saveScreenshot();
+    }
+
+    void updateHostWindowState()
+    {
+        Presenter &p = g_presenter;
+        const double now = GetTime();
+        // Mouse pointer: hide over the game when idle.
+        const Vector2 mouse = GetMousePosition();
+        if (mouse.x != p.lastMouse.x || mouse.y != p.lastMouse.y)
+        {
+            p.lastMouse = mouse;
+            p.lastMouseMove = now;
+        }
+        const bool wantHidden = g_hostSettings.hideCursor && IsWindowFocused() && now - p.lastMouseMove > 2.0;
+        if (wantHidden != p.cursorHidden)
+        {
+            if (wantHidden)
+                HideCursor();
+            else
+                ShowCursor();
+            p.cursorHidden = wantHidden;
+        }
+        // Volume, muted while another window is in front.
+        const bool focused = IsWindowFocused();
+        const float volume = (g_hostSettings.muteWhenUnfocused && !focused) ? 0.0f : g_hostSettings.volume / 100.0f;
+        SetMasterVolume(volume);
+        p.wasFocused = focused;
+    }
+
+    // Frames the window actually shows: new game frames the GS handed over,
+    // which is what the player sees.
+    void countGameFrame()
+    {
+        Presenter &p = g_presenter;
+        static int logFrames = 0;
+        static uint64_t lastCount = 0;
+        const uint64_t count = ps2x_presentedFrameCount();
+        p.flips += static_cast<int>(count - lastCount);
+        logFrames += static_cast<int>(count - lastCount);
+        lastCount = count;
+        const double now = GetTime();
+        static double logStart = now;
+        if (now - logStart >= 5.0)
+        {
+            std::printf("[present] window showed %.1f new frames/s\n", logFrames / (now - logStart));
+            logStart = now;
+            logFrames = 0;
+        }
+        if (now - p.fpsWindowStart >= 0.5)
+        {
+            p.gameFps = static_cast<float>(p.flips / (now - p.fpsWindowStart));
+            p.flips = 0;
+            p.fpsWindowStart = now;
+        }
+    }
+
+    void drawHostOverlay()
+    {
+        Presenter &p = g_presenter;
+        const int size = std::max(20, GetScreenHeight() / 36);
+        if (g_hostSettings.showFps)
+        {
+            const char *text = TextFormat("%.0f FPS", p.gameFps);
+            DrawRectangle(8, 8, MeasureText(text, size) + 16, size + 10, Color{0, 0, 0, 160});
+            DrawText(text, 16, 13, size, p.gameFps >= 29.0f ? GREEN : (p.gameFps >= 20.0f ? YELLOW : RED));
+        }
+        if (const char *badge = g_hostBadge.load(std::memory_order_relaxed))
+        {
+            const int y = g_hostSettings.showFps ? 13 + size + 16 : 13;
+            DrawRectangle(8, y - 5, MeasureText(badge, size) + 16, size + 10, Color{0, 0, 0, 160});
+            DrawText(badge, 16, y, size, Color{120, 200, 255, 255});
+        }
+        if (GetTime() < p.noticeUntil && !p.notice.empty())
+        {
+            const int w = MeasureText(p.notice.c_str(), size);
+            const int x = (GetScreenWidth() - w) / 2;
+            const int y = GetScreenHeight() - size * 3;
+            DrawRectangle(x - 16, y - 8, w + 32, size + 16, Color{0, 0, 0, 180});
+            DrawText(p.notice.c_str(), x, y, size, RAYWHITE);
+        }
+    }
+}
