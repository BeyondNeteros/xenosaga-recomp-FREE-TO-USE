+namespace
+{
+    // PS2X_VU_CAPTURE=1: record VU1 calls (state + code + data memory) to
+    // vu1_capture.bin for offline replay/profiling. Skips the first
+    // PS2X_VU_CAPTURE_SKIP calls (default 20000), then records 300.
+    void captureVu1Call(uint32_t kind, uint32_t startPC, uint32_t top, uint32_t itop,
+                        const VU1State &state, const uint8_t *code, const uint8_t *data)
+    {
+        static const bool enabled = [] { const char *v = std::getenv("PS2X_VU_CAPTURE"); return v && v[0] == '1'; }();
+        if (!enabled)
+            return;
+        static const uint64_t skip = [] { const char *v = std::getenv("PS2X_VU_CAPTURE_SKIP"); return v ? std::strtoull(v, nullptr, 10) : 20000ull; }();
+        static uint64_t calls = 0;
+        static uint32_t recorded = 0;
+        static std::ofstream out;
+        if (++calls <= skip || recorded >= 300u)
+            return;
+        if (!out.is_open())
+        {
+            out.open("vu1_capture.bin", std::ios::binary);
+            const uint32_t header[4] = {0x31555658u /* XVU1 */, 1u, static_cast<uint32_t>(sizeof(VU1State)), 0u};
+            out.write(reinterpret_cast<const char *>(header), sizeof(header));
+        }
+        const uint32_t rec[4] = {kind, startPC, top, itop};
+        out.write(reinterpret_cast<const char *>(rec), sizeof(rec));
+        out.write(reinterpret_cast<const char *>(&state), sizeof(VU1State));
+        out.write(reinterpret_cast<const char *>(code), PS2_VU1_CODE_SIZE);
+        out.write(reinterpret_cast<const char *>(data), PS2_VU1_DATA_SIZE);
+        if (++recorded == 300u)
+        {
+            out.close();
+            std::printf("[vu-capture] wrote 300 VU1 calls to vu1_capture.bin\n");
+        }
+    }
+}
