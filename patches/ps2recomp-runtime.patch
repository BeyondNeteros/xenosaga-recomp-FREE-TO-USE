+    std::string currentValue(const MenuItem &item)
+    {
+        const HostSettings &s = g_hostSettings;
+        const std::string key = item.key;
+        if (key == "upscale") return std::to_string(s.upscale);
+        if (key == "aspect") return s.aspect;
+        if (key == "filter") return s.filter;
+        if (key == "integer_scale") return s.integerScale ? "true" : "false";
+        if (key == "fullscreen") return IsWindowState(FLAG_BORDERLESS_WINDOWED_MODE) ? "true" : "false";
+        if (key == "vsync") return s.vsync ? "true" : "false";
+        if (key == "show_fps") return s.showFps ? "true" : "false";
+        if (key == "renderer") return s.renderer;
+        if (key == "one_hit_kill") return g_debugOneHitKill.load() ? "true" : "false";
+        if (key == "no_encounters") return g_debugNoEncounters.load() ? "true" : "false";
+        return {};
+    }
+
+    void applyMenuValue(const MenuItem &item, const std::string &value)
+    {
+        HostSettings &s = g_hostSettings;
+        const std::string key = item.key;
+        if (key == "upscale")
+        {
+            s.upscale = std::atoi(value.c_str());
+            ps2x_glSetResolution(s.upscale, s.aspect == "16:9");
+        }
+        else if (key == "aspect")
+            setAspect(value);
+        else if (key == "filter")
+            s.filter = value;
+        else if (key == "integer_scale")
+            s.integerScale = value == "true";
+        else if (key == "fullscreen")
+        {
+            if ((value == "true") != IsWindowState(FLAG_BORDERLESS_WINDOWED_MODE))
+                ToggleBorderlessWindowed();
+            s.fullscreen = value == "true";
+        }
+        else if (key == "vsync")
+        {
+            s.vsync = value == "true";
+            if (s.vsync)
+                SetWindowState(FLAG_VSYNC_HINT);
+            else
+                ClearWindowState(FLAG_VSYNC_HINT);
+            const int refresh = GetMonitorRefreshRate(GetCurrentMonitor());
+            SetTargetFPS(refresh > 0 ? refresh : 60);
+        }
+        else if (key == "show_fps")
+            s.showFps = value == "true";
+        else if (key == "renderer")
+            s.renderer = value;
+        else if (key == "one_hit_kill")
+            g_debugOneHitKill.store(value == "true");
+        else if (key == "no_encounters")
+            g_debugNoEncounters.store(value == "true");
+        saveSettingValue(key, value);
+    }
+
+    void stepItem(int index, int dir)
+    {
+        const MenuItem &item = menuItems()[index];
+        const std::string cur = currentValue(item);
+        int at = 0;
+        for (size_t i = 0; i < item.values.size(); ++i)
+            if (item.values[i] == cur)
+                at = static_cast<int>(i);
+        const int n = static_cast<int>(item.values.size());
+        at = (at + dir + n) % n;
+        applyMenuValue(item, item.values[at]);
+    }
+
+    int menuGamepad()
+    {
+        for (int i = 0; i < 4; ++i)
+            if (IsGamepadAvailable(i))
+                return i;
+        return -1;
+    }
+
+    bool anyMenuButtonDown()
+    {
+        const int g = menuGamepad();
+        if (g >= 0)
+            for (int b = GAMEPAD_BUTTON_LEFT_FACE_UP; b <= GAMEPAD_BUTTON_RIGHT_THUMB; ++b)
+                if (IsGamepadButtonDown(g, b))
+                    return true;
+        return IsKeyDown(KEY_F1) || IsKeyDown(KEY_ESCAPE) || IsKeyDown(KEY_ENTER) || IsKeyDown(KEY_BACKSPACE) ||
+               IsKeyDown(KEY_X) || IsKeyDown(KEY_C) || IsKeyDown(KEY_SPACE);
+    }
+
+    void updateSettingsMenu()
+    {
+        SettingsMenu &m = g_menu;
+        const int g = menuGamepad();
+        const auto pressed = [&](int button) { return g >= 0 && IsGamepadButtonPressed(g, button); };
+        const auto down = [&](int button) { return g >= 0 && IsGamepadButtonDown(g, button); };
+        bool stickCombo = (pressed(GAMEPAD_BUTTON_LEFT_THUMB) && down(GAMEPAD_BUTTON_RIGHT_THUMB)) ||
+                          (pressed(GAMEPAD_BUTTON_RIGHT_THUMB) && down(GAMEPAD_BUTTON_LEFT_THUMB));
+        // Test runs: PS2X_MENU_AT=s opens the menu at s seconds;
+        // PS2X_RES_SWITCH_AT=s:upscale:wide changes the resolution (not saved).
+        static double menuAt = std::getenv("PS2X_MENU_AT") ? std::atof(std::getenv("PS2X_MENU_AT")) : -1.0;
+        if (menuAt >= 0.0 && GetTime() >= menuAt)
+        {
+            menuAt = -1.0;
+            if (!m.open)
+                stickCombo = true;
+        }
+        static const char *switchSpec = std::getenv("PS2X_RES_SWITCH_AT");
+        if (switchSpec)
+        {
+            double at = 0.0;
+            int up = 3, wide = 0;
+            if (std::sscanf(switchSpec, "%lf:%d:%d", &at, &up, &wide) >= 2 && GetTime() >= at)
+            {
+                switchSpec = nullptr;
+                g_hostSettings.upscale = up;
+                g_hostSettings.aspect = wide ? "16:9" : "4:3";
+                g_widescreen.store(wide != 0);
+                ps2x_glSetResolution(up, wide != 0);
+            }
+        }
+        if (!m.open)
+        {
+            if (IsKeyPressed(KEY_F1) || stickCombo)
+            {
+                m.open = true;
+                m.waitRelease = false;
+                g_inputBlocked.store(true);
+            }
+            else if (m.waitRelease && !anyMenuButtonDown())
+            {
+                m.waitRelease = false;
+                g_inputBlocked.store(false);
+            }
+            return;
+        }
+        if (IsKeyPressed(KEY_F1) || IsKeyPressed(KEY_ESCAPE) || IsKeyPressed(KEY_BACKSPACE) || stickCombo ||
+            pressed(GAMEPAD_BUTTON_RIGHT_FACE_RIGHT) || pressed(GAMEPAD_BUTTON_MIDDLE_RIGHT))
+        {
+            m.open = false;
+            m.waitRelease = true; // keep the game from seeing the closing press
+            return;
+        }
+        const int count = static_cast<int>(menuItems().size());
+        // Directions: d-pad, arrow keys or the left stick, repeating when held.
+        const float sx = g >= 0 ? GetGamepadAxisMovement(g, GAMEPAD_AXIS_LEFT_X) : 0.0f;
+        const float sy = g >= 0 ? GetGamepadAxisMovement(g, GAMEPAD_AXIS_LEFT_Y) : 0.0f;
+        int vertical = 0, horizontal = 0;
+        if (IsKeyDown(KEY_UP) || IsKeyDown(KEY_W) || down(GAMEPAD_BUTTON_LEFT_FACE_UP) || sy < -0.6f) vertical = -1;
+        if (IsKeyDown(KEY_DOWN) || IsKeyDown(KEY_S) || down(GAMEPAD_BUTTON_LEFT_FACE_DOWN) || sy > 0.6f) vertical = 1;
+        if (IsKeyDown(KEY_LEFT) || IsKeyDown(KEY_A) || down(GAMEPAD_BUTTON_LEFT_FACE_LEFT) || sx < -0.6f) horizontal = -1;
+        if (IsKeyDown(KEY_RIGHT) || IsKeyDown(KEY_D) || down(GAMEPAD_BUTTON_LEFT_FACE_RIGHT) || sx > 0.6f) horizontal = 1;
+        const int dir = vertical != 0 ? vertical * 10 : horizontal;
+        const double now = GetTime();
+        bool fire = false;
+        if (dir != m.repeatDir)
+        {
+            m.repeatDir = dir;
+            fire = dir != 0;
+            m.repeatAt = now + 0.4;
+        }
+        else if (dir != 0 && now >= m.repeatAt)
+        {
+            fire = true;
+            m.repeatAt = now + 0.12;
+        }
+        if (fire)
+        {
+            if (vertical != 0)
+                m.selected = (m.selected + vertical + count) % count;
+            else
+                stepItem(m.selected, horizontal);
+        }
+        if (IsKeyPressed(KEY_ENTER) || IsKeyPressed(KEY_SPACE) || IsKeyPressed(KEY_X) ||
+            pressed(GAMEPAD_BUTTON_RIGHT_FACE_DOWN))
+            stepItem(m.selected, 1);
+    }
+
+    void drawSettingsMenu()
+    {
+        const SettingsMenu &m = g_menu;
+        if (!m.open)
+            return;
+        const int sw = GetScreenWidth(), sh = GetScreenHeight();
+        DrawRectangle(0, 0, sw, sh, Color{0, 0, 0, 150});
+        const int size = std::max(18, sh / 34);
+        const int row = size + size / 2;
+        const auto &items = menuItems();
+        const int panelW = std::min(sw - 32, size * 30);
+        const int panelH = row * (static_cast<int>(items.size()) + 5);
+        const int x0 = (sw - panelW) / 2, y0 = (sh - panelH) / 2;
+        DrawRectangle(x0, y0, panelW, panelH, Color{12, 20, 36, 235});
+        DrawRectangleLines(x0, y0, panelW, panelH, Color{90, 140, 210, 255});
+        DrawText("Settings", x0 + size, y0 + size / 2, size + size / 3, RAYWHITE);
+        const int listY = y0 + row * 2;
+        const int valueX = x0 + panelW / 2;
+        for (size_t i = 0; i < items.size(); ++i)
+        {
+            const int y = listY + static_cast<int>(i) * row;
+            const bool sel = static_cast<int>(i) == m.selected;
+            if (sel)
+                DrawRectangle(x0 + size / 2, y - size / 4, panelW - size, row - size / 6, Color{50, 90, 150, 200});
+            DrawText(items[i].label, x0 + size, y, size, sel ? RAYWHITE : Color{190, 200, 215, 255});
+            const std::string cur = currentValue(items[i]);
+            std::string shown = cur;
+            for (size_t v = 0; v < items[i].values.size(); ++v)
+                if (items[i].values[v] == cur)
+                    shown = items[i].names[v];
+            const std::string text = sel ? "<  " + shown + "  >" : shown;
+            DrawText(text.c_str(), valueX, y, size, sel ? Color{255, 220, 120, 255} : Color{170, 190, 215, 255});
+        }
+        const int noteY = listY + static_cast<int>(items.size()) * row + size / 2;
+        DrawText(items[m.selected].note, x0 + size, noteY, size * 3 / 4, Color{170, 190, 215, 255});
+        DrawText("Up/Down choose   Left/Right or Cross change   Circle, Start or F1 close",
+                 x0 + size, noteY + row, size * 3 / 4, Color{120, 140, 170, 255});
+    }
+}
