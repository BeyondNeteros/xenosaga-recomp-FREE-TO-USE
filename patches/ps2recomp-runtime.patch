diff --git a/ps2xRuntime/tools/gs_replay.cpp b/ps2xRuntime/tools/gs_replay.cpp
new file mode 100644
index 0000000..3ae36b8
--- /dev/null
+++ b/ps2xRuntime/tools/gs_replay.cpp
@@ -0,0 +1,324 @@
+// Replays a GS capture recorded with PS2X_GS_CAPTURE=seconds,frames
+// (gs_capture.bin) through the runtime's GS frontend and CPU backend, for
+// profiling and for checking that renderer optimizations don't change a pixel.
+//
+//   gs_replay gs_capture.bin [repeat]
+//
+// Prints the time per pass, a hash of the final VRAM, and whether it matches
+// the VRAM the game had at the end of the capture. VU_REPLAY_PROFILE=1 writes
+// sampled instruction pointers like vu1_replay does (gs_replay_samples.txt).
+
+#include "ps2_runtime.h"
+#include "runtime/ps2_memory.h"
+#include "runtime/gs/gs_frontend.h"
+
+#include "runtime/gs/gs_gl_backend.h"
+#include "runtime/gs/ps2_gs_memory.h"
+#include <cfenv>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <string>
+#include <vector>
+
+#ifdef _WIN32
+#include <windows.h>
+#include <atomic>
+#include <map>
+#include <thread>
+#endif
+
+namespace
+{
+    struct Record
+    {
+        uint8_t type;
+        std::vector<uint8_t> data;
+    };
+
+    uint64_t fnv1a(const uint8_t *p, size_t n)
+    {
+        uint64_t h = 1469598103934665603ull;
+        for (size_t i = 0; i < n; ++i)
+            h = (h ^ p[i]) * 1099511628211ull;
+        return h;
+    }
+
+    bool isPreludeSafe(uint8_t reg)
+    {
+        switch (reg)
+        {
+        case 0x04: case 0x05: case 0x0C: case 0x0D: // vertex kicks
+        case 0x0F:                                  // A+D
+        case 0x3F:                                  // TEXFLUSH
+        case 0x53: case 0x54:                       // TRXDIR, HWREG (start transfers)
+        case 0x60: case 0x61: case 0x62:            // SIGNAL, FINISH, LABEL
+            return false;
+        default:
+            return true;
+        }
+    }
+
+#ifdef _WIN32
+    std::atomic<bool> g_profStop{false};
+#endif
+}
+
+// Compares a 512x448 display buffer with the reference and writes both pictures.
+static void compareBuffer(uint8_t *got, uint8_t *want, uint32_t fbp, const char *prefix)
+{
+    const int W = 512, H = 448;
+    std::vector<uint8_t> a(W * H * 3), b(W * H * 3), d(W * H * 3);
+    size_t diff = 0, big = 0, alphaDiff = 0;
+    int maxDelta = 0;
+    for (int y = 0; y < H; ++y)
+        for (int x = 0; x < W; ++x)
+        {
+            const uint32_t p = GSMem::ReadCT32(got, fbp * 32u, 8u, x, y);
+            const uint32_t q = GSMem::ReadCT32(want, fbp * 32u, 8u, x, y);
+            int delta = 0;
+            const size_t o = (static_cast<size_t>(H - 1 - y) * W + x) * 3;
+            for (int c = 0; c < 3; ++c)
+            {
+                const int pc = (p >> (8 * c)) & 255, qc = (q >> (8 * c)) & 255;
+                a[o + 2 - c] = static_cast<uint8_t>(pc);
+                b[o + 2 - c] = static_cast<uint8_t>(qc);
+                const int e = std::abs(pc - qc);
+                delta = std::max(delta, e);
+                d[o + 2 - c] = static_cast<uint8_t>(std::min(255, e * 8));
+            }
+            diff += delta != 0;
+            big += delta > 8;
+            alphaDiff += (p >> 24) != (q >> 24);
+            maxDelta = std::max(maxDelta, delta);
+        }
+    std::printf("buffer %#x: %zu of %d pixels differ (%.2f%%), %zu by more than 8, max %d; alpha differs on %zu\n", fbp, diff, W * H,
+                100.0 * diff / (W * H), big, maxDelta, alphaDiff);
+    if (!prefix)
+        return;
+    const auto save = [&](const char *name, const std::vector<uint8_t> &pix)
+    {
+        char path[512];
+        std::snprintf(path, sizeof(path), "%s_%x_%s.bmp", prefix, fbp, name);
+        std::ofstream o(path, std::ios::binary);
+        const uint32_t size = 54 + static_cast<uint32_t>(pix.size());
+        uint8_t h[54] = {'B', 'M'};
+        std::memcpy(h + 2, &size, 4);
+        h[10] = 54;
+        h[14] = 40;
+        std::memcpy(h + 18, &W, 4);
+        std::memcpy(h + 22, &H, 4);
+        h[26] = 1;
+        h[28] = 24;
+        o.write(reinterpret_cast<const char *>(h), 54);
+        o.write(reinterpret_cast<const char *>(pix.data()), static_cast<std::streamsize>(pix.size()));
+    };
+    save("got", a);
+    save("want", b);
+    save("diff", d);
+}
+
+int main(int argc, char **argv)
+{
+    if (argc < 2)
+    {
+        std::fprintf(stderr, "usage: %s gs_capture.bin [repeat]\n", argv[0]);
+        return 1;
+    }
+    const int repeat = argc > 2 ? std::atoi(argv[2]) : 3;
+
+    std::ifstream in(argv[1], std::ios::binary);
+    char magic[4];
+    uint32_t vramSize = 0, regCount = 0;
+    in.read(magic, 4);
+    in.read(reinterpret_cast<char *>(&vramSize), 4);
+    in.read(reinterpret_cast<char *>(&regCount), 4);
+    if (!in || std::memcmp(magic, "GSC1", 4) != 0 || vramSize != PS2_GS_VRAM_SIZE)
+    {
+        std::fprintf(stderr, "bad capture\n");
+        return 1;
+    }
+    std::vector<std::pair<uint8_t, uint64_t>> regs(regCount);
+    for (auto &r : regs)
+    {
+        in.read(reinterpret_cast<char *>(&r.first), 1);
+        in.read(reinterpret_cast<char *>(&r.second), 8);
+    }
+    std::vector<uint8_t> vramStart(vramSize), vramEnd(vramSize);
+    in.read(reinterpret_cast<char *>(vramStart.data()), vramSize);
+    std::vector<Record> records;
+    uint32_t frames = 0;
+    for (;;)
+    {
+        uint8_t type = 0;
+        if (!in.read(reinterpret_cast<char *>(&type), 1))
+            break;
+        if (type == 0)
+        {
+            in.read(reinterpret_cast<char *>(vramEnd.data()), vramSize);
+            break;
+        }
+        if (type == 7)
+        {
+            ++frames;
+            continue;
+        }
+        uint32_t size = 0;
+        in.read(reinterpret_cast<char *>(&size), 4);
+        Record r{type, std::vector<uint8_t>(size)};
+        in.read(reinterpret_cast<char *>(r.data.data()), size);
+        records.push_back(std::move(r));
+    }
+    if (!in)
+    {
+        std::fprintf(stderr, "truncated capture\n");
+        return 1;
+    }
+    std::printf("loaded %zu records, %u frame boundaries, %u registers\n", records.size(), frames, regCount);
+
+#ifdef _WIN32
+    std::vector<uint64_t> samples;
+    std::thread profThread;
+    HANDLE mainThread = nullptr;
+    if (std::getenv("VU_REPLAY_PROFILE"))
+    {
+        DuplicateHandle(GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(), &mainThread, 0, FALSE,
+                        DUPLICATE_SAME_ACCESS);
+        samples.reserve(1 << 20);
+        timeBeginPeriod(1);
+        profThread = std::thread([mainThread, &samples] {
+            while (!g_profStop.load())
+            {
+                if (SuspendThread(mainThread) != static_cast<DWORD>(-1))
+                {
+                    CONTEXT ctx{};
+                    ctx.ContextFlags = CONTEXT_CONTROL;
+                    if (GetThreadContext(mainThread, &ctx))
+                        samples.push_back(ctx.Rip);
+                    ResumeThread(mainThread);
+                }
+                Sleep(1);
+            }
+        });
+    }
+#endif
+
+    PS2Memory memory;
+    if (!memory.initialize())
+        return 1;
+    uint8_t *vram = memory.getGSVRAM();
+    double totalMs = 0;
+    uint64_t firstHash = 0;
+    for (int pass = 0; pass < repeat; ++pass)
+    {
+        GS gs;
+        gs.init(vram, vramSize, &memory.gs());
+        if (std::getenv("GS_REPLAY_GL"))
+            if (auto gl = ps2x_createGlBackend())
+                gs.setRasterBackend(std::move(gl));
+        std::memcpy(vram, vramStart.data(), vramSize);
+        for (const auto &r : regs)
+            if (isPreludeSafe(r.first))
+                gs.writeRegister(r.first, r.second);
+        gs.writeRegister(0x3F, 0); // TEXFLUSH: VRAM was replaced behind the backend
+
+        const auto t0 = std::chrono::steady_clock::now();
+        for (const Record &r : records)
+        {
+            // GS_REPLAY_ROUND=nearest: ignore the recorded rounding mode (the
+            // game's GS now runs on its own thread in round-to-nearest).
+            static const bool forceNearest = std::getenv("GS_REPLAY_ROUND") != nullptr;
+            std::fesetround((!forceNearest && (r.type & 0x80u)) ? FE_TOWARDZERO : FE_TONEAREST);
+            const uint8_t *d = r.data.data();
+            const uint32_t n = static_cast<uint32_t>(r.data.size());
+            switch (r.type & 0x7Fu)
+            {
+            case 1:
+                gs.processGIFPacket(d, n);
+                break;
+            case 2:
+                gs.processNativePackedGIFPacket(d, n);
+                break;
+            case 3:
+            {
+                uint64_t rr[4];
+                std::memcpy(rr, d, 32);
+                gs.uploadImageNative(rr[0], rr[1], rr[2], rr[3], d + 32, n - 32u);
+                break;
+            }
+            case 4:
+            {
+                uint64_t value;
+                std::memcpy(&value, d + 1, 8);
+                gs.writeRegister(d[0], value);
+                break;
+            }
+            case 5:
+            {
+                uint32_t v[2];
+                std::memcpy(v, d, 8);
+                gs.clearFramebufferContext(v[0], v[1]);
+                break;
+            }
+            case 6:
+            {
+                uint32_t v;
+                std::memcpy(&v, d, 4);
+                gs.clearActiveFramebuffer(v);
+                break;
+            }
+            }
+        }
+        gs.writeRegister(0x61, 0); // FINISH: draws the rasterizer's queued primitives
+        std::fesetround(FE_TONEAREST);
+        const double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+        if (pass > 0 || repeat == 1)
+            totalMs += ms;
+        const uint64_t hash = fnv1a(vram, vramSize);
+        if (pass == 0)
+        {
+            firstHash = hash;
+            size_t diff = 0;
+            for (uint32_t i = 0; i < vramSize; ++i)
+                diff += vram[i] != vramEnd[i];
+            std::printf("vs game's end VRAM: %s (%zu bytes differ)\n", diff ? "DIFFERENT" : "identical", diff);
+            if (std::getenv("GS_REPLAY_GL") || std::getenv("GS_REPLAY_COMPARE"))
+            {
+                compareBuffer(vram, vramEnd.data(), 0x70u, std::getenv("GS_REPLAY_COMPARE"));
+                compareBuffer(vram, vramEnd.data(), 0xE0u, std::getenv("GS_REPLAY_COMPARE"));
+            }
+            if (const char *out = std::getenv("GS_REPLAY_DUMP"))
+            {
+                std::ofstream o(out, std::ios::binary);
+                o.write(reinterpret_cast<const char *>(vram), vramSize);
+            }
+        }
+        else if (hash != firstHash)
+            std::printf("pass %d: VRAM hash differs from pass 0 (nondeterministic?)\n", pass);
+    }
+    const int timed = repeat > 1 ? repeat - 1 : 1;
+    std::printf("per pass: %.2f ms  (%.2f ms per frame)\n", totalMs / timed, totalMs / timed / (frames ? frames : 1));
+    std::printf("vram hash: %016llx\n", static_cast<unsigned long long>(firstHash));
+
+#ifdef _WIN32
+    if (profThread.joinable())
+    {
+        g_profStop = true;
+        profThread.join();
+        std::map<uint64_t, unsigned> counts;
+        for (uint64_t a : samples)
+            ++counts[a];
+        const uint64_t exeBase = reinterpret_cast<uint64_t>(GetModuleHandleW(nullptr));
+        if (FILE *f = std::fopen("gs_replay_samples.txt", "w"))
+        {
+            for (const auto &kv : counts)
+                if (kv.first >= exeBase)
+                    std::fprintf(f, "%llx %u\n", static_cast<unsigned long long>(kv.first - exeBase), kv.second);
+            std::fclose(f);
+        }
+    }
+#endif
+    return 0;
+}
diff --git a/ps2xRuntime/tools/vu0_test.cpp b/ps2xRuntime/tools/vu0_test.cpp
new file mode 100644
index 0000000..94c29a5
--- /dev/null
+++ b/ps2xRuntime/tools/vu0_test.cpp
@@ -0,0 +1,65 @@
+// Runs a VU0 microprogram from a raw microcode file through the runtime's VU
+// interpreter with vf28-31 set to a test matrix, and prints vf28-31 after.
+// Used to check timing-sensitive programs (e.g. Xenosaga's matrix inverse)
+// against a reference result.
+//
+//   vu0_test microcode.bin <start pc hex> m00 m01 ... m33   (16 floats, row major)
+
+#include "ps2_runtime.h"
+#include "runtime/ps2_memory.h"
+#include "runtime/ps2_vu1.h"
+#include "runtime/gs/gs_frontend.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <vector>
+
+int main(int argc, char **argv)
+{
+    // Register mode: vu0_test code.bin pc vf4=x,y,z,w [vfN=...]  -> prints vf1-vf4.
+    const bool regMode = argc > 3 && std::strncmp(argv[3], "vf", 2) == 0;
+    if (argc < 3 + (regMode ? 1 : 16))
+    {
+        std::fprintf(stderr, "usage: %s microcode.bin startpc m00..m33\n", argv[0]);
+        return 1;
+    }
+    std::ifstream in(argv[1], std::ios::binary);
+    std::vector<uint8_t> code((std::istreambuf_iterator<char>(in)), {});
+    code.resize(PS2_VU0_CODE_SIZE, 0);
+    std::vector<uint8_t> data(PS2_VU0_DATA_SIZE, 0);
+
+    PS2Memory memory;
+    if (!memory.initialize())
+        return 1;
+    GS gs;
+    gs.init(memory.getGSVRAM(), static_cast<uint32_t>(PS2_GS_VRAM_SIZE), &memory.gs());
+
+    VU1Interpreter vu(VU1Interpreter::Unit::VU0);
+    VU1State &s = vu.state();
+    if (regMode)
+    {
+        for (int a = 3; a < argc; ++a)
+        {
+            int reg = 0;
+            float v[4] = {0, 0, 0, 0};
+            if (std::sscanf(argv[a], "vf%d=%f,%f,%f,%f", &reg, &v[0], &v[1], &v[2], &v[3]) >= 2 && reg > 0 && reg < 32)
+                std::memcpy(s.vf[reg], v, sizeof(v));
+        }
+    }
+    else
+    {
+        for (int r = 0; r < 4; ++r)
+            for (int c = 0; c < 4; ++c)
+                s.vf[28 + r][c] = static_cast<float>(std::atof(argv[3 + r * 4 + c]));
+    }
+    s.vf[0][3] = 1.0f;
+    vu.execute(code.data(), PS2_VU0_CODE_SIZE, data.data(), PS2_VU0_DATA_SIZE, gs, nullptr,
+               static_cast<uint32_t>(std::strtoul(argv[2], nullptr, 16)), 0, 0, 4096);
+    const int first = regMode ? 1 : 28;
+    for (int r = 0; r < 4; ++r)
+        std::printf("%g %g %g %g\n", s.vf[first + r][0], s.vf[first + r][1], s.vf[first + r][2], s.vf[first + r][3]);
+    std::printf("cycles %llu\n", static_cast<unsigned long long>(s.cycles));
+    return 0;
+}
diff --git a/ps2xRuntime/tools/vu1_replay.cpp b/ps2xRuntime/tools/vu1_replay.cpp
new file mode 100644
index 0000000..821be6b
--- /dev/null
+++ b/ps2xRuntime/tools/vu1_replay.cpp
@@ -0,0 +1,269 @@
+// Replays VU1 calls recorded with PS2X_VU_CAPTURE=1 (vu1_capture.bin) through
+// the runtime's VU1 interpreter, for profiling and for checking that
+// optimizations don't change results.
+//
+//   vu1_replay vu1_capture.bin [repeat] [--dump-out out.bin]
+
+#include "ps2_runtime.h"
+#include "runtime/ps2_memory.h"
+#include "runtime/ps2_vu1.h"
+#include "runtime/gs/gs_frontend.h"
+#include "runtime/gs/ps2_gif_arbiter.h"
+
+#include <chrono>
+#include <cstdlib>
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <string>
+#include <vector>
+
+namespace
+{
+    struct Record
+    {
+        uint32_t kind, startPC, top, itop;
+        VU1State state;
+        std::vector<uint8_t> code, data;
+    };
+
+    uint64_t fnv1a(const uint8_t *p, size_t n, uint64_t h = 1469598103934665603ull)
+    {
+        for (size_t i = 0; i < n; ++i)
+            h = (h ^ p[i]) * 1099511628211ull;
+        return h;
+    }
+}
+
+#ifdef _WIN32
+#include <windows.h>
+#include <atomic>
+#include <map>
+#include <thread>
+namespace
+{
+    // VU_REPLAY_PROFILE=1: sample the main thread's instruction pointer every
+    // ~1 ms and write the raw addresses to vu1_replay_samples.txt (resolve them
+    // with addr2line -f -C -e vu1_replay.exe).
+    std::atomic<bool> g_profStop{false};
+    std::thread startProfiler(HANDLE target, std::vector<uint64_t> &samples)
+    {
+        return std::thread([target, &samples] {
+            while (!g_profStop.load())
+            {
+                if (SuspendThread(target) != static_cast<DWORD>(-1))
+                {
+                    CONTEXT ctx{};
+                    ctx.ContextFlags = CONTEXT_CONTROL;
+                    if (GetThreadContext(target, &ctx))
+                        samples.push_back(ctx.Rip);
+                    ResumeThread(target);
+                }
+                Sleep(1);
+            }
+        });
+    }
+}
+#endif
+
+int main(int argc, char **argv)
+{
+#ifdef _WIN32
+    std::vector<uint64_t> profSamples;
+    std::thread profThread;
+    HANDLE mainThread = nullptr;
+    if (std::getenv("VU_REPLAY_PROFILE"))
+    {
+        DuplicateHandle(GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(), &mainThread, 0, FALSE,
+                        DUPLICATE_SAME_ACCESS);
+        profSamples.reserve(1 << 20);
+        timeBeginPeriod(1);
+        profThread = startProfiler(mainThread, profSamples);
+    }
+    struct ProfDump
+    {
+        std::thread &t;
+        std::vector<uint64_t> &s;
+        ~ProfDump()
+        {
+            if (!t.joinable())
+                return;
+            g_profStop = true;
+            t.join();
+            std::map<uint64_t, unsigned> counts;
+            for (uint64_t a : s)
+                ++counts[a];
+            // Offsets are relative to the exe; samples in other modules are
+            // summed per DLL into vu1_replay_modules.txt.
+            const uint64_t exeBase = reinterpret_cast<uint64_t>(GetModuleHandleW(nullptr));
+            std::map<std::string, unsigned> modules;
+            if (FILE *f = std::fopen("vu1_replay_samples.txt", "w"))
+            {
+                for (const auto &kv : counts)
+                {
+                    HMODULE mod = nullptr;
+                    GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                                       reinterpret_cast<LPCSTR>(kv.first), &mod);
+                    if (reinterpret_cast<uint64_t>(mod) == exeBase)
+                    {
+                        std::fprintf(f, "%llx %u\n", static_cast<unsigned long long>(kv.first - exeBase), kv.second);
+                        continue;
+                    }
+                    char name[MAX_PATH] = "?";
+                    if (mod)
+                        GetModuleFileNameA(mod, name, MAX_PATH);
+                    modules[name] += kv.second;
+                }
+                std::fclose(f);
+            }
+            if (FILE *f = std::fopen("vu1_replay_modules.txt", "w"))
+            {
+                for (const auto &kv : modules)
+                    std::fprintf(f, "%u %s\n", kv.second, kv.first.c_str());
+                std::fclose(f);
+            }
+        }
+    } profDump{profThread, profSamples};
+#endif
+    if (argc < 2)
+    {
+        std::fprintf(stderr, "usage: %s vu1_capture.bin [repeat]\n", argv[0]);
+        return 1;
+    }
+    const int repeat = argc > 2 ? std::atoi(argv[2]) : 20;
+
+    std::ifstream in(argv[1], std::ios::binary);
+    uint32_t header[4];
+    in.read(reinterpret_cast<char *>(header), sizeof(header));
+    if (!in || header[0] != 0x31555658u || header[2] != sizeof(VU1State))
+    {
+        std::fprintf(stderr, "bad capture (state size %u, expected %zu)\n", header[2], sizeof(VU1State));
+        return 1;
+    }
+    std::vector<Record> records;
+    for (;;)
+    {
+        Record r;
+        uint32_t rec[4];
+        if (!in.read(reinterpret_cast<char *>(rec), sizeof(rec)))
+            break;
+        r.kind = rec[0]; r.startPC = rec[1]; r.top = rec[2]; r.itop = rec[3];
+        in.read(reinterpret_cast<char *>(&r.state), sizeof(VU1State));
+        r.code.resize(PS2_VU1_CODE_SIZE);
+        r.data.resize(PS2_VU1_DATA_SIZE);
+        in.read(reinterpret_cast<char *>(r.code.data()), PS2_VU1_CODE_SIZE);
+        in.read(reinterpret_cast<char *>(r.data.data()), PS2_VU1_DATA_SIZE);
+        if (!in)
+            break;
+        records.push_back(std::move(r));
+    }
+    std::printf("loaded %zu VU1 calls\n", records.size());
+
+    PS2Memory memory;
+    if (!memory.initialize())
+        return 1;
+    GS gs;
+    gs.init(memory.getGSVRAM(), static_cast<uint32_t>(PS2_GS_VRAM_SIZE), &memory.gs());
+    GifArbiter arbiter;
+    uint64_t gifBytes = 0, gifPackets = 0;
+    std::ofstream gifDump;
+    if (const char *path = std::getenv("VU_REPLAY_GIFDUMP"))
+        gifDump.open(path, std::ios::binary);
+    arbiter.setProcessPacketFn([&](const uint8_t *d, uint32_t size) {
+        if (gifDump.is_open())
+        {
+            gifDump.write(reinterpret_cast<const char *>(&size), 4);
+            gifDump.write(reinterpret_cast<const char *>(d), size);
+        }
+        gifBytes += size;
+        ++gifPackets;
+        static const bool noGs = std::getenv("VU_REPLAY_NOGS") != nullptr; // time VU1 alone
+        if (!noGs)
+            gs.processGIFPacket(d, size);
+    });
+    memory.setGifArbiter(&arbiter);
+
+    VU1Interpreter vu(VU1Interpreter::Unit::VU1);
+    vu.reset();
+
+    uint64_t checksum = 0;
+    double totalNs = 0;
+    uint64_t totalCycles = 0;
+    const bool forceInvalidate = std::getenv("VU_REPLAY_INVALIDATE") != nullptr;
+    for (int pass = 0; pass < repeat; ++pass)
+    {
+        gifBytes = gifPackets = 0;
+        uint64_t cycles = 0;
+        double callNs = 0;
+        const auto t0 = std::chrono::steady_clock::now();
+        for (const Record &r : records)
+        {
+            if (std::memcmp(memory.getVU1Code(), r.code.data(), PS2_VU1_CODE_SIZE) != 0)
+            {
+                std::memcpy(memory.getVU1Code(), r.code.data(), PS2_VU1_CODE_SIZE);
+                memory.markVU1CodeModified();
+            }
+            std::memcpy(memory.getVU1Data(), r.data.data(), PS2_VU1_DATA_SIZE);
+            const uint64_t before = vu.state().cycles; // interpreter's running cycle count
+            vu.state() = r.state;
+            vu.state().cycles = before;
+            if (forceInvalidate)
+                memory.markVU1CodeModified(); // the game re-uploads microcode (MPG) before its calls
+            const auto c0 = std::chrono::steady_clock::now();
+            if (r.kind == 0)
+                vu.execute(memory.getVU1Code(), PS2_VU1_CODE_SIZE, memory.getVU1Data(), PS2_VU1_DATA_SIZE,
+                           gs, &memory, r.startPC, r.top, r.itop, 65536);
+            else
+                vu.resume(memory.getVU1Code(), PS2_VU1_CODE_SIZE, memory.getVU1Data(), PS2_VU1_DATA_SIZE,
+                          gs, &memory, r.top, r.itop, 65536);
+            arbiter.drain();
+            callNs += std::chrono::duration<double, std::nano>(std::chrono::steady_clock::now() - c0).count();
+            cycles += vu.state().cycles - before;
+            if (pass == 0)
+            {
+                checksum = fnv1a(memory.getVU1Data(), PS2_VU1_DATA_SIZE, checksum);
+                checksum = fnv1a(reinterpret_cast<const uint8_t *>(vu.state().vf), sizeof(vu.state().vf), checksum);
+                checksum = fnv1a(reinterpret_cast<const uint8_t *>(vu.state().vi), sizeof(vu.state().vi), checksum);
+                const uint32_t flags[3] = {vu.state().mac, vu.state().status, vu.state().clip};
+                checksum = fnv1a(reinterpret_cast<const uint8_t *>(flags), sizeof(flags), checksum);
+            }
+        }
+        const double ns = callNs; (void)t0;
+        if (pass > 0) // first pass warms caches
+        {
+            totalNs += ns;
+            totalCycles += cycles;
+        }
+    }
+    if (std::getenv("VU_REPLAY_DETAIL"))
+    {
+        for (size_t i = 0; i < records.size(); ++i)
+        {
+            const Record &r = records[i];
+            std::memcpy(memory.getVU1Code(), r.code.data(), PS2_VU1_CODE_SIZE);
+            memory.markVU1CodeModified();
+            std::memcpy(memory.getVU1Data(), r.data.data(), PS2_VU1_DATA_SIZE);
+            vu.state() = r.state;
+            gifBytes = 0;
+            if (r.kind == 0)
+                vu.execute(memory.getVU1Code(), PS2_VU1_CODE_SIZE, memory.getVU1Data(), PS2_VU1_DATA_SIZE,
+                           gs, &memory, r.startPC, r.top, r.itop, 65536);
+            else
+                vu.resume(memory.getVU1Code(), PS2_VU1_CODE_SIZE, memory.getVU1Data(), PS2_VU1_DATA_SIZE,
+                          gs, &memory, r.top, r.itop, 65536);
+            arbiter.drain();
+            const VU1State &st = vu.state();
+            std::printf("call %3zu kind=%u start=0x%04x end_pc=0x%04x cycles=%6llu ebit=%d D=%d T=%d gif=%llu\n", i, r.kind,
+                        r.startPC, st.pc, (unsigned long long)st.cycles, st.ebit, st.stoppedByD, st.stoppedByT,
+                        (unsigned long long)gifBytes);
+        }
+    }
+    const int timed = repeat > 1 ? repeat - 1 : 1;
+    std::printf("per call: %.1f us   per VU cycle: %.1f ns   VU cycles/call: %.0f\n",
+                totalNs / timed / records.size() / 1000.0, totalNs / (totalCycles ? totalCycles : 1),
+                double(totalCycles) / timed / records.size());
+    std::printf("gif packets/pass: %llu  gif bytes/pass: %llu\n", (unsigned long long)gifPackets,
+                (unsigned long long)gifBytes);
+    std::printf("checksum: %016llx\n", (unsigned long long)checksum);
+    return 0;
+}
