+namespace
+{
+    // PS2X_VU1_STATS=1: count static blocks run vs pairs on the dynamic path
+    // (1 branch/E-bit/uncached, 2 block not usable, 3 budget, 4 entry not
+    // ready), with the top dynamic pcs, printed at exit.
+    struct Vu1PathStats
+    {
+        bool enabled = std::getenv("PS2X_VU1_STATS") != nullptr;
+        uint64_t counts[5]{};
+        std::unordered_map<uint32_t, uint64_t> pcs[5];
+        void note(uint32_t why, uint32_t pc)
+        {
+            if (!enabled)
+                return;
+            ++counts[why];
+            if (why != 0)
+                ++pcs[why][pc];
+        }
+        ~Vu1PathStats()
+        {
+            if (!enabled)
+                return;
+            std::printf("[vu1-stats] static blocks %llu, dynamic pairs: branch/ebit %llu, unusable %llu, budget %llu, entry %llu\n",
+                        (unsigned long long)counts[0], (unsigned long long)counts[1], (unsigned long long)counts[2],
+                        (unsigned long long)counts[3], (unsigned long long)counts[4]);
+            // PS2X_VU1_STATS=<file>: also every dynamic pc and its count
+            // (with PS2X_VU1_STATIC=0 that is the program's coverage).
+            const char *path = std::getenv("PS2X_VU1_STATS");
+            if (path && std::strlen(path) > 1)
+                if (FILE *f = std::fopen(path, "w"))
+                {
+                    for (uint32_t w = 1; w < 5; ++w)
+                        for (const auto &[pc, n] : pcs[w])
+                            std::fprintf(f, "%u %04x %llu\n", w, pc, (unsigned long long)n);
+                    std::fclose(f);
+                }
+            for (uint32_t w = 1; w < 5; ++w)
+            {
+                std::vector<std::pair<uint64_t, uint32_t>> v;
+                for (const auto &[pc, n] : pcs[w])
+                    v.emplace_back(n, pc);
+                std::sort(v.rbegin(), v.rend());
+                std::printf("[vu1-stats] reason %u:", w);
+                for (size_t i = 0; i < v.size() && i < 12; ++i)
+                    std::printf(" %04x:%llu", v[i].second, (unsigned long long)v[i].first);
+                std::printf("\n");
+            }
+        }
+    } g_vu1Stats;
+}
