+#ifndef PS2_VU1_FASTOPS_H
+#define PS2_VU1_FASTOPS_H
+
+// Fast paths for VU1 upper instructions, shared by the interpreter
+// (VU1Interpreter::execUpper) and by generated native blocks
+// (port/tools/vu1gen.py), which call them with constant instruction words so
+// the decode folds away. Everything here is bit-identical to the generic
+// interpreter path and returns false, without touching state, for any case
+// it cannot prove exact.
+
+#include "runtime/ps2_vu1.h"
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <cstring>
+#include <immintrin.h>
+#include <limits>
+
+#if defined(__GNUC__)
+#define PS2X_VU1_INLINE inline __attribute__((always_inline))
+#else
+#define PS2X_VU1_INLINE inline
+#endif
+
+namespace vu1fast
+{
+    enum FastKind : uint8_t
+    {
+        FastNone,
+        FastAdd,
+        FastSub,
+        FastMul,
+        FastMadd,
+        FastMsub,
+    };
+    enum FastSrc : uint8_t
+    {
+        SrcBc,
+        SrcQ,
+        SrcI,
+        SrcVt,
+    };
+    struct FastOp
+    {
+        FastKind kind = FastNone;
+        FastSrc src = SrcVt;
+    };
+
+    // Same numbering for the vd forms (bits 5:0) and the ACC forms in the
+    // 0x3C..0x3F group ((instr & 3) | ((instr >> 4) & 0x7C)).
+    constexpr std::array<FastOp, 128> makeFastOps()
+    {
+        std::array<FastOp, 128> t{};
+        for (uint32_t i = 0; i < 4; ++i)
+        {
+            t[0x00 + i] = {FastAdd, SrcBc};
+            t[0x04 + i] = {FastSub, SrcBc};
+            t[0x08 + i] = {FastMadd, SrcBc};
+            t[0x0C + i] = {FastMsub, SrcBc};
+            t[0x18 + i] = {FastMul, SrcBc};
+        }
+        t[0x1C] = {FastMul, SrcQ};
+        t[0x1E] = {FastMul, SrcI};
+        t[0x20] = {FastAdd, SrcQ};
+        t[0x21] = {FastMadd, SrcQ};
+        t[0x22] = {FastAdd, SrcI};
+        t[0x23] = {FastMadd, SrcI};
+        t[0x24] = {FastSub, SrcQ};
+        t[0x25] = {FastMsub, SrcQ};
+        t[0x26] = {FastSub, SrcI};
+        t[0x27] = {FastMsub, SrcI};
+        t[0x28] = {FastAdd, SrcVt};
+        t[0x29] = {FastMadd, SrcVt};
+        t[0x2A] = {FastMul, SrcVt};
+        t[0x2C] = {FastSub, SrcVt};
+        t[0x2D] = {FastMsub, SrcVt};
+        return t;
+    }
+    inline constexpr std::array<FastOp, 128> kFastOps = makeFastOps();
+
+    // DEST bits (x=8 .. w=1) <-> component bits (x=1 .. w=8).
+    inline constexpr uint8_t kReverse4[16] = {0, 8, 4, 12, 2, 10, 6, 14, 1, 9, 5, 13, 3, 11, 7, 15};
+    inline constexpr float kIntScale[4] = {1.0f, 16.0f, 4096.0f, 32768.0f};
+
+    // Same as normalizeOperand on four lanes: denormals -> +-0, Inf/NaN -> +-max.
+    PS2X_VU1_INLINE __m128 normalize4(__m128 v)
+    {
+        const __m128i bits = _mm_castps_si128(v);
+        const __m128i expMask = _mm_set1_epi32(0x7F800000);
+        const __m128i exp = _mm_and_si128(bits, expMask);
+        const __m128i sign = _mm_and_si128(bits, _mm_set1_epi32(static_cast<int>(0x80000000u)));
+        __m128i out = _mm_blendv_epi8(bits, sign, _mm_cmpeq_epi32(exp, _mm_setzero_si128()));
+        out = _mm_blendv_epi8(out, _mm_or_si128(sign, _mm_set1_epi32(0x7F7FFFFF)), _mm_cmpeq_epi32(exp, expMask));
+        return _mm_castsi128_ps(out);
+    }
+
+    // Lanes (component bit c set) whose exponent field is outside [lo, 253].
+    PS2X_VU1_INLINE int unsafeLanes(__m128 v, int lo)
+    {
+        const __m128i exp = _mm_srli_epi32(_mm_and_si128(_mm_castps_si128(v), _mm_set1_epi32(0x7F800000)), 23);
+        const __m128i bad = _mm_or_si128(_mm_cmplt_epi32(exp, _mm_set1_epi32(lo)),
+                                         _mm_cmpgt_epi32(exp, _mm_set1_epi32(253)));
+        return _mm_movemask_ps(_mm_castsi128_ps(bad));
+    }
+
+    PS2X_VU1_INLINE int zeroLanes(__m128 v)
+    {
+        const __m128i magnitude = _mm_and_si128(_mm_castps_si128(v), _mm_set1_epi32(0x7FFFFFFF));
+        return _mm_movemask_ps(_mm_castsi128_ps(_mm_cmpeq_epi32(magnitude, _mm_setzero_si128())));
+    }
+
+    PS2X_VU1_INLINE uint32_t maxExponent4(const float *v)
+    {
+        __m128i e = _mm_and_si128(_mm_loadu_si128(reinterpret_cast<const __m128i *>(v)), _mm_set1_epi32(0x7F800000));
+        e = _mm_max_epu32(e, _mm_shuffle_epi32(e, 0x4E));
+        e = _mm_max_epu32(e, _mm_shuffle_epi32(e, 0xB1));
+        return static_cast<uint32_t>(_mm_cvtsi128_si32(e)) >> 23;
+    }
+
+    PS2X_VU1_INLINE __m128 laneSelect(int laneMask)
+    {
+        return _mm_castsi128_ps(_mm_set_epi32((laneMask & 8) ? -1 : 0, (laneMask & 4) ? -1 : 0,
+                                              (laneMask & 2) ? -1 : 0, (laneMask & 1) ? -1 : 0));
+    }
+
+    PS2X_VU1_INLINE void storeLanes(float *dst, __m128 value, int laneMask)
+    {
+        _mm_storeu_ps(dst, _mm_blendv_ps(_mm_loadu_ps(dst), value, laneSelect(laneMask)));
+    }
+
+    inline int32_t vuFloatToInt(float value, float scale)
+    {
+        const double scaled = static_cast<double>(value) * static_cast<double>(scale);
+        if (scaled >= static_cast<double>(std::numeric_limits<int32_t>::max()))
+            return std::numeric_limits<int32_t>::max();
+        if (scaled <= static_cast<double>(std::numeric_limits<int32_t>::min()))
+            return std::numeric_limits<int32_t>::min();
+        return static_cast<int32_t>(scaled);
+    }
+
+    constexpr uint8_t dest(uint32_t i) { return static_cast<uint8_t>((i >> 21) & 0xF); }
+    constexpr uint8_t ft(uint32_t i) { return static_cast<uint8_t>((i >> 16) & 0x1F); }
+    constexpr uint8_t fs(uint32_t i) { return static_cast<uint8_t>((i >> 11) & 0x1F); }
+    constexpr uint8_t fd(uint32_t i) { return static_cast<uint8_t>((i >> 6) & 0x1F); }
+}
+
+struct VU1FastOps
+{
+    using Vu = VU1Interpreter;
+
+    // MAX/MINI (bc, i, full), ITOF*/FTOI*, ABS: no FMAC flags, so just the
+    // per-lane operation (same normalisation and comparisons as the generic
+    // path; _mm_max_ps/_mm_min_ps return the second operand on ties, like
+    // "vs > x ? vs : x"). Returns false for anything else.
+    static PS2X_VU1_INLINE bool simple(Vu &vu, uint32_t instr, uint32_t op, bool special4, uint32_t special)
+    {
+        using namespace vu1fast;
+        const uint8_t fsr = fs(instr);
+        const uint8_t ftr = ft(instr);
+        const int laneMask = kReverse4[dest(instr)];
+
+        if (!special4)
+        {
+            const bool isMax = (op >= 0x10u && op <= 0x13u) || op == 0x1Du || op == 0x2Bu;
+            const bool isMin = (op >= 0x14u && op <= 0x17u) || op == 0x1Fu || op == 0x2Fu;
+            if (!isMax && !isMin)
+                return false;
+            vu.m_currentUpperInstruction = instr;
+            const __m128 vs = normalize4(_mm_loadu_ps(vu.m_state.vf[fsr]));
+            __m128 x;
+            if (op <= 0x17u)
+                x = _mm_set1_ps(vu.normalizeOperand(vu.m_state.vf[ftr][op & 3u]));
+            else if (op == 0x1Du || op == 0x1Fu)
+                x = _mm_set1_ps(vu.normalizeOperand(vu.m_state.i));
+            else
+                x = normalize4(_mm_loadu_ps(vu.m_state.vf[ftr]));
+            storeLanes(vu.m_state.vf[fd(instr)], isMax ? _mm_max_ps(vs, x) : _mm_min_ps(vs, x), laneMask);
+            return true;
+        }
+
+        if (special >= 0x10u && special <= 0x13u) // ITOF0/4/12/15
+        {
+            vu.m_currentUpperInstruction = instr;
+            __m128 value = _mm_cvtepi32_ps(_mm_loadu_si128(reinterpret_cast<const __m128i *>(vu.m_state.vf[fsr])));
+            if (special != 0x10u)
+                value = _mm_div_ps(value, _mm_set1_ps(kIntScale[special & 3u]));
+            storeLanes(vu.m_state.vf[ftr], value, laneMask);
+            return true;
+        }
+        if (special >= 0x14u && special <= 0x17u) // FTOI0/4/12/15
+        {
+            vu.m_currentUpperInstruction = instr;
+            float result[4];
+            for (int c = 0; c < 4; ++c)
+            {
+                const int32_t iv = vuFloatToInt(vu.normalizeOperand(vu.m_state.vf[fsr][c]), kIntScale[special & 3u]);
+                std::memcpy(&result[c], &iv, 4);
+            }
+            storeLanes(vu.m_state.vf[ftr], _mm_loadu_ps(result), laneMask);
+            return true;
+        }
+        if (special == 0x1Du) // ABS
+        {
+            vu.m_currentUpperInstruction = instr;
+            const __m128 vs = normalize4(_mm_loadu_ps(vu.m_state.vf[fsr]));
+            storeLanes(vu.m_state.vf[ftr], _mm_andnot_ps(_mm_set1_ps(-0.0f), vs), laneMask);
+            return true;
+        }
+        return false;
+    }
+
+    // Vectorised ADD/SUB/MUL/MADD/MSUB (bc, q, i, full; vd or ACC
+    // destination). Same operand normalisation and float operations in the
+    // same order as the scalar path (no FMA contraction); only lanes that are
+    // provably exact are taken (result safely normal, or an exact +-0), where
+    // the flags are just Z/S. Anything else returns false untouched.
+    // DeadFlags: the generator proved this op's MAC/status entry is replaced
+    // before anything can read it (see port/tools/vu1gen.py); only its
+    // sticky bits are kept, folded into the next entry that writes status.
+    template <bool DeadFlags = false>
+    static PS2X_VU1_INLINE bool fmac(Vu &vu, uint32_t instr, vu1fast::FastOp fop, bool toAcc)
+    {
+        using namespace vu1fast;
+        const uint32_t op = instr & 0x3Fu;
+        const uint8_t d = dest(instr);
+        const uint8_t fsr = fs(instr);
+        const uint8_t ftr = ft(instr);
+        vu.m_currentUpperInstruction = instr;
+        if (d == 0u)
+            return true; // nothing written, no flag update (as applyFmacDest)
+
+        const bool productSum = fop.kind == FastMadd || fop.kind == FastMsub;
+        int minExp = 1;
+        if (productSum)
+        {
+            // Same operand bound as normalizeFmacResult's product-sum fast path.
+            uint32_t qBits, iBits;
+            std::memcpy(&qBits, &vu.m_state.q, 4);
+            std::memcpy(&iBits, &vu.m_state.i, 4);
+            const uint32_t operandExp = std::max(std::max(maxExponent4(vu.m_state.vf[fsr]), maxExponent4(vu.m_state.vf[ftr])),
+                                                 std::max((qBits >> 23) & 0xFFu, (iBits >> 23) & 0xFFu));
+            if (operandExp >= 190u)
+                return false;
+            minExp = 26;
+        }
+
+        const __m128 vs = normalize4(_mm_loadu_ps(vu.m_state.vf[fsr]));
+        __m128 x;
+        switch (fop.src)
+        {
+        case SrcBc:
+            x = _mm_set1_ps(vu.normalizeOperand(vu.m_state.vf[ftr][op & 3u]));
+            break;
+        case SrcQ:
+            x = _mm_set1_ps(vu.normalizeOperand(vu.m_state.q));
+            break;
+        case SrcI:
+            x = _mm_set1_ps(vu.normalizeOperand(vu.m_state.i));
+            break;
+        default:
+            x = normalize4(_mm_loadu_ps(vu.m_state.vf[ftr]));
+            break;
+        }
+
+        const int laneMask = kReverse4[d]; // component bits written
+        // Lanes where an operand is +-0: the product is exactly +-0 (same sign
+        // rule in float and in the exact path), never an underflow.
+        const int zeroOperand = (fop.kind == FastMul || productSum) ? ((zeroLanes(vs) | zeroLanes(x)) & laneMask) : 0;
+
+        __m128 result;
+        int productSigns = 0;
+        int productZeros = 0;
+        switch (fop.kind)
+        {
+        case FastAdd:
+            result = _mm_add_ps(vs, x);
+            break;
+        case FastSub:
+            result = _mm_sub_ps(vs, x);
+            break;
+        case FastMul:
+            result = _mm_mul_ps(vs, x);
+            break;
+        default:
+        {
+            const __m128 product = _mm_mul_ps(vs, x);
+            if (unsafeLanes(product, 1) & laneMask & ~zeroOperand)
+                return false;
+            productSigns = _mm_movemask_ps(product) & laneMask;
+            productZeros = zeroOperand;
+            const __m128 acc = normalize4(_mm_loadu_ps(vu.m_state.acc));
+            result = fop.kind == FastMadd ? _mm_add_ps(acc, product) : _mm_sub_ps(acc, product);
+            break;
+        }
+        }
+        const int zeros = zeroLanes(result) & laneMask;
+        int unsafe = unsafeLanes(result, minExp) & laneMask;
+        if (fop.kind == FastAdd || fop.kind == FastSub)
+        {
+            // ADD/SUB of two normalised floats is +-0 only when the exact sum is
+            // 0, with the same sign rule: a zero lane just sets Z (and S if -0).
+            unsafe &= ~zeros;
+        }
+        else if (fop.kind == FastMul)
+        {
+            unsafe &= ~(zeros & zeroOperand);
+        }
+        else
+        {
+            // Exact product +-0: the result is acc +- 0 = acc exactly (or an
+            // exact +-0), so only an overflow-sized value would need the exact
+            // path; acc is normalised, so exponent 254 still means <= max.
+            const __m128i exp = _mm_srli_epi32(_mm_and_si128(_mm_castps_si128(result), _mm_set1_epi32(0x7F800000)), 23);
+            const int denormal = _mm_movemask_ps(_mm_castsi128_ps(_mm_cmpeq_epi32(exp, _mm_setzero_si128()))) & ~zeros;
+            unsafe &= ~(zeroOperand & ~denormal);
+        }
+        if (unsafe)
+            return false;
+
+        // Flag pipeline entry, as updateFmacFlags builds it: per lane Z (bit 0)
+        // and S (bit 1) into MAC (lane, lane << 4) and the status low bits.
+        const int signs = _mm_movemask_ps(result) & laneMask;
+        if constexpr (DeadFlags)
+        {
+            vu.m_deadSticky |= (zeros || productZeros ? 0x1u : 0u) | (signs || productSigns ? 0x2u : 0u);
+            storeLanes(toAcc ? vu.m_state.acc : vu.m_state.vf[fd(instr)], result, laneMask);
+            return true;
+        }
+        Vu::FlagPipelineEntry *entry = vu.allocFlagEntry();
+        if (!entry)
+        {
+            vu.reportReservedInstruction(true, 0xFFFFFFFFu);
+        }
+        else
+        {
+            entry->issueCycle = vu.m_cycle;
+            entry->readyCycle = vu.m_cycle + Vu::kFmacLatency;
+            entry->mac = static_cast<uint32_t>(kReverse4[zeros]) | (static_cast<uint32_t>(kReverse4[signs]) << 4);
+            entry->status = (zeros ? 0x1u : 0u) | (signs ? 0x2u : 0u);
+            entry->extraSticky = (productSigns ? 0x2u : 0u) | (productZeros ? 0x1u : 0u) | vu.m_deadSticky;
+            vu.m_deadSticky = 0u;
+            entry->writesMac = true;
+            entry->writesStatus = true;
+        }
+
+        storeLanes(toAcc ? vu.m_state.acc : vu.m_state.vf[fd(instr)], result, laneMask);
+        return true;
+    }
+
+    // Fast path for one upper instruction (NOP, simple ops, FMAC); false =
+    // run the generic interpreter path.
+    template <bool DeadFlags = false>
+    static PS2X_VU1_INLINE bool upper(Vu &vu, uint32_t instr)
+    {
+        using namespace vu1fast;
+        const uint32_t op = instr & 0x3Fu;
+        const bool toAcc = op >= 0x3Cu;
+        const uint32_t special = (instr & 3u) | ((instr >> 4) & 0x7Cu);
+        if (toAcc && (special == 0x2Fu || special == 0x30u))
+        {
+            vu.m_currentUpperInstruction = instr; // NOP: the generic path changes nothing else
+            return true;
+        }
+        if (simple(vu, instr, op, toAcc, special))
+            return true;
+        const FastOp fop = kFastOps[toAcc ? special : op];
+        if (fop.kind == FastNone)
+            return false;
+        return fmac<DeadFlags>(vu, instr, fop, toAcc);
+    }
+
+    // ---- helpers for generated native blocks (see vu1gen.py)
+    static PS2X_VU1_INLINE uint64_t cycle(const Vu &vu) { return vu.m_cycle; }
+
+    // Advance to the next pair's scheduled cycle, exactly as runStaticBlock.
+    static PS2X_VU1_INLINE void step(Vu &vu, uint64_t target)
+    {
+        if (vu.m_xgkick.active)
+            vu.advanceTo(target);
+        else
+        {
+            vu.m_cycle = target;
+            vu.m_state.cycles = target;
+        }
+        if (vu.m_cycle >= vu.m_nextCommit)
+            vu.commitReadyPipelines();
+    }
+
+    template <uint32_t U, bool DeadFlags = false>
+    static PS2X_VU1_INLINE void upperC(Vu &vu)
+    {
+        if (!upper<DeadFlags>(vu, U))
+            vu.execUpperGeneric(U); // pushes a normal entry (and folds dead sticky bits)
+    }
+
+    // Lower instruction with a constant word: the most common loads/stores
+    // and integer ops inline (same code as VU1Interpreter::execLower), the
+    // rest through the interpreter.
+    template <uint32_t L, uint32_t U>
+    static PS2X_VU1_INLINE void lowerC(Vu &vu, uint8_t *data, uint32_t dataSize, GS &gs, PS2Memory *memory)
+    {
+        using namespace vu1fast;
+        constexpr uint32_t opHi = (L >> 25) & 0x7Fu;
+        constexpr uint8_t viT = static_cast<uint8_t>((L >> 16) & 0xFu);
+        constexpr uint8_t viS = static_cast<uint8_t>((L >> 11) & 0xFu);
+        constexpr uint8_t viD = static_cast<uint8_t>((L >> 6) & 0xFu);
+        constexpr uint8_t vfT = ft(L);
+        constexpr uint8_t vfS = fs(L);
+        constexpr uint8_t d = dest(L);
+        constexpr int16_t imm11 = static_cast<int16_t>(static_cast<int32_t>(L << 21) >> 21);
+        constexpr uint32_t funct = L & 0x3Fu;
+        constexpr uint32_t funct2 = (L & 0x3u) | ((L >> 4) & 0x7Cu);
+        const auto loadVf = [&](uint32_t addr, uint8_t reg)
+        {
+            addr &= (dataSize - 1);
+            if (addr + 16 <= dataSize)
+                storeLanes(vu.m_state.vf[reg], _mm_loadu_ps(reinterpret_cast<const float *>(data + addr)), kReverse4[d]);
+        };
+        const auto storeVf = [&](uint32_t addr, uint8_t reg)
+        {
+            addr &= (dataSize - 1);
+            if (addr + 16 <= dataSize)
+            {
+                uint32_t words[4];
+                std::memcpy(words, vu.m_state.vf[reg], sizeof(words));
+                if (!vu.m_xgkick.active && data == vu.m_activeVuData)
+                {
+                    // A queued store becomes visible one cycle later, before
+                    // the next pair runs; only an active XGKICK (PATH1 reads
+                    // VU memory every cycle) could see the difference.
+                    uint32_t *dst = reinterpret_cast<uint32_t *>(data + addr);
+                    if constexpr ((d & 8u) != 0u) dst[0] = words[0];
+                    if constexpr ((d & 4u) != 0u) dst[1] = words[1];
+                    if constexpr ((d & 2u) != 0u) dst[2] = words[2];
+                    if constexpr ((d & 1u) != 0u) dst[3] = words[3];
+                }
+                else
+                    vu.queueStore(addr, words, d);
+            }
+        };
+
+        if constexpr (L == 0x00000000u || L == 0x8000033Cu)
+        {
+            // NOP
+        }
+        else if constexpr (opHi == 0x00u) // LQ
+            loadVf(static_cast<uint32_t>(static_cast<int32_t>(vu.m_state.vi[viS] + imm11)) * 16u, vfT);
+        else if constexpr (opHi == 0x01u) // SQ
+            storeVf(static_cast<uint32_t>(static_cast<int32_t>(vu.m_state.vi[viT] + imm11)) * 16u, vfS);
+        else if constexpr (opHi == 0x04u) // ILW
+        {
+            uint32_t addr = static_cast<uint32_t>(static_cast<int32_t>(vu.m_state.vi[viS] + imm11)) * 16u;
+            addr &= (dataSize - 1);
+            if (addr + 16 <= dataSize)
+            {
+                constexpr int comp = (d & 0x8) ? 0 : (d & 0x4) ? 1 : (d & 0x2) ? 2 : 3;
+                uint32_t v;
+                std::memcpy(&v, data + addr + comp * 4, 4);
+                if constexpr (viT != 0)
+                    vu.m_state.vi[viT] = static_cast<int32_t>(static_cast<int16_t>(v & 0xFFFF));
+            }
+        }
+        else if constexpr (opHi == 0x05u) // ISW
+        {
+            uint32_t addr = static_cast<uint32_t>(static_cast<int32_t>(vu.m_state.vi[viS] + imm11)) * 16u;
+            addr &= (dataSize - 1);
+            if (addr + 16 <= dataSize)
+            {
+                const uint32_t val = static_cast<uint32_t>(static_cast<uint16_t>(vu.m_state.vi[viT] & 0xFFFF));
+                const uint32_t words[4] = {val, val, val, val};
+                vu.queueStore(addr, words, d);
+            }
+        }
+        else if constexpr (opHi == 0x08u || opHi == 0x09u) // IADDIU / ISUBIU
+        {
+            constexpr int16_t imm = static_cast<int16_t>(static_cast<int16_t>(L & 0x7FF) | ((L >> 10) & 0x7800));
+            if constexpr (viT != 0)
+            {
+                if constexpr (opHi == 0x08u)
+                    vu.m_state.vi[viT] = static_cast<int16_t>(vu.m_state.vi[viS] + imm);
+                else
+                    vu.m_state.vi[viT] = static_cast<int16_t>(vu.m_state.vi[viS] - imm);
+            }
+        }
+        else if constexpr (opHi == 0x40u && funct == 0x30u) // IADD
+        {
+            if constexpr (viD != 0)
+                vu.m_state.vi[viD] = static_cast<int16_t>(vu.m_state.vi[viS] + vu.m_state.vi[viT]);
+        }
+        else if constexpr (opHi == 0x40u && funct == 0x31u) // ISUB
+        {
+            if constexpr (viD != 0)
+                vu.m_state.vi[viD] = static_cast<int16_t>(vu.m_state.vi[viS] - vu.m_state.vi[viT]);
+        }
+        else if constexpr (opHi == 0x40u && funct == 0x32u) // IADDI
+        {
+            constexpr int16_t imm5 = static_cast<int16_t>(static_cast<int32_t>((L >> 6) & 0x1F) << 27 >> 27);
+            if constexpr (viT != 0)
+                vu.m_state.vi[viT] = static_cast<int16_t>(vu.m_state.vi[viS] + imm5);
+        }
+        else if constexpr (opHi == 0x40u && funct == 0x34u) // IAND
+        {
+            if constexpr (viD != 0)
+                vu.m_state.vi[viD] = vu.m_state.vi[viS] & vu.m_state.vi[viT];
+        }
+        else if constexpr (opHi == 0x40u && funct == 0x35u) // IOR
+        {
+            if constexpr (viD != 0)
+                vu.m_state.vi[viD] = vu.m_state.vi[viS] | vu.m_state.vi[viT];
+        }
+        else if constexpr (opHi == 0x40u && funct >= 0x3Cu && funct2 == 0x30u) // MOVE
+            storeLanes(vu.m_state.vf[vfT], _mm_loadu_ps(vu.m_state.vf[vfS]), kReverse4[d]);
+        else if constexpr (opHi == 0x40u && funct >= 0x3Cu && funct2 == 0x31u) // MR32
+        {
+            const __m128 v = _mm_loadu_ps(vu.m_state.vf[vfS]);
+            storeLanes(vu.m_state.vf[vfT], _mm_shuffle_ps(v, v, _MM_SHUFFLE(0, 3, 2, 1)), kReverse4[d]);
+        }
+        else if constexpr (opHi == 0x40u && funct >= 0x3Cu && funct2 == 0x34u) // LQI
+        {
+            loadVf(static_cast<uint32_t>(static_cast<uint16_t>(vu.m_state.vi[viS])) * 16u, vfT);
+            if constexpr (viS != 0)
+                vu.m_state.vi[viS] = static_cast<int16_t>(vu.m_state.vi[viS] + 1);
+        }
+        else if constexpr (opHi == 0x40u && funct >= 0x3Cu && funct2 == 0x35u) // SQI
+        {
+            storeVf(static_cast<uint32_t>(static_cast<uint16_t>(vu.m_state.vi[viT])) * 16u, vfS);
+            if constexpr (viT != 0)
+                vu.m_state.vi[viT] = static_cast<int16_t>(vu.m_state.vi[viT] + 1);
+        }
+        else if constexpr (opHi == 0x40u && funct >= 0x3Cu && funct2 == 0x3Cu) // MTIR (fsf in bits 22:21)
+        {
+            constexpr uint32_t comp = (L >> 21) & 0x3u;
+            uint32_t bits;
+            std::memcpy(&bits, &vu.m_state.vf[vfS][comp], 4);
+            if constexpr (viT != 0)
+                vu.m_state.vi[viT] = static_cast<int32_t>(static_cast<int16_t>(bits & 0xFFFFu));
+        }
+        else if constexpr (opHi == 0x40u && funct >= 0x3Cu && funct2 == 0x3Du) // MFIR
+        {
+            const int32_t value = static_cast<int32_t>(static_cast<int16_t>(vu.m_state.vi[viS] & 0xFFFF));
+            storeLanes(vu.m_state.vf[vfT], _mm_castsi128_ps(_mm_set1_epi32(value)), kReverse4[d]);
+        }
+        else if constexpr (opHi == 0x20u || opHi == 0x21u || opHi == 0x24u || opHi == 0x25u ||
+                           opHi == 0x28u || opHi == 0x29u || (opHi >= 0x2Cu && opHi <= 0x2Fu))
+        {
+            // Branches (same code as execLower; native blocks are VU1, 16 KB
+            // of microcode). Conditions read VI through the branch backup.
+            constexpr uint32_t pcMask = 0x3FFFu;
+            const auto branchVi = [&](uint8_t reg) -> int16_t
+            {
+                if (reg == 0u)
+                    return 0;
+                if (vu.m_viBranchBackupValid && vu.m_viBranchBackupReg == reg)
+                    return static_cast<int16_t>(vu.m_viBranchBackupValue);
+                return static_cast<int16_t>(vu.m_state.vi[reg]);
+            };
+            bool taken = true;
+            uint32_t target;
+            if constexpr (opHi == 0x24u || opHi == 0x25u) // JR / JALR
+                target = (static_cast<uint32_t>(static_cast<uint16_t>(branchVi(viS))) * 8u) & pcMask;
+            else
+            {
+                target = (vu.m_state.pc + 8u + static_cast<uint32_t>(static_cast<int32_t>(imm11) * 8)) & pcMask;
+                if constexpr (opHi == 0x28u)
+                    taken = branchVi(viS) == branchVi(viT);
+                else if constexpr (opHi == 0x29u)
+                    taken = branchVi(viS) != branchVi(viT);
+                else if constexpr (opHi == 0x2Cu)
+                    taken = branchVi(viS) < 0;
+                else if constexpr (opHi == 0x2Du)
+                    taken = branchVi(viS) > 0;
+                else if constexpr (opHi == 0x2Eu)
+                    taken = branchVi(viS) <= 0;
+                else if constexpr (opHi == 0x2Fu)
+                    taken = branchVi(viS) >= 0;
+            }
+            if constexpr ((opHi == 0x21u || opHi == 0x25u) && viT != 0) // BAL / JALR link
+                vu.m_state.vi[viT] = static_cast<int32_t>((vu.m_state.pc + 16u) / 8u);
+            if (taken)
+            {
+                vu.m_state.branchPending = true;
+                vu.m_state.branchTarget = target;
+                vu.m_state.branchDelay = 1;
+            }
+        }
+        else
+            vu.execLower(L, data, dataSize, gs, memory, U);
+    }
+
+    // finishPair with the pair's words as constants (E/D/T bits and whether
+    // the lower op is a branch fold away). Same logic as
+    // VU1Interpreter::finishPair.
+    template <uint32_t U, uint32_t L>
+    static PS2X_VU1_INLINE bool finishPairC(Vu &vu, uint32_t codeSize)
+    {
+        constexpr bool eBit = (U & 0x40000000u) != 0u;
+        constexpr bool dBit = (U & 0x10000000u) != 0u;
+        constexpr bool tBit = (U & 0x08000000u) != 0u;
+        constexpr uint32_t opHi = (L >> 25) & 0x7Fu;
+        constexpr bool lowerBranch = (U & 0x80000000u) == 0u && opHi >= 0x20u && opHi <= 0x2Fu;
+        bool ended = false;
+        vu.m_state.vf[0][0] = 0.0f;
+        vu.m_state.vf[0][1] = 0.0f;
+        vu.m_state.vf[0][2] = 0.0f;
+        vu.m_state.vf[0][3] = 1.0f;
+        vu.m_state.vi[0] = 0;
+        uint32_t nextPc = vu.m_state.pc + 8u;
+        if (nextPc >= codeSize)
+            nextPc = 0u;
+        vu.m_state.pc = nextPc;
+        if (vu.m_state.branchPending)
+        {
+            if (vu.m_state.branchDelay == 0u)
+            {
+                vu.m_state.pc = vu.m_state.branchTarget & 0x3FFFu;
+                vu.m_state.branchPending = false;
+            }
+            else
+                --vu.m_state.branchDelay;
+        }
+        const bool dHalt = dBit && vu.m_state.dBitEnabled;
+        const bool tHalt = tBit && vu.m_state.tBitEnabled;
+        const bool haltBit = dHalt || tHalt;
+        const bool haltBranch = haltBit && lowerBranch;
+        if (vu.m_state.haltAfterDelaySlot)
+        {
+            vu.m_state.stoppedByD = vu.m_pendingHaltD;
+            vu.m_state.stoppedByT = vu.m_pendingHaltT;
+            ended = true;
+        }
+        else if (vu.m_state.ebit)
+            ended = true;
+        else if (haltBit && !haltBranch)
+        {
+            vu.m_state.stoppedByD = dHalt;
+            vu.m_state.stoppedByT = tHalt;
+            ended = true;
+        }
+        else if constexpr (eBit)
+            vu.m_state.ebit = true;
+        else if (haltBranch)
+        {
+            vu.m_state.haltAfterDelaySlot = true;
+            vu.m_pendingHaltD = dHalt;
+            vu.m_pendingHaltT = tHalt;
+        }
+        return ended;
+    }
+
+    // End of a "plain" pair (see StaticBlock::plain).
+    static PS2X_VU1_INLINE void plainEnd(Vu &vu)
+    {
+        vu.m_viBranchBackupValid = false;
+        vu.m_state.vf[0][0] = 0.0f;
+        vu.m_state.vf[0][1] = 0.0f;
+        vu.m_state.vf[0][2] = 0.0f;
+        vu.m_state.vf[0][3] = 1.0f;
+        vu.m_state.vi[0] = 0;
+        vu.m_state.pc += 8u;
+    }
+
+    static PS2X_VU1_INLINE const Vu::DecodedInstructionPair &decoded(const Vu &vu, uint32_t pairIndex)
+    {
+        return vu.m_decodedCodeCache[pairIndex];
+    }
+
+    // execPairDirect (without markPairWrites) with constant instruction words.
+    template <uint32_t U, uint32_t L>
+    static PS2X_VU1_INLINE void pair(Vu &vu, const Vu::DecodedInstructionPair &dec, uint8_t *data, uint32_t dataSize,
+                                     GS &gs, PS2Memory *memory)
+    {
+        uint8_t writtenVi = 0u;
+        int32_t oldVi = 0;
+        const uint16_t viWrite = dec.lowerUsage.viWrite & 0xFFFEu;
+        if (viWrite != 0u)
+        {
+            writtenVi = static_cast<uint8_t>(__builtin_ctz(viWrite));
+            oldVi = vu.m_state.vi[writtenVi];
+        }
+        if constexpr ((U & 0x80000000u) != 0u) // I-bit: the lower word is the immediate
+        {
+            upperC<U>(vu);
+            const uint32_t bits = L;
+            float immediate;
+            std::memcpy(&immediate, &bits, sizeof(immediate));
+            vu.m_state.i = vu.normalizeOperand(immediate);
+        }
+        else if (dec.upperVfShadowReg != 0u)
+        {
+            float oldVf[4];
+            float upperVf[4];
+            std::memcpy(oldVf, vu.m_state.vf[dec.upperVfShadowReg], sizeof(oldVf));
+            upperC<U>(vu);
+            std::memcpy(upperVf, vu.m_state.vf[dec.upperVfShadowReg], sizeof(upperVf));
+            std::memcpy(vu.m_state.vf[dec.upperVfShadowReg], oldVf, sizeof(oldVf));
+            lowerC<L, U>(vu, data, dataSize, gs, memory);
+            std::memcpy(vu.m_state.vf[dec.upperVfShadowReg], upperVf, sizeof(upperVf));
+        }
+        else
+        {
+            upperC<U>(vu);
+            lowerC<L, U>(vu, data, dataSize, gs, memory);
+        }
+        vu.m_viBranchBackupValid = false;
+        if (writtenVi != 0u && dec.lowerUsage.delaysNextBranchRead)
+            vu.recordViWriteForBranch(writtenVi, oldVi);
+    }
+
+    // pair<>() when the next pair's lower op is not a branch: nothing reads
+    // the branch-VI backup (it is only valid for the very next pair), so it
+    // is not recorded. End with plainEnd().
+    template <uint32_t U, uint32_t L>
+    static PS2X_VU1_INLINE void pairNB(Vu &vu, const Vu::DecodedInstructionPair &dec, uint8_t *data, uint32_t dataSize,
+                                       GS &gs, PS2Memory *memory)
+    {
+        if constexpr ((U & 0x80000000u) != 0u) // I-bit: the lower word is the immediate
+        {
+            upperC<U>(vu);
+            const uint32_t bits = L;
+            float immediate;
+            std::memcpy(&immediate, &bits, sizeof(immediate));
+            vu.m_state.i = vu.normalizeOperand(immediate);
+        }
+        else if (dec.upperVfShadowReg != 0u)
+        {
+            float oldVf[4];
+            float upperVf[4];
+            std::memcpy(oldVf, vu.m_state.vf[dec.upperVfShadowReg], sizeof(oldVf));
+            upperC<U>(vu);
+            std::memcpy(upperVf, vu.m_state.vf[dec.upperVfShadowReg], sizeof(upperVf));
+            std::memcpy(vu.m_state.vf[dec.upperVfShadowReg], oldVf, sizeof(oldVf));
+            lowerC<L, U>(vu, data, dataSize, gs, memory);
+            std::memcpy(vu.m_state.vf[dec.upperVfShadowReg], upperVf, sizeof(upperVf));
+        }
+        else
+        {
+            upperC<U>(vu);
+            lowerC<L, U>(vu, data, dataSize, gs, memory);
+        }
+    }
+
+    static PS2X_VU1_INLINE bool finishPair(Vu &vu, const Vu::DecodedInstructionPair &dec, uint32_t codeSize)
+    {
+        return vu.finishPair(dec, codeSize);
+    }
+
+    // End of a plain pair that went through pair<>(): like plainEnd but
+    // keeps the branch-VI backup pair<>() may have recorded.
+    static PS2X_VU1_INLINE void plainEndKeepBackup(Vu &vu)
+    {
+        vu.m_state.vf[0][0] = 0.0f;
+        vu.m_state.vf[0][1] = 0.0f;
+        vu.m_state.vf[0][2] = 0.0f;
+        vu.m_state.vf[0][3] = 1.0f;
+        vu.m_state.vi[0] = 0;
+        vu.m_state.pc += 8u;
+    }
+
+    static inline bool generic(Vu &vu, uint32_t pairIndex, uint32_t codeSize, uint8_t *data, uint32_t dataSize,
+                               GS &gs, PS2Memory *memory)
+    {
+        const Vu::DecodedInstructionPair &decoded = vu.m_decodedCodeCache[pairIndex];
+        vu.execPairDirect(decoded, data, dataSize, gs, memory, false);
+        return vu.finishPair(decoded, codeSize);
+    }
+
+    static inline bool finish(Vu &vu, const Vu::StaticBlock &block, uint64_t entry, bool ended)
+    {
+        return vu.finishStaticBlock(block, entry, ended);
+    }
+};
+
+#endif
