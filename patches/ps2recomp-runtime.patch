+    // PS2X_VU1_BLOCKLOG=<file>: append every static block that has no native
+    // version yet (once per key) for port/tools/vu1gen.py. Record: "VBL1",
+    // u64 key, u32 start pair, u32 pair count, then per pair u32 lower,
+    // u32 upper, u8 plain flags. The log holds game code: never commit it.
+    void logStaticBlock(const VU1Interpreter::StaticBlock &block, uint32_t startIndex, const uint8_t *vuCode)
+    {
+        static const char *path = std::getenv("PS2X_VU1_BLOCKLOG");
+        if (!path)
+            return;
+        static std::mutex mutex;
+        static std::unordered_set<uint64_t> logged;
+        static FILE *file = std::fopen(path, "ab");
+        std::lock_guard<std::mutex> lock(mutex);
+        if (!file || !logged.insert(block.key).second)
+            return;
+        const uint32_t header[2] = {startIndex, block.pairCount};
+        std::fwrite("VBL1", 1, 4, file);
+        std::fwrite(&block.key, 8, 1, file);
+        std::fwrite(header, 4, 2, file);
+        for (uint32_t i = 0; i < block.pairCount; ++i)
+        {
+            std::fwrite(vuCode + (startIndex + i) * 8u, 1, 8, file);
+            std::fwrite(&block.plain[i], 1, 1, file);
+        }
+        std::fflush(file);
+    }
+}
