+    struct NativeRegistry
+    {
+        std::vector<vu1native::ProgramEntry> entries;
+        std::unordered_map<uint32_t, std::vector<uint32_t>> byPc; // entry pc -> indices
+    };
+    NativeRegistry &nativeRegistry()
+    {
+        static NativeRegistry registry;
+        return registry;
+    }
+    bool g_nativeEnabled = [] {
+        const char *env = std::getenv("PS2X_VU1_PROGRAMS");
+        return !(env && env[0] == '0');
+    }();
+
+    // The program registered for pc whose code pairs match the current
+    // microcode; per entry the match is checked once per code generation.
+    vu1native::ProgramFn findNativeProgram(uint64_t generation, const uint8_t *code, uint32_t codeSize, uint32_t pc)
+    {
+        NativeRegistry &registry = nativeRegistry();
+        const auto it = registry.byPc.find(pc);
+        if (it == registry.byPc.end() || codeSize < 0x4000u)
+            return nullptr;
+        thread_local uint64_t cachedGeneration = ~0ull;
+        thread_local const uint8_t *cachedCode = nullptr;
+        thread_local std::vector<int8_t> match; // per entry: -1 unknown, 0 no, 1 yes
+        if (generation != cachedGeneration || code != cachedCode || match.size() != registry.entries.size())
+        {
+            cachedGeneration = generation;
+            cachedCode = code;
+            match.assign(registry.entries.size(), -1);
+        }
+        for (const uint32_t index : it->second)
+        {
+            if (match[index] < 0)
+            {
+                const vu1native::ProgramEntry &e = registry.entries[index];
+                match[index] = vu1native::codeHash(code, e.ranges, e.rangeCount) == e.codeHash ? 1 : 0;
+            }
+            if (match[index] == 1)
+                return registry.entries[index].fn;
+        }
+        return nullptr;
+    }
+}
+
+void vu1native::registerPrograms(const ProgramEntry *entries, size_t count)
+{
+    NativeRegistry &registry = nativeRegistry();
+    for (size_t i = 0; i < count; ++i)
+    {
+        if (!entries[i].fn)
+            continue;
+        registry.byPc[entries[i].pc].push_back(static_cast<uint32_t>(registry.entries.size()));
+        registry.entries.push_back(entries[i]);
+    }
+}
