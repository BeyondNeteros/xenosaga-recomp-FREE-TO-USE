+bool GSCpuBackend::QueueConflicts(const GSPrimitiveBatch &batch) const
+{
+    const PrimRanges r = primRanges(batch);
+    for (const MemRange &w : m_writes)
+    {
+        // Same buffer and layout: a pixel is always handled by the same band.
+        if (w.tag != r.ftag && overlaps(r.flo, r.fhi, w.lo, w.hi))
+            return true;
+        if (r.z && w.tag != r.ztag && overlaps(r.zlo, r.zhi, w.lo, w.hi))
+            return true;
+        if (r.tex && overlaps(r.tlo, r.thi, w.lo, w.hi))
+            return true;
+    }
+    for (const MemRange &rd : m_reads)
+        if (overlaps(r.flo, r.fhi, rd.lo, rd.hi) || (r.z && overlaps(r.zlo, r.zhi, rd.lo, rd.hi)))
+            return true;
+    return false;
+}
+
+void GSCpuBackend::AddRanges(const GSPrimitiveBatch &batch)
+{
+    const PrimRanges r = primRanges(batch);
+    const auto addUnique = [](std::vector<MemRange> &list, const MemRange &range)
+    {
+        for (const MemRange &e : list)
+            if (e.lo == range.lo && e.hi == range.hi && e.tag == range.tag)
+                return;
+        list.push_back(range);
+    };
+    addUnique(m_writes, {r.flo, r.fhi, r.ftag});
+    if (r.z)
+        addUnique(m_writes, {r.zlo, r.zhi, r.ztag});
+    if (r.tex)
+        addUnique(m_reads, {r.tlo, r.thi, 0u});
+}
+
+void GSCpuBackend::DrawPendingBand(uint32_t band)
+{
+    // Queued primitives are drawn later and on other threads: use one
+    // rounding mode for all of them (round to nearest, the async GS
+    // thread's default; MXCSR RC = 0). Flush-to-zero / denormals-are-zero
+    // while rasterizing: same output on the tutorial capture, a few percent
+    // faster.
+    const unsigned int previousCsr = _mm_getcsr();
+    _mm_setcsr((previousCsr & ~0x6000u) | 0x8040u);
+    t_band = band;
+    t_bandCount = m_bandCount;
+    t_ownsRowY = -1;
+    for (const PendingPrimitive &prim : m_pending)
+    {
+        t_clut = m_clutSnapshots[prim.clut].data();
+        t_texVram = prim.fromSnapshot ? m_feedbackSnapshot.data() : nullptr;
+        DrawPrimitive(prim.batch);
+    }
+    t_band = 0;
+    t_bandCount = 1;
+    t_clut = nullptr;
+    t_texVram = nullptr;
+    _mm_setcsr(previousCsr);
+}
+
+void GSCpuBackend::DrainUnlocked()
+{
+    if (m_pending.empty())
+        return;
+    if (m_workers.empty())
+    {
+        for (uint32_t band = 1; band < m_bandCount; ++band)
+            m_workers.emplace_back([this, band]()
+                                   {
+                setHostThreadPriority(-1); // THREAD_PRIORITY_BELOW_NORMAL
+                uint64_t seen = 0;
+                for (;;)
+                {
+                    std::unique_lock<std::mutex> lock(m_poolMutex);
+                    m_poolWake.wait(lock, [&] { return m_poolStop || m_poolGeneration != seen; });
+                    if (m_poolStop)
+                        return;
+                    seen = m_poolGeneration;
+                    lock.unlock();
+                    DrawPendingBand(band);
+                    lock.lock();
+                    if (--m_poolRemaining == 0u)
+                        m_poolDone.notify_one();
+                } });
+    }
+    {
+        std::lock_guard<std::mutex> lock(m_poolMutex);
+        ++m_poolGeneration;
+        m_poolRemaining = m_bandCount - 1u;
+    }
+    m_poolWake.notify_all();
+    DrawPendingBand(0);
+    {
+        std::unique_lock<std::mutex> lock(m_poolMutex);
+        m_poolDone.wait(lock, [&] { return m_poolRemaining == 0u; });
+    }
+    m_pending.clear();
+    m_clutSnapshots.clear();
+    m_clutDirty = true;
+    m_writes.clear();
+    m_reads.clear();
+}
