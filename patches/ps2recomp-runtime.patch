 void GS::processImageData(const uint8_t *data, uint32_t sizeBytes)
 {
+    if (s_trxLog.open)
+    {
+        // PS2X_GS_TRXDUMP=3a80,38b2: append the raw bytes of the first upload to
+        // each listed dbp to xs_trx_<dbp>.bin in the working directory.
+        static const char *dumpList = std::getenv("PS2X_GS_TRXDUMP");
+        static std::set<uint32_t> dumped;
+        if (dumpList && s_trxLog.received == 0)
+        {
+            char key[16];
+            std::snprintf(key, sizeof(key), "%x", s_trxLog.dbp);
+            const std::string list = std::string(",") + dumpList + ",";
+            if (list.find(std::string(",") + key + ",") != std::string::npos && dumped.insert(s_trxLog.dbp).second)
+                s_trxLog.dumpFile = std::fopen((std::string("xs_trx_") + key + ".bin").c_str(), "wb");
+        }
+        if (s_trxLog.dumpFile)
+        {
+            std::fwrite(data, 1, sizeBytes, s_trxLog.dumpFile);
+            if (s_trxLog.received + sizeBytes >= s_trxLog.expected)
+            {
+                std::fclose(s_trxLog.dumpFile);
+                s_trxLog.dumpFile = nullptr;
+            }
+        }
+        s_trxLog.received += sizeBytes;
+    }
     if (m_backend)
         m_backend->UploadImage(data, sizeBytes);
 }
