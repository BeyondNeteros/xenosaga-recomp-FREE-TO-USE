+const VU1Interpreter::DecodedInstructionPair &VU1Interpreter::lazyDecodedPair(const uint8_t *vuCode, uint32_t pairIndex)
+{
+    if (m_pairEpoch[pairIndex] != m_decodeEpoch)
+    {
+        m_decodedCodeCache[pairIndex] = decodeInstructionPair(vuCode, pairIndex * 8u);
+        m_pairEpoch[pairIndex] = m_decodeEpoch;
+    }
+    return m_decodedCodeCache[pairIndex];
+}
+
+// Builds the schedule of the straight-line block starting at a pair, with the
+// dynamic model's rules (calculatePairReadyCycle / markPairWrites) applied to
+// cycle offsets from block entry. Registers not written earlier in the block
+// are assumed ready at entry; each such read becomes a live-in that
+// staticEntryOk checks, so a block only runs statically when this schedule
+// is exactly what the dynamic loop would produce. The block ends after a
+// branch's delay slot, after the pair following an E-bit, at a D/T-bit pair
+// or after 64 pairs.
+void VU1Interpreter::buildStaticBlock(StaticBlock &block, const uint8_t *vuCode, uint32_t codeSize, uint32_t startIndex)
+{
+    block = StaticBlock{};
+    block.epoch = m_decodeEpoch;
+
+    int vfRel[32][4];
+    int viRel[16];
+    int accRel[4];
+    for (auto &r : vfRel)
+        r[0] = r[1] = r[2] = r[3] = -1;
+    for (int &r : viRel)
+        r = -1;
+    for (int &r : accRel)
+        r = -1;
+    int fdivRel = -1;
+    int efuResRel = -1;
+    int efuEntriesMax = -1;
+    int efuIssues = 0;
+    bool kick = false;
+    int cur = 0;
+    int stopAfter = -1; // pair index after which the block ends
+
+    for (uint32_t i = 0; i < 64u; ++i)
+    {
+        const uint32_t index = startIndex + i;
+        if (index >= kMaxDecodedPairs || (index + 1u) * 8u > codeSize)
+            break;
+        const DecodedInstructionPair &d = lazyDecodedPair(vuCode, index);
+        if (d.upperUsage.reserved || d.lowerUsage.reserved)
+            break;
+
+        struct PendingLive
+        {
+            uint8_t kind, reg, lane;
+        };
+        PendingLive live[48];
+        int liveCount = 0;
+        int ready = cur;
+        for (const InstructionUsage *usage : {&d.upperUsage, &d.lowerUsage})
+        {
+            for (uint32_t r = 0; r < usage->vfReadCount; ++r)
+            {
+                const VfAccess &access = usage->vfRead[r];
+                if (access.reg == 0u)
+                    continue;
+                for (uint32_t c = 0; c < 4u; ++c)
+                {
+                    if ((access.lanes & laneForComponent(c)) == 0u)
+                        continue;
+                    if (vfRel[access.reg][c] >= 0)
+                        ready = std::max(ready, vfRel[access.reg][c]);
+                    else
+                        live[liveCount++] = {0, access.reg, static_cast<uint8_t>(c)};
+                }
+            }
+            for (uint32_t mask = usage->viRead & 0xFFFEu; mask != 0u; mask &= mask - 1u)
+            {
+                const uint32_t reg = static_cast<uint32_t>(__builtin_ctz(mask));
+                if (viRel[reg] >= 0)
+                    ready = std::max(ready, viRel[reg]);
+                else
+                    live[liveCount++] = {1, static_cast<uint8_t>(reg), 0};
+            }
+            for (uint32_t c = 0; c < 4u; ++c)
+            {
+                if ((usage->accRead & laneForComponent(c)) == 0u)
+                    continue;
+                if (accRel[c] >= 0)
+                    ready = std::max(ready, accRel[c]);
+                else
+                    live[liveCount++] = {2, 0, static_cast<uint8_t>(c)};
+            }
+        }
+
+        const InstructionUsage &lower = d.lowerUsage;
+        bool firstFdiv = false, firstEfuOp = false, firstEfuEntry = false;
+        if (lower.pipeline == PipelineFdiv || lower.waitQ)
+        {
+            if (fdivRel >= 0)
+                ready = std::max(ready, fdivRel);
+            else
+                firstFdiv = block.fdivFirst == 0xFFFFu;
+        }
+        if (lower.pipeline == PipelineEfu)
+        {
+            if (efuResRel >= 0)
+                ready = std::max(ready, efuResRel);
+            firstEfuOp = block.efuOpFirst == 0xFFFFu;
+        }
+        if (lower.waitP && efuEntriesMax >= 0)
+            ready = std::max(ready, efuEntriesMax);
+        if ((lower.waitP || (lower.pipeline == PipelineEfu && !lower.waitP)) && block.efuEntryFirst == 0xFFFFu)
+            firstEfuEntry = true;
+        if (lower.pipeline == PipelineXgkick)
+        {
+            if (kick)
+                return; // second kick: its stall depends on the packet size
+            kick = true;
+            block.hasXgkick = true;
+        }
+
+        if (ready > 0xFFF0)
+            return;
+        const uint16_t off = static_cast<uint16_t>(ready);
+        block.offsets.push_back(off);
+        for (int k = 0; k < liveCount; ++k)
+        {
+            bool merged = false;
+            for (StaticLane &existing : block.liveIns)
+                if (existing.kind == live[k].kind && existing.reg == live[k].reg && existing.offset == off)
+                {
+                    existing.lane |= static_cast<uint8_t>(1u << live[k].lane);
+                    merged = true;
+                    break;
+                }
+            if (!merged)
+                block.liveIns.push_back({live[k].kind, live[k].reg, static_cast<uint8_t>(1u << live[k].lane), off});
+        }
+        if (firstFdiv)
+            block.fdivFirst = off;
+        if (firstEfuOp)
+            block.efuOpFirst = off;
+        if (firstEfuEntry)
+            block.efuEntryFirst = off;
+
+        // markPairWrites at cycle `off`
+        const InstructionUsage &upper = d.upperUsage;
+        const auto markVf = [&](const VfAccess &write, int readyRel)
+        {
+            for (uint32_t c = 0; c < 4u; ++c)
+                if (write.lanes & laneForComponent(c))
+                    vfRel[write.reg][c] = readyRel;
+        };
+        if (lower.vfWrite.reg != 0u && d.suppressedLowerVf != lower.vfWrite.reg)
+            markVf(lower.vfWrite, ready + (lower.vfLatency != 0u ? lower.vfLatency : lower.latency));
+        if (upper.vfWrite.reg != 0u)
+            markVf(upper.vfWrite, ready + (upper.vfLatency != 0u ? upper.vfLatency : upper.latency));
+        if (const uint32_t viMask = lower.viWrite & 0xFFFEu)
+        {
+            const int readyRel = ready + (lower.viLatency != 0u ? lower.viLatency : lower.latency);
+            for (uint32_t mask = viMask; mask != 0u; mask &= mask - 1u)
+                viRel[__builtin_ctz(mask)] = readyRel;
+        }
+        for (uint32_t c = 0; c < 4u; ++c)
+            if (upper.accWrite & laneForComponent(c))
+                accRel[c] = ready + static_cast<int>(kAccForwardLatency);
+
+        // queueQ / queueP side effects on the scheduler
+        if (lower.pipeline == PipelineFdiv && !lower.waitQ)
+            fdivRel = ready + lower.latency;
+        if (lower.pipeline == PipelineEfu && !lower.waitP)
+        {
+            if (++efuIssues > 2)
+                return; // could overflow the two EFU slots
+            efuResRel = ready + (lower.latency > 0u ? lower.latency - 1 : 0);
+            efuEntriesMax = std::max(efuEntriesMax, ready + static_cast<int>(lower.latency));
+        }
+
+        {
+            const bool lowerNop = d.lower == 0x00000000u || d.lower == 0x8000033Cu;
+            const uint32_t upperOp = d.upper & 0x3Fu;
+            const uint32_t upperSpecial = (d.upper & 3u) | ((d.upper >> 4) & 0x7Cu);
+            const bool upperNop = upperOp >= 0x3Cu && (upperSpecial == 0x2Fu || upperSpecial == 0x30u) &&
+                                  !d.iBit && (d.upper & 0x78000000u) == 0u;
+            const bool viBackup = (lower.viWrite & 0xFFFEu) != 0u && lower.delaysNextBranchRead;
+            const bool generic = d.iBit || d.eBit || d.dBit || d.tBit || lower.pipeline == PipelineBranch ||
+                                 stopAfter >= 0 || (index + 2u) * 8u > codeSize;
+            // Bit 8: the pair needs execPairDirect's shadow / branch-VI handling
+            // but otherwise ends like a plain pair.
+            const bool full = d.upperVfShadowReg != 0u || viBackup;
+            block.plain.push_back(generic ? 0u
+                                          : static_cast<uint8_t>(1u | (upperNop ? 0u : 2u) | (lowerNop ? 0u : 4u) |
+                                                                 (full ? 8u : 0u)));
+        }
+        cur = ready + 1;
+        ++block.pairCount;
+        block.lastOffset = off;
+
+        if (stopAfter == static_cast<int>(i))
+            break;
+        if (stopAfter < 0)
+        {
+            if (lower.pipeline == PipelineBranch || d.eBit)
+                stopAfter = static_cast<int>(i) + 1; // include the delay slot
+            else if (d.dBit || d.tBit)
+                break;
+        }
+    }
+    if (stopAfter >= 0 && block.pairCount != static_cast<uint16_t>(stopAfter + 1))
+        return; // the delay slot was not available
+    if (block.pairCount < 2u)
+        return;
+
+    std::stable_sort(block.liveIns.begin(), block.liveIns.end(),
+                     [](const StaticLane &a, const StaticLane &b) { return a.offset < b.offset; });
+    for (uint32_t reg = 1; reg < 32u; ++reg)
+    {
+        FinalVf f{static_cast<uint8_t>(reg), 0u, {0u, 0u, 0u, 0u}};
+        for (uint32_t c = 0; c < 4u; ++c)
+            if (vfRel[reg][c] >= 0)
+            {
+                f.mask |= static_cast<uint8_t>(1u << c);
+                f.offset[c] = static_cast<uint16_t>(vfRel[reg][c]);
+                block.finalMax = std::max(block.finalMax, f.offset[c]);
+            }
+        if (f.mask != 0u)
+            block.finalVf.push_back(f);
+    }
+    for (uint32_t reg = 1; reg < 16u; ++reg)
+        if (viRel[reg] >= 0)
+            block.finalWrites.push_back({1, static_cast<uint8_t>(reg), 0, static_cast<uint16_t>(viRel[reg])});
+    for (uint32_t c = 0; c < 4u; ++c)
+        if (accRel[c] >= 0)
+            block.finalWrites.push_back({2, 0, static_cast<uint8_t>(c), static_cast<uint16_t>(accRel[c])});
+    for (const StaticLane &l : block.finalWrites)
+        block.finalMax = std::max(block.finalMax, l.offset);
+    block.usable = true;
+
+    // Native version: looked up by a hash of the start pair and the code.
+    uint64_t key = 1469598103934665603ull;
+    const auto mix = [&key](const void *data, size_t size)
+    {
+        const uint8_t *bytes = static_cast<const uint8_t *>(data);
+        for (size_t k = 0; k < size; ++k)
+            key = (key ^ bytes[k]) * 1099511628211ull;
+    };
+    const uint32_t header[2] = {startIndex, block.pairCount};
+    mix(header, sizeof(header));
+    mix(vuCode + startIndex * 8u, block.pairCount * 8u);
+    mix(block.plain.data(), block.plain.size());
+    block.key = key;
+    static const bool nativeBlocks = [] {
+        const char *env = std::getenv("PS2X_VU1_NATIVE");
+        return !(env && env[0] == '0');
+    }();
+    const auto found = compiledBlocks().find(key);
+    if (nativeBlocks && found != compiledBlocks().end())
+        block.compiled = found->second;
+    else
+        logStaticBlock(block, startIndex, vuCode);
+}
+
+bool VU1Interpreter::staticEntryOk(const StaticBlock &block) const
+{
+    const uint64_t entry = m_cycle;
+    for (const StaticLane &l : block.liveIns)
+    {
+        const uint64_t limit = entry + l.offset;
+        if (limit >= m_readyMax)
+            break; // sorted by offset: every later live-in is ready too
+        if (l.kind == 1)
+        {
+            if (m_viReady[l.reg] > limit)
+                return false;
+            continue;
+        }
+        const std::array<uint64_t, 4> &lanes = l.kind == 0 ? m_vfReady[l.reg] : m_accReady;
+        for (uint32_t c = 0; c < 4u; ++c)
+            if (((l.lane >> c) & 1u) && lanes[c] > limit)
+                return false;
+    }
+    if (block.fdivFirst != 0xFFFFu && m_fdiv.valid && m_fdiv.readyCycle > entry + block.fdivFirst)
+        return false;
+    if (block.efuOpFirst != 0xFFFFu && m_efuResourceReady > entry + block.efuOpFirst)
+        return false;
+    if (block.efuEntryFirst != 0xFFFFu)
+        for (const ScalarPipelineEntry &e : m_efu)
+            if (e.valid && e.readyCycle > entry + block.efuEntryFirst)
+                return false;
+    if (block.hasXgkick && m_xgkick.active)
+        return false;
+    return true;
+}
+
+// Runs a block on its precomputed schedule: same per-pair code and the same
+// per-cycle commits/XGKICK progress as the dynamic loop (cycle by cycle while
+// a kick is active; otherwise pending commits are applied at the next pair's
+// cycle, which only flags/FDIV could observe and they are ordered by their
+// own ready cycles).
+bool VU1Interpreter::runStaticBlock(const StaticBlock &block, uint32_t startIndex, uint32_t codeSize, uint8_t *vuData,
+                                    uint32_t dataSize, GS &gs, PS2Memory *memory)
+{
+    if (block.compiled)
+        return block.compiled(*this, block, startIndex, codeSize, vuData, dataSize, gs, memory);
+    const uint64_t entry = m_cycle;
+    bool ended = false;
+    for (uint32_t i = 0; i < block.pairCount; ++i)
+    {
+        if (i > 0u)
+        {
+            const uint64_t target = entry + block.offsets[i];
+            if (m_xgkick.active)
+                advanceTo(target);
+            else
+            {
+                m_cycle = target;
+                m_state.cycles = target;
+            }
+            if (m_cycle >= m_nextCommit)
+                commitReadyPipelines();
+        }
+        const DecodedInstructionPair &decoded = m_decodedCodeCache[startIndex + i];
+        if (const uint8_t plain = block.plain[i])
+        {
+            if (plain & 8u)
+            {
+                // Leaves the branch-VI backup it may have recorded in place.
+                execPairDirect(decoded, vuData, dataSize, gs, memory, false);
+            }
+            else
+            {
+                if (plain & 2u)
+                    execUpper(decoded.upper);
+                if (plain & 4u)
+                    execLower(decoded.lower, vuData, dataSize, gs, memory, decoded.upper);
+                m_viBranchBackupValid = false;
+            }
+            m_state.vf[0][0] = 0.0f;
+            m_state.vf[0][1] = 0.0f;
+            m_state.vf[0][2] = 0.0f;
+            m_state.vf[0][3] = 1.0f;
+            m_state.vi[0] = 0;
+            m_state.pc += 8u;
+            continue;
+        }
+        execPairDirect(decoded, vuData, dataSize, gs, memory, false);
+        ended = finishPair(decoded, codeSize);
+        if (ended && i + 1u != block.pairCount)
+            break; // cannot happen with the block rules; keep the state sane
+    }
+    return finishStaticBlock(block, entry, ended);
+}
+
+// Applies the block's final register readiness and the cycle after its last
+// pair (shared with generated native blocks).
+bool VU1Interpreter::finishStaticBlock(const StaticBlock &block, uint64_t entry, bool ended)
+{
+    const __m256i base = _mm256_set1_epi64x(static_cast<long long>(entry));
+    for (const FinalVf &f : block.finalVf)
+    {
+        const __m256i offs = _mm256_cvtepu16_epi64(_mm_loadl_epi64(reinterpret_cast<const __m128i *>(f.offset)));
+        const __m256i mask = _mm256_cmpgt_epi64(
+            _mm256_and_si256(_mm256_set1_epi64x(f.mask), _mm256_setr_epi64x(1, 2, 4, 8)), _mm256_setzero_si256());
+        // Load/blend/store: vpmaskmovq stores are microcoded and slow on some CPUs.
+        __m256i *lanes = reinterpret_cast<__m256i *>(m_vfReady[f.reg].data());
+        _mm256_storeu_si256(lanes, _mm256_blendv_epi8(_mm256_loadu_si256(lanes), _mm256_add_epi64(base, offs), mask));
+    }
+    for (const StaticLane &l : block.finalWrites)
+    {
+        const uint64_t readyCycle = entry + l.offset;
+        if (l.kind == 1)
+            m_viReady[l.reg] = readyCycle;
+        else
+            m_accReady[l.lane] = readyCycle;
+    }
+    m_readyMax = std::max(m_readyMax, entry + block.finalMax);
+    advanceOneCycle();
+    return ended;
+}
