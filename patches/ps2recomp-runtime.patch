+    Rectangle computeDestination(float srcW, float srcH)
+    {
+        const float screenW = static_cast<float>(GetScreenWidth());
+        const float screenH = static_cast<float>(GetScreenHeight());
+        if (g_hostSettings.aspect == "stretch")
+            return Rectangle{0.0f, 0.0f, screenW, screenH};
+        const float aspect = targetAspect(srcW, srcH);
+        float dstH = std::min(screenH, screenW / aspect);
+        if (g_hostSettings.integerScale && dstH >= srcH)
+            dstH = std::floor(dstH / srcH) * srcH;
+        const float dstW = dstH * aspect;
+        return Rectangle{std::floor((screenW - dstW) * 0.5f), std::floor((screenH - dstH) * 0.5f), dstW, dstH};
