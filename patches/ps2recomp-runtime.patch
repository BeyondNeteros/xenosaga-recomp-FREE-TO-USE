+        bool needColumns = false; // some row reads its own row
+        for (int y = drawY0; y <= drawY1; ++y)
+        {
+            const float ty = (static_cast<float>(y - y0) + 0.5f) / spriteH;
+            int lo, hi;
+            spriteTexelRange(state, v0f + (v1f - v0f) * ty, texH, lo, hi);
+            if (lo < y || hi >= texH)
+                return false;
+            needColumns |= lo == y;
+        }
+        for (int x = drawX0; x <= drawX1; ++x)
+        {
+            const float tx = (static_cast<float>(x - x0) + 0.5f) / spriteW;
+            int lo, hi;
+            spriteTexelRange(state, u0f + (u1f - u0f) * tx, texW, lo, hi);
+            if (lo < 0 || hi >= texW || (needColumns && lo < x))
+                return false;
+        }
+        return true;
+    }
+}
