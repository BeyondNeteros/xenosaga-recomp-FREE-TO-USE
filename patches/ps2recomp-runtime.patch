+    // Texel coordinates a sprite pixel may read with nonzero weight along one
+    // axis (same maths as DrawSprite + SampleTexture), lowest first.
+    void spriteTexelRange(const GSDrawState &state, float texF, int texSize, int &lo, int &hi)
+    {
+        float coord;
+        if (state.prim.fst)
+        {
+            const int fixed = clampInt(static_cast<int>((texF * 16.0f) + 0.5f), 0, 0xFFFF);
+            coord = static_cast<float>(static_cast<uint16_t>(fixed)) / 16.0f;
+        }
+        else
+        {
+            coord = (texF / static_cast<float>(texSize)) * (1.0f / fabsQ(1.0f)) * static_cast<float>(texSize);
+        }
+        if (!state.linearFilter)
+        {
+            lo = hi = static_cast<int>(coord);
+            return;
+        }
+        const float sample = coord - 0.5f;
