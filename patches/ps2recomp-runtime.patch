+ivec4 sampleScaled(float fu, float fv)
+{
+    float SX = float(s10.x), SY = float(s10.y);
+    if (s0.w == 0)
+        return ivec4(texelScaled(int(floor(fu * SX)), int(floor(fv * SY))));
+    float su = fu * SX - 0.5, sv = fv * SY - 0.5;
+    int u0 = int(floor(su)), v0 = int(floor(sv));
+    float fx = su - float(u0), fy = sv - float(v0);
+    vec4 c00 = vec4(texelScaled(u0, v0)), c10 = vec4(texelScaled(u0 + 1, v0));
+    vec4 c01 = vec4(texelScaled(u0, v0 + 1)), c11 = vec4(texelScaled(u0 + 1, v0 + 1));
+    vec4 top = c00 + (c10 - c00) * fx;
+    vec4 bottom = c01 + (c11 - c01) * fx;
+    return clamp(ivec4(floor(top + (bottom - top) * fy + 0.5)), ivec4(0), ivec4(255));
