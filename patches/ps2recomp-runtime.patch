+            if (std::getenv("GS_REPLAY_GL") || std::getenv("GS_REPLAY_COMPARE"))
+            {
+                compareBuffer(vram, vramEnd.data(), 0x70u, std::getenv("GS_REPLAY_COMPARE"));
+                compareBuffer(vram, vramEnd.data(), 0xE0u, std::getenv("GS_REPLAY_COMPARE"));
+            }
+            if (const char *out = std::getenv("GS_REPLAY_DUMP"))
+            {
+                std::ofstream o(out, std::ios::binary);
+                o.write(reinterpret_cast<const char *>(vram), vramSize);
+            }
+        }
+        else if (hash != firstHash)
+            std::printf("pass %d: VRAM hash differs from pass 0 (nondeterministic?)\n", pass);
+    }
+    const int timed = repeat > 1 ? repeat - 1 : 1;
+    std::printf("per pass: %.2f ms  (%.2f ms per frame)\n", totalMs / timed, totalMs / timed / (frames ? frames : 1));
+    std::printf("vram hash: %016llx\n", static_cast<unsigned long long>(firstHash));
+
+#ifdef _WIN32
+    if (profThread.joinable())
+    {
+        g_profStop = true;
+        profThread.join();
+        std::map<uint64_t, unsigned> counts;
+        for (uint64_t a : samples)
+            ++counts[a];
+        const uint64_t exeBase = reinterpret_cast<uint64_t>(GetModuleHandleW(nullptr));
+        if (FILE *f = std::fopen("gs_replay_samples.txt", "w"))
+        {
+            for (const auto &kv : counts)
+                if (kv.first >= exeBase)
+                    std::fprintf(f, "%llx %u\n", static_cast<unsigned long long>(kv.first - exeBase), kv.second);
+            std::fclose(f);
+        }
+        // Samples outside the exe, by module (GL driver, system DLLs).
+        std::map<std::string, unsigned> modules;
+        for (const auto &kv : counts)
+        {
+            HMODULE mod = nullptr;
+            char name[MAX_PATH] = "?";
+            if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                                   reinterpret_cast<LPCSTR>(kv.first), &mod) && mod)
+                GetModuleFileNameA(mod, name, MAX_PATH);
+            modules[name] += kv.second;
+        }
+        for (const auto &kv : modules)
+            std::printf("samples in %s: %u\n", kv.first.c_str(), kv.second);
+    }
+#endif
+    return 0;
+}
diff --git a/ps2xRuntime/tools/ipu_test.cpp b/ps2xRuntime/tools/ipu_test.cpp
new file mode 100644
index 0000000..feea450
--- /dev/null
+++ b/ps2xRuntime/tools/ipu_test.cpp
@@ -0,0 +1,118 @@
+// Decodes an IPU movie (.ipu: "ipum" header + IDEC frames) through Ps2Ipu the
+// way Xenosaga's xglMoviePlay drives the IPU, and writes some frames as BMP.
+//
+//   ipu_test movie.ipu out_prefix [frames-to-write...]
+//
+// Prints per-frame status (SCD/ECD, macroblocks). The movie and the frames
+// are game data: never commit them.
+#include "runtime/ps2_ipu.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <set>
+#include <string>
+#include <vector>
+
+static void writeBmp(const std::string &path, const std::vector<uint8_t> &mbData, int width, int height)
+{
+    // Macroblocks are 16x16 RGBA in raster order of macroblocks.
+    const int stride = width * 3;
+    std::vector<uint8_t> img(static_cast<size_t>(stride) * height);
+    const int mbw = width / 16;
+    for (size_t mb = 0; mb * 1024 < mbData.size(); ++mb)
+    {
+        const int mx = static_cast<int>(mb % mbw), my = static_cast<int>(mb / mbw);
+        if (my * 16 >= height)
+            break;
+        for (int y = 0; y < 16; ++y)
+            for (int x = 0; x < 16; ++x)
+            {
+                const uint8_t *p = &mbData[mb * 1024 + (y * 16 + x) * 4];
+                const int py = height - 1 - (my * 16 + y), px = mx * 16 + x;
+                uint8_t *d = &img[py * stride + px * 3];
+                d[0] = p[2];
+                d[1] = p[1];
+                d[2] = p[0];
+            }
+    }
+    std::ofstream f(path, std::ios::binary);
+    const uint32_t fileSize = 54 + static_cast<uint32_t>(img.size());
+    uint8_t h[54] = {'B', 'M'};
+    std::memcpy(h + 2, &fileSize, 4);
+    h[10] = 54;
+    h[14] = 40;
+    std::memcpy(h + 18, &width, 4);
+    std::memcpy(h + 22, &height, 4);
+    h[26] = 1;
+    h[28] = 24;
+    f.write(reinterpret_cast<char *>(h), 54);
+    f.write(reinterpret_cast<const char *>(img.data()), static_cast<std::streamsize>(img.size()));
+}
+
+int main(int argc, char **argv)
+{
+    if (argc < 3)
+    {
+        std::fprintf(stderr, "usage: ipu_test movie.ipu out_prefix [frames...]\n");
+        return 1;
+    }
+    std::ifstream in(argv[1], std::ios::binary);
+    std::vector<uint8_t> data((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+    if (data.size() < 16 || std::memcmp(data.data(), "ipum", 4) != 0)
+    {
+        std::fprintf(stderr, "not an IPU movie\n");
+        return 1;
+    }
+    uint16_t width, height;
+    uint32_t frames;
+    std::memcpy(&width, &data[8], 2);
+    std::memcpy(&height, &data[10], 2);
+    std::memcpy(&frames, &data[12], 4);
+    std::printf("%ux%u, %u frames\n", width, height, frames);
+    std::set<int> wanted;
+    for (int i = 3; i < argc; ++i)
+        wanted.insert(std::atoi(argv[i]));
+    if (wanted.empty())
+        wanted = {0, 1, static_cast<int>(frames / 2), static_cast<int>(frames - 1)};
+
+    size_t pos = 16;
+    Ps2Ipu ipu([&](uint8_t q[16]) {
+        if (pos >= data.size())
+            return false;
+        std::memset(q, 0, 16);
+        std::memcpy(q, &data[pos], std::min<size_t>(16, data.size() - pos));
+        pos += 16;
+        return true;
+    });
+    ipu.writeCtrl(0x40000000u);
+    ipu.writeCmd(0x90000000u); // SETTH 0, 0
+    ipu.writeCmd(0x00000000u); // BCLR
+    int bad = 0;
+    for (uint32_t frame = 0; frame < frames; ++frame)
+    {
+        ipu.writeCmd(0x40000000u); // FDEC 0
+        const uint32_t header = ipu.readCmd() >> 24;
+        ipu.writeCmd(0x40000008u); // FDEC 8
+        ipu.writeCtrl((header & 0xFBu) << 16);
+        ipu.writeCmd((((header & 4u) >> 2) << 24) | 0x10000000u | 0x10000u);
+        const uint32_t ctrl = ipu.readCtrl();
+        std::vector<uint8_t> out;
+        uint8_t q[16];
+        while (ipu.popOutput(q))
+            out.insert(out.end(), q, q + 16);
+        const size_t mbs = out.size() / 1024;
+        ipu.writeCmd(0x40000020u); // FDEC 32: skip the start code
+        const bool okFrame = (ctrl & 0x8000u) && !(ctrl & 0x4000u) && mbs == static_cast<size_t>(width / 16) * (height / 16);
+        if (!okFrame)
+            ++bad;
+        if (frame < 3 || !okFrame || wanted.count(static_cast<int>(frame)))
+            std::printf("frame %u header 0x%02x ctrl 0x%08x macroblocks %zu%s\n", frame, header, ctrl, mbs,
+                        okFrame ? "" : "  <-- BAD");
+        if (wanted.count(static_cast<int>(frame)))
+            writeBmp(std::string(argv[2]) + "_" + std::to_string(frame) + ".bmp", out, width, height);
+    }
+    std::printf("%d bad frames of %u, input used %zu of %zu bytes\n", bad, frames, pos, data.size());
+    return bad ? 2 : 0;
+}
diff --git a/ps2xRuntime/tools/vu0_test.cpp b/ps2xRuntime/tools/vu0_test.cpp
new file mode 100644
index 0000000..94c29a5
--- /dev/null
+++ b/ps2xRuntime/tools/vu0_test.cpp
@@ -0,0 +1,65 @@
+// Runs a VU0 microprogram from a raw microcode file through the runtime's VU
+// interpreter with vf28-31 set to a test matrix, and prints vf28-31 after.
+// Used to check timing-sensitive programs (e.g. Xenosaga's matrix inverse)
+// against a reference result.
+//
+//   vu0_test microcode.bin <start pc hex> m00 m01 ... m33   (16 floats, row major)
+
+#include "ps2_runtime.h"
+#include "runtime/ps2_memory.h"
+#include "runtime/ps2_vu1.h"
+#include "runtime/gs/gs_frontend.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <vector>
+
+int main(int argc, char **argv)
+{
+    // Register mode: vu0_test code.bin pc vf4=x,y,z,w [vfN=...]  -> prints vf1-vf4.
+    const bool regMode = argc > 3 && std::strncmp(argv[3], "vf", 2) == 0;
+    if (argc < 3 + (regMode ? 1 : 16))
+    {
+        std::fprintf(stderr, "usage: %s microcode.bin startpc m00..m33\n", argv[0]);
+        return 1;
+    }
+    std::ifstream in(argv[1], std::ios::binary);
+    std::vector<uint8_t> code((std::istreambuf_iterator<char>(in)), {});
+    code.resize(PS2_VU0_CODE_SIZE, 0);
+    std::vector<uint8_t> data(PS2_VU0_DATA_SIZE, 0);
+
+    PS2Memory memory;
+    if (!memory.initialize())
+        return 1;
+    GS gs;
+    gs.init(memory.getGSVRAM(), static_cast<uint32_t>(PS2_GS_VRAM_SIZE), &memory.gs());
+
+    VU1Interpreter vu(VU1Interpreter::Unit::VU0);
+    VU1State &s = vu.state();
+    if (regMode)
+    {
+        for (int a = 3; a < argc; ++a)
+        {
+            int reg = 0;
+            float v[4] = {0, 0, 0, 0};
+            if (std::sscanf(argv[a], "vf%d=%f,%f,%f,%f", &reg, &v[0], &v[1], &v[2], &v[3]) >= 2 && reg > 0 && reg < 32)
+                std::memcpy(s.vf[reg], v, sizeof(v));
+        }
+    }
+    else
+    {
+        for (int r = 0; r < 4; ++r)
+            for (int c = 0; c < 4; ++c)
+                s.vf[28 + r][c] = static_cast<float>(std::atof(argv[3 + r * 4 + c]));
+    }
+    s.vf[0][3] = 1.0f;
+    vu.execute(code.data(), PS2_VU0_CODE_SIZE, data.data(), PS2_VU0_DATA_SIZE, gs, nullptr,
+               static_cast<uint32_t>(std::strtoul(argv[2], nullptr, 16)), 0, 0, 4096);
+    const int first = regMode ? 1 : 28;
+    for (int r = 0; r < 4; ++r)
+        std::printf("%g %g %g %g\n", s.vf[first + r][0], s.vf[first + r][1], s.vf[first + r][2], s.vf[first + r][3]);
+    std::printf("cycles %llu\n", static_cast<unsigned long long>(s.cycles));
+    return 0;
+}
diff --git a/ps2xRuntime/tools/vu1_replay.cpp b/ps2xRuntime/tools/vu1_replay.cpp
new file mode 100644
index 0000000..1a6e614
--- /dev/null
+++ b/ps2xRuntime/tools/vu1_replay.cpp
@@ -0,0 +1,410 @@
+// Replays VU1 calls recorded with PS2X_VU_CAPTURE=1 (vu1_capture.bin) through
+// the runtime's VU1 interpreter, for profiling and for checking that
+// optimizations don't change results.
+//
+//   vu1_replay vu1_capture.bin [repeat] [--dump-out out.bin]
+
+#include "ps2_runtime.h"
+#include "runtime/ps2_memory.h"
+#include "runtime/ps2_vu1.h"
+#include "runtime/ps2_vu1_fastops.h"
+#include "runtime/gs/gs_frontend.h"
+#include "runtime/gs/ps2_gif_arbiter.h"
+
+#include <chrono>
+#include <cstdlib>
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <string>
+#include <vector>
+
+namespace
+{
+    struct Record
+    {
+        uint32_t kind, startPC, top, itop;
+        VU1State state;
+        std::vector<uint8_t> code, data;
+    };
+
+    uint64_t fnv1a(const uint8_t *p, size_t n, uint64_t h = 1469598103934665603ull)
+    {
+        for (size_t i = 0; i < n; ++i)
+            h = (h ^ p[i]) * 1099511628211ull;
+        return h;
+    }
+}
+
+#ifdef _WIN32
+#include <windows.h>
+#include <atomic>
+#include <map>
+#include <thread>
+namespace
+{
+    // VU_REPLAY_PROFILE=1: sample the main thread's instruction pointer every
+    // ~1 ms and write the raw addresses to vu1_replay_samples.txt (resolve them
+    // with addr2line -f -C -e vu1_replay.exe).
+    std::atomic<bool> g_profStop{false};
+    std::thread startProfiler(HANDLE target, std::vector<uint64_t> &samples)
+    {
+        return std::thread([target, &samples] {
+            while (!g_profStop.load())
+            {
+                if (SuspendThread(target) != static_cast<DWORD>(-1))
+                {
+                    CONTEXT ctx{};
+                    ctx.ContextFlags = CONTEXT_CONTROL;
+                    if (GetThreadContext(target, &ctx))
+                        samples.push_back(ctx.Rip);
+                    ResumeThread(target);
+                }
+                Sleep(1);
+            }
+        });
+    }
+}
+#endif
+
+int main(int argc, char **argv)
+{
+#ifdef _WIN32
+    std::vector<uint64_t> profSamples;
+    std::thread profThread;
+    HANDLE mainThread = nullptr;
+    if (std::getenv("VU_REPLAY_PROFILE"))
+    {
+        DuplicateHandle(GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(), &mainThread, 0, FALSE,
+                        DUPLICATE_SAME_ACCESS);
+        profSamples.reserve(1 << 20);
+        timeBeginPeriod(1);
+        profThread = startProfiler(mainThread, profSamples);
+    }
+    struct ProfDump
+    {
+        std::thread &t;
+        std::vector<uint64_t> &s;
+        ~ProfDump()
+        {
+            if (!t.joinable())
+                return;
+            g_profStop = true;
+            t.join();
+            std::map<uint64_t, unsigned> counts;
+            for (uint64_t a : s)
+                ++counts[a];
+            // Offsets are relative to the exe; samples in other modules are
+            // summed per DLL into vu1_replay_modules.txt.
+            const uint64_t exeBase = reinterpret_cast<uint64_t>(GetModuleHandleW(nullptr));
+            std::map<std::string, unsigned> modules;
+            if (FILE *f = std::fopen("vu1_replay_samples.txt", "w"))
+            {
+                for (const auto &kv : counts)
+                {
+                    HMODULE mod = nullptr;
+                    GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                                       reinterpret_cast<LPCSTR>(kv.first), &mod);
+                    if (reinterpret_cast<uint64_t>(mod) == exeBase)
+                    {
+                        std::fprintf(f, "%llx %u\n", static_cast<unsigned long long>(kv.first - exeBase), kv.second);
+                        continue;
+                    }
+                    char name[MAX_PATH] = "?";
+                    if (mod)
+                        GetModuleFileNameA(mod, name, MAX_PATH);
+                    modules[name] += kv.second;
+                }
+                std::fclose(f);
+            }
+            if (FILE *f = std::fopen("vu1_replay_modules.txt", "w"))
+            {
+                for (const auto &kv : modules)
+                    std::fprintf(f, "%u %s\n", kv.second, kv.first.c_str());
+                std::fclose(f);
+            }
+        }
+    } profDump{profThread, profSamples};
+#endif
+    if (argc < 2)
+    {
+        std::fprintf(stderr, "usage: %s vu1_capture.bin [repeat]\n", argv[0]);
+        return 1;
+    }
+    const int repeat = argc > 2 ? std::atoi(argv[2]) : 20;
+
+    std::ifstream in(argv[1], std::ios::binary);
+    uint32_t header[4];
+    in.read(reinterpret_cast<char *>(header), sizeof(header));
+    if (!in || header[0] != 0x31555658u || header[2] != sizeof(VU1State))
+    {
+        std::fprintf(stderr, "bad capture (state size %u, expected %zu)\n", header[2], sizeof(VU1State));
+        return 1;
+    }
+    std::vector<Record> records;
+    for (;;)
+    {
+        Record r;
+        uint32_t rec[4];
+        if (!in.read(reinterpret_cast<char *>(rec), sizeof(rec)))
+            break;
+        r.kind = rec[0]; r.startPC = rec[1]; r.top = rec[2]; r.itop = rec[3];
+        in.read(reinterpret_cast<char *>(&r.state), sizeof(VU1State));
+        r.code.resize(PS2_VU1_CODE_SIZE);
+        r.data.resize(PS2_VU1_DATA_SIZE);
+        in.read(reinterpret_cast<char *>(r.code.data()), PS2_VU1_CODE_SIZE);
+        in.read(reinterpret_cast<char *>(r.data.data()), PS2_VU1_DATA_SIZE);
+        if (!in)
+            break;
+        records.push_back(std::move(r));
+    }
+    std::printf("loaded %zu VU1 calls\n", records.size());
+
+    PS2Memory memory;
+    if (!memory.initialize())
+        return 1;
+    GS gs;
+    gs.init(memory.getGSVRAM(), static_cast<uint32_t>(PS2_GS_VRAM_SIZE), &memory.gs());
+    GifArbiter arbiter;
+    uint64_t gifBytes = 0, gifPackets = 0;
+    std::ofstream gifDump;
+    if (const char *path = std::getenv("VU_REPLAY_GIFDUMP"))
+        gifDump.open(path, std::ios::binary);
+    arbiter.setProcessPacketFn([&](const uint8_t *d, uint32_t size) {
+        if (gifDump.is_open())
+        {
+            gifDump.write(reinterpret_cast<const char *>(&size), 4);
+            gifDump.write(reinterpret_cast<const char *>(d), size);
+        }
+        gifBytes += size;
+        ++gifPackets;
+        static const bool noGs = std::getenv("VU_REPLAY_NOGS") != nullptr; // time VU1 alone
+        if (!noGs)
+            gs.processGIFPacket(d, size);
+    });
+    memory.setGifArbiter(&arbiter);
+
+    VU1Interpreter vu(VU1Interpreter::Unit::VU1);
+    vu.reset();
+
+    uint64_t checksum = 0;
+    double totalNs = 0;
+    uint64_t totalCycles = 0;
+    const bool forceInvalidate = std::getenv("VU_REPLAY_INVALIDATE") != nullptr;
+    for (int pass = 0; pass < repeat; ++pass)
+    {
+        gifBytes = gifPackets = 0;
+        uint64_t cycles = 0;
+        double callNs = 0;
+        const auto t0 = std::chrono::steady_clock::now();
+        for (const Record &r : records)
+        {
+            if (std::memcmp(memory.getVU1Code(), r.code.data(), PS2_VU1_CODE_SIZE) != 0)
+            {
+                std::memcpy(memory.getVU1Code(), r.code.data(), PS2_VU1_CODE_SIZE);
+                memory.markVU1CodeModified();
+            }
+            std::memcpy(memory.getVU1Data(), r.data.data(), PS2_VU1_DATA_SIZE);
+            const uint64_t before = vu.state().cycles; // interpreter's running cycle count
+            vu.state() = r.state;
+            vu.state().cycles = before;
+            if (forceInvalidate)
+                memory.markVU1CodeModified(); // the game re-uploads microcode (MPG) before its calls
+            const auto c0 = std::chrono::steady_clock::now();
+            if (r.kind == 0)
+                vu.execute(memory.getVU1Code(), PS2_VU1_CODE_SIZE, memory.getVU1Data(), PS2_VU1_DATA_SIZE,
+                           gs, &memory, r.startPC, r.top, r.itop, 65536);
+            else
+                vu.resume(memory.getVU1Code(), PS2_VU1_CODE_SIZE, memory.getVU1Data(), PS2_VU1_DATA_SIZE,
+                          gs, &memory, r.top, r.itop, 65536);
+            arbiter.drain();
+            callNs += std::chrono::duration<double, std::nano>(std::chrono::steady_clock::now() - c0).count();
+            cycles += vu.state().cycles - before;
+            if (pass == 0)
+            {
+                checksum = fnv1a(memory.getVU1Data(), PS2_VU1_DATA_SIZE, checksum);
+                checksum = fnv1a(reinterpret_cast<const uint8_t *>(vu.state().vf), sizeof(vu.state().vf), checksum);
+                checksum = fnv1a(reinterpret_cast<const uint8_t *>(vu.state().vi), sizeof(vu.state().vi), checksum);
+                const uint32_t flags[3] = {vu.state().mac, vu.state().status, vu.state().clip};
+                checksum = fnv1a(reinterpret_cast<const uint8_t *>(flags), sizeof(flags), checksum);
+            }
+        }
+        const double ns = callNs; (void)t0;
+        if (pass > 0) // first pass warms caches
+        {
+            totalNs += ns;
+            totalCycles += cycles;
+        }
+    }
+    if (std::getenv("VU_REPLAY_DETAIL"))
+    {
+        for (size_t i = 0; i < records.size(); ++i)
+        {
+            const Record &r = records[i];
+            std::memcpy(memory.getVU1Code(), r.code.data(), PS2_VU1_CODE_SIZE);
+            memory.markVU1CodeModified();
+            std::memcpy(memory.getVU1Data(), r.data.data(), PS2_VU1_DATA_SIZE);
+            vu.state() = r.state;
+            gifBytes = 0;
+            if (r.kind == 0)
+                vu.execute(memory.getVU1Code(), PS2_VU1_CODE_SIZE, memory.getVU1Data(), PS2_VU1_DATA_SIZE,
+                           gs, &memory, r.startPC, r.top, r.itop, 65536);
+            else
+                vu.resume(memory.getVU1Code(), PS2_VU1_CODE_SIZE, memory.getVU1Data(), PS2_VU1_DATA_SIZE,
+                          gs, &memory, r.top, r.itop, 65536);
+            arbiter.drain();
+            const VU1State &st = vu.state();
+            std::printf("call %3zu kind=%u start=0x%04x end_pc=0x%04x cycles=%6llu ebit=%d D=%d T=%d gif=%llu\n", i, r.kind,
+                        r.startPC, st.pc, (unsigned long long)st.cycles, st.ebit, st.stoppedByD, st.stoppedByT,
+                        (unsigned long long)gifBytes);
+        }
+    }
+    // VU_REPLAY_NATIVE_CMP=1: run every call with native programs
+    // (port/tools/vu1prog.py) and with the interpreter alone, and report the
+    // calls whose results differ (VU memory, registers, flags, pc, GIF).
+    if (std::getenv("VU_REPLAY_NATIVE_CMP"))
+    {
+        std::vector<uint8_t> gifBuf;
+        arbiter.setProcessPacketFn([&](const uint8_t *d, uint32_t size) { gifBuf.insert(gifBuf.end(), d, d + size); });
+        struct Result
+        {
+            std::vector<uint8_t> data, gif;
+            VU1State st;
+        };
+        auto runOne = [&](const Record &r, bool native, Result &out) {
+            vu1native::setEnabled(native);
+            std::memcpy(memory.getVU1Code(), r.code.data(), PS2_VU1_CODE_SIZE);
+            memory.markVU1CodeModified();
+            std::memcpy(memory.getVU1Data(), r.data.data(), PS2_VU1_DATA_SIZE);
+            vu.reset(); // same hidden state (working CLIP) for both runs
+            vu.state() = r.state;
+            gifBuf.clear();
+            if (r.kind == 0)
+                vu.execute(memory.getVU1Code(), PS2_VU1_CODE_SIZE, memory.getVU1Data(), PS2_VU1_DATA_SIZE,
+                           gs, &memory, r.startPC, r.top, r.itop, 65536);
+            else
+                vu.resume(memory.getVU1Code(), PS2_VU1_CODE_SIZE, memory.getVU1Data(), PS2_VU1_DATA_SIZE,
+                          gs, &memory, r.top, r.itop, 65536);
+            arbiter.drain();
+            out.data.assign(memory.getVU1Data(), memory.getVU1Data() + PS2_VU1_DATA_SIZE);
+            out.gif = gifBuf;
+            out.st = vu.state();
+        };
+        size_t bad = 0;
+        for (size_t i = 0; i < records.size(); ++i)
+        {
+            Result a, b;
+            runOne(records[i], true, a);
+            runOne(records[i], false, b);
+            std::string why;
+            char tmp[160];
+            for (size_t q = 0; q < PS2_VU1_DATA_SIZE / 16 && why.size() < 300; ++q)
+                if (std::memcmp(&a.data[q * 16], &b.data[q * 16], 16))
+                {
+                    std::snprintf(tmp, sizeof(tmp), " mem[%zu]", q);
+                    why += tmp;
+                }
+            for (int k = 0; k < 32; ++k)
+                if (std::memcmp(a.st.vf[k], b.st.vf[k], 16))
+                {
+                    std::snprintf(tmp, sizeof(tmp), " vf%d(%g %g %g %g / %g %g %g %g)", k, a.st.vf[k][0], a.st.vf[k][1],
+                                  a.st.vf[k][2], a.st.vf[k][3], b.st.vf[k][0], b.st.vf[k][1], b.st.vf[k][2], b.st.vf[k][3]);
+                    why += tmp;
+                }
+            for (int k = 0; k < 16; ++k)
+                if (a.st.vi[k] != b.st.vi[k])
+                {
+                    std::snprintf(tmp, sizeof(tmp), " vi%d(%d/%d)", k, a.st.vi[k], b.st.vi[k]);
+                    why += tmp;
+                }
+            if (std::memcmp(a.st.acc, b.st.acc, 16))
+                why += " acc";
+            const uint32_t fa[7] = {a.st.mac, a.st.status, a.st.clip, a.st.pc, 0, 0, 0};
+            const uint32_t fb[7] = {b.st.mac, b.st.status, b.st.clip, b.st.pc, 0, 0, 0};
+            const char *names[4] = {"mac", "status", "clip", "pc"};
+            for (int k = 0; k < 4; ++k)
+                if (fa[k] != fb[k])
+                {
+                    std::snprintf(tmp, sizeof(tmp), " %s(%x/%x)", names[k], fa[k], fb[k]);
+                    why += tmp;
+                }
+            if (std::memcmp(&a.st.q, &b.st.q, 4) || std::memcmp(&a.st.p, &b.st.p, 4) || std::memcmp(&a.st.i, &b.st.i, 4))
+                why += " q/p/i";
+            if (a.gif != b.gif)
+            {
+                std::snprintf(tmp, sizeof(tmp), " gif(%zu/%zu bytes)", a.gif.size(), b.gif.size());
+                why += tmp;
+            }
+            if (!why.empty())
+            {
+                if (bad < 10)
+                    std::printf("call %zu kind=%u pc=0x%04x differs:%s\n", i, records[i].kind,
+                                records[i].kind ? records[i].state.pc : records[i].startPC, why.c_str());
+                ++bad;
+            }
+        }
+        std::printf("native compare: %zu of %zu calls differ\n", bad, records.size());
+        return bad != 0;
+    }
+    // VU_REPLAY_STALE=1: would call i give the same result if it started from
+    // call i-1's registers (its own memory and pc)? Tests whether calls depend
+    // on the registers the previous call left behind (parallel VU1 study).
+    if (std::getenv("VU_REPLAY_STALE"))
+    {
+        uint64_t gifHash = 0;
+        arbiter.setProcessPacketFn([&](const uint8_t *d, uint32_t size) { gifHash = fnv1a(d, size, gifHash ^ size); });
+        auto runOne = [&](const Record &r, const VU1State &start, uint64_t &outHash) {
+            std::memcpy(memory.getVU1Code(), r.code.data(), PS2_VU1_CODE_SIZE);
+            memory.markVU1CodeModified();
+            std::memcpy(memory.getVU1Data(), r.data.data(), PS2_VU1_DATA_SIZE);
+            vu.state() = start;
+            gifHash = 0;
+            if (r.kind == 0)
+                vu.execute(memory.getVU1Code(), PS2_VU1_CODE_SIZE, memory.getVU1Data(), PS2_VU1_DATA_SIZE,
+                           gs, &memory, r.startPC, r.top, r.itop, 65536);
+            else
+                vu.resume(memory.getVU1Code(), PS2_VU1_CODE_SIZE, memory.getVU1Data(), PS2_VU1_DATA_SIZE,
+                          gs, &memory, r.top, r.itop, 65536);
+            arbiter.drain();
+            outHash = fnv1a(memory.getVU1Data(), PS2_VU1_DATA_SIZE, gifHash);
+        };
+        size_t same = 0, differ = 0, regsChanged = 0;
+        for (size_t i = 1; i < records.size(); ++i)
+        {
+            const Record &r = records[i];
+            uint64_t good = 0, stale = 0;
+            runOne(r, r.state, good);
+            VU1State s = records[i - 1].state;
+            s.pc = r.state.pc;
+            s.top = r.state.top;
+            s.itop = r.state.itop;
+            s.cycles = r.state.cycles;
+            s.ebit = r.state.ebit;
+            s.branchPending = r.state.branchPending;
+            s.branchTarget = r.state.branchTarget;
+            s.branchDelay = r.state.branchDelay;
+            if (std::memcmp(s.vf, r.state.vf, sizeof(s.vf)) || std::memcmp(s.vi, r.state.vi, sizeof(s.vi)))
+                ++regsChanged;
+            runOne(r, s, stale);
+            if (good == stale)
+                ++same;
+            else
+            {
+                if (differ < 8)
+                    std::printf("stale differs at call %zu (start 0x%04x pc 0x%04x)\n", i, r.startPC, r.state.pc);
+                ++differ;
+            }
+        }
+        std::printf("stale-register test: %zu same, %zu differ (%zu calls started with different registers)\n", same,
+                    differ, regsChanged);
+        return 0;
+    }
+    const int timed = repeat > 1 ? repeat - 1 : 1;
+    std::printf("per call: %.1f us   per VU cycle: %.1f ns   VU cycles/call: %.0f\n",
+                totalNs / timed / records.size() / 1000.0, totalNs / (totalCycles ? totalCycles : 1),
+                double(totalCycles) / timed / records.size());
+    std::printf("gif packets/pass: %llu  gif bytes/pass: %llu\n", (unsigned long long)gifPackets,
+                (unsigned long long)gifBytes);
+    std::printf("checksum: %016llx\n", (unsigned long long)checksum);
+    return 0;
+}
