+    // Display aspect ratio of the picture for the current setting.
+    float targetAspect(float srcW, float srcH)
+    {
+        const std::string &a = g_hostSettings.aspect;
+        if (a == "16:9")
+            return 16.0f / 9.0f;
+        if (a == "native")
+            return srcW / srcH;
+        return 4.0f / 3.0f;
+    }
+
+    Rectangle computeDestination(float srcW, float srcH)
+    {
+        const float screenW = static_cast<float>(GetScreenWidth());
+        const float screenH = static_cast<float>(GetScreenHeight());
+        if (g_hostSettings.aspect == "stretch")
+            return Rectangle{0.0f, 0.0f, screenW, screenH};
+        const float aspect = targetAspect(srcW, srcH);
+        float dstH = std::min(screenH, screenW / aspect);
+        if (g_hostSettings.integerScale && dstH >= srcH)
+            dstH = std::floor(dstH / srcH) * srcH;
+        const float dstW = dstH * aspect;
+        return Rectangle{std::floor((screenW - dstW) * 0.5f), std::floor((screenH - dstH) * 0.5f), dstW, dstH};
+    }
+
+    bool useSharpFilter()
+    {
+        return g_hostSettings.filter != "smooth" && g_hostSettings.filter != "pixel";
+    }
+
+    // Sharp bilinear, step 1 (before BeginDrawing: texture mode in the middle
+    // of a frame loses raylib's screen scaling on high-DPI desktops): blow the
+    // picture up by whole numbers with nearest filtering. Step 2 then blends
+    // only the last fraction of a pixel, so it stays crisp like "pixel"
+    // without uneven, shimmering pixel widths.
+    void prepareGameFrame(Texture2D &frameTex, float srcW, float srcH)
+    {
+        if (!useSharpFilter())
+            return;
+        const Rectangle dst = computeDestination(srcW, srcH);
+        const float dpi = static_cast<float>(GetRenderWidth()) / std::max(1, GetScreenWidth());
+        const int kx = std::max(1, static_cast<int>(std::ceil(dst.width * dpi / srcW)));
+        const int ky = std::max(1, static_cast<int>(std::ceil(dst.height * dpi / srcH)));
+        const int w = static_cast<int>(srcW) * kx;
+        const int h = static_cast<int>(srcH) * ky;
+        Presenter &p = g_presenter;
+        if (w != p.prescaleW || h != p.prescaleH)
+        {
+            if (p.prescaleW != 0)
+                UnloadRenderTexture(p.prescale);
+            p.prescale = LoadRenderTexture(w, h);
+            SetTextureFilter(p.prescale.texture, TEXTURE_FILTER_BILINEAR);
+            p.prescaleW = w;
+            p.prescaleH = h;
+        }
+        SetTextureFilter(frameTex, TEXTURE_FILTER_POINT);
+        BeginTextureMode(p.prescale);
+        ClearBackground(BLACK);
+        DrawTexturePro(frameTex, Rectangle{0.0f, 0.0f, srcW, srcH},
+                       Rectangle{0.0f, 0.0f, static_cast<float>(w), static_cast<float>(h)}, Vector2{0.0f, 0.0f}, 0.0f,
+                       WHITE);
+        EndTextureMode();
+    }
+
+    void drawGameFrame(Texture2D &frameTex, float srcW, float srcH)
+    {
+        const Rectangle dst = computeDestination(srcW, srcH);
+        if (!useSharpFilter())
+        {
+            SetTextureFilter(frameTex, g_hostSettings.filter == "smooth" ? TEXTURE_FILTER_BILINEAR : TEXTURE_FILTER_POINT);
+            DrawTexturePro(frameTex, Rectangle{0.0f, 0.0f, srcW, srcH}, dst, Vector2{0.0f, 0.0f}, 0.0f, WHITE);
+            return;
+        }
+        // Render textures are stored upside down.
+        const Presenter &p = g_presenter;
+        DrawTexturePro(p.prescale.texture,
+                       Rectangle{0.0f, 0.0f, static_cast<float>(p.prescaleW), -static_cast<float>(p.prescaleH)}, dst,
+                       Vector2{0.0f, 0.0f}, 0.0f, WHITE);
+    }
+
+    void saveScreenshot()
+    {
+        rlDrawRenderBatchActive(); // the frame is still queued in raylib's batch
+        // Not LoadImageFromScreen: on scaled (high-DPI) desktops it reads past
+        // the real framebuffer and the picture comes out shifted into a corner.
+        Image shot{};
+        shot.width = GetRenderWidth();
+        shot.height = GetRenderHeight();
+        shot.mipmaps = 1;
+        shot.format = PIXELFORMAT_UNCOMPRESSED_R8G8B8A8;
+        shot.data = rlReadScreenPixels(shot.width, shot.height);
+        ImageFormat(&shot, PIXELFORMAT_UNCOMPRESSED_R8G8B8); // no transparency in the PNG
+        const std::string dir = std::string(GetApplicationDirectory()) + "screenshots";
+        if (!DirectoryExists(dir.c_str()))
+            MakeDirectory(dir.c_str());
+        const std::time_t now = std::time(nullptr);
+        char stamp[32];
+        std::strftime(stamp, sizeof(stamp), "%Y%m%d_%H%M%S", std::localtime(&now));
+        static int sequence = 0;
+        const std::string path = dir + "/xenosaga_" + stamp + "_" + std::to_string(sequence++) + ".png";
+        // Encoding a PNG takes a moment; do it off the presentation thread.
+        std::thread([shot, path]() mutable
+                    {
+            ExportImage(shot, path.c_str());
+            UnloadImage(shot); })
+            .detach();
+        showNotice("Screenshot saved");
+    }
