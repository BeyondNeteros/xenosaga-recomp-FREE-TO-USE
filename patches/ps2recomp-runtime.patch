+class GSGlBackend final : public GSRasterBackend
+{
+public:
+    GSGlBackend() = default;
+    ~GSGlBackend() override = default;
+
+    bool create();
+
+    void Initialize(uint8_t *vram, uint32_t vramSize) override
+    {
+        m_vram = vram;
+        m_cpu.Initialize(vram, vramSize);
+    }
+    void Reset() override
+    {
+        m_cpu.Reset();
+        if (onGlThread())
+            dropAllTargets();
+    }
+
+    void Submit(const GSPrimitiveBatch &batch) override;
+    void LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut) override
+    {
+        if (onGlThread())
+            flushDraws();
+        m_cpu.LoadClut(tex0, texclut);
+        ++m_clutVersion;
+    }
+    void BeginTransfer(const GSTransferCommand &command) override;
+    void UploadImage(const uint8_t *data, uint32_t sizeBytes) override;
+
+    void Flush() override
+    {
+        if (onGlThread())
+            flushDraws();
+    }
+    void TextureFlush() override {}
+    void Sync(GSSyncReason reason) override
+    {
+        if (!onGlThread())
+            return;
+        flushDraws();
+        // GS_REPLAY_GL (gs_replay): its final FINISH writes everything back to compare.
+        static const bool replay = std::getenv("GS_REPLAY_GL") != nullptr;
+        if (reason == GSSyncReason::DebugReadback || reason == GSSyncReason::Reset || reason == GSSyncReason::LocalToHost ||
+            (replay && reason == GSSyncReason::Finish))
+            syncAllToMemory();
+    }
+    PresentationFrame Present(const GSPresentationRequest &request) override
+    {
+        if (onGlThread())
+        {
+            // Only the buffers on screen: reading the one being drawn stalls
+            // the GPU for nothing.
+            flushDraws();
+            const uint32_t fbp1 = static_cast<uint32_t>(request.dispfb1 & 0x1FFu);
+            const uint32_t fbp2 = static_cast<uint32_t>(request.dispfb2 & 0x1FFu);
+            for (auto &[key, t] : m_targets)
+                if (!t.isDepth && (t.page == fbp1 || t.page == fbp2))
+                    syncToMemory(t);
+        }
+        return m_cpu.Present(request);
+    }
+
+    bool ClearFramebuffer(const GSContext &context, uint32_t rgba) override;
+    uint32_t ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes) override { return m_cpu.ConsumeLocalToHostBytes(dst, maxBytes); }
+
+    uint32_t ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const override { return m_cpu.ReadVram(psm, base, bw, x, y); }
+    void WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value) override { m_cpu.WriteVram(psm, base, bw, x, y, value); }
+    void SnapshotVram(std::vector<uint8_t> &out) const override { m_cpu.SnapshotVram(out); }
+    GSTransferSnapshot GetTransferSnapshot() const override { return m_cpu.GetTransferSnapshot(); }
+
+private:
+    struct Target
+    {
+        GLuint tex = 0;
+        uint32_t page = 0, fbw = 1;
+        uint8_t psm = GS_PSM_CT32;
+        bool isDepth = false;
+        int rows = 0;          // rows mirrored from local memory so far
+        bool gpuDirty = false; // GPU has pixels local memory lacks
+        int dx0 = 0, dy0 = 0, dx1 = 0, dy1 = 0; // the dirty rectangle (exclusive end)
+        bool stale = false;    // local memory has pixels the GPU lacks
+    };
+    struct Texture
+    {
+        GLuint tex = 0;
+        std::vector<uint64_t> cellVersions;
+        uint32_t cellW = 0, cellH = 0, cols = 0, rows = 0;
+        uint32_t lastUse = 0;
+        uint32_t texaKey = 0;
+        bool valid = false;
+    };
+
+    bool onGlThread();
+    bool claimGlThread();
+    bool compileProgram();
+    void dropAllTargets();
+    Target &colorTarget(const GSFrameReg &frame);
+    Target &depthTarget(const GSContext &ctx);
+    void ensureRows(Target &t, int rows);
+    void loadFromMemory(Target &t, int y0, int y1);
+    void syncToMemory(Target &t);
+    void syncAllToMemory();
+    void markPages(uint32_t blockBase, uint8_t psm, uint32_t bw, uint32_t x, uint32_t y, uint32_t w, uint32_t h);
+    void onMemoryWritten(uint32_t firstPage, uint32_t lastPage);
+    bool targetOverlaps(const Target &t, uint32_t firstPage, uint32_t lastPage) const;
+    GLuint bindTexture(const GSDrawState &state, Target &frame, StateBlock &block, const GSVertex *v, uint32_t count, bool &feedback);
+    Texture &decodedTexture(const GSDrawState &state);
+    int clutRow(const GSDrawState &state);
+    void flushDraws();
+    void appendVertices(const GpuVertex *v, uint32_t count);
+    void reserveVertices(GLsizeiptr bytes);
+    void markDirty(Target &t, int x0, int y0, int x1, int y1);
+
+    GSCpuBackend m_cpu;
+    uint8_t *m_vram = nullptr;
+    HWND m_hwnd = nullptr;
+    HDC m_hdc = nullptr;
+    HGLRC m_ctx = nullptr;
+    std::thread::id m_glThread{};
+    bool m_current = false;
+
+    GLuint m_program = 0, m_vao = 0, m_fbo = 0, m_vbo = 0, m_ubo = 0, m_clutTex = 0, m_snapshotTex = 0;
+    uint8_t *m_vboMap = nullptr, *m_uboMap = nullptr;
+    GLsizeiptr m_vboOffset = 0, m_uboOffset = 0;
+    GLint m_uboAlign = 256;
+
+    std::map<uint64_t, Target> m_targets; // (page, fbw, kind)
+    std::unordered_map<uint64_t, Texture> m_textures;
+    uint32_t m_useClock = 0;
+    std::array<uint64_t, kPages> m_pageVersions{};
+    GSMem::TexturePageCache m_pageCache;
+
+    std::unordered_map<uint64_t, int> m_clutRows;
+    int m_nextClutRow = 0;
+    uint64_t m_clutVersion = 1;
+    uint64_t m_lastClutKey = 0;
+    int m_lastClutRow = 0;
+
+    bool m_batchOpen = false;
+    DrawKey m_key{};
+    GLint m_batchFirst = 0;
+    GLsizei m_batchCount = 0;
+    bool m_bound = false;
+
+    std::vector<uint32_t> m_readback;
+    std::vector<uint32_t> m_decode;
+    std::vector<uint8_t> m_decode8;
+    GSTransferCommand m_transferCommand{};
