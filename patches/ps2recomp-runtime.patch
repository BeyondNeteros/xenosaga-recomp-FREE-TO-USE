+    void readIniInto(HostSettings &s, const std::string &path)
+    {
+        std::ifstream in(path);
+        std::string line;
+        while (std::getline(in, line))
+        {
+            line = trimCopy(line);
+            if (line.empty() || line[0] == ';' || line[0] == '#' || line[0] == '[')
+                continue;
+            const auto eq = line.find('=');
+            if (eq == std::string::npos)
+                continue;
+            std::string value = trimCopy(line.substr(eq + 1));
+            if (const auto comment = value.find(';'); comment != std::string::npos)
+                value = trimCopy(value.substr(0, comment));
+            applySetting(s, trimCopy(line.substr(0, eq)), value);
+        }
+    }
