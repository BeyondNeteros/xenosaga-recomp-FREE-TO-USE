+    // Pages holding rows y0..y1 of a frame/Z buffer (FBP/ZBP are whole
+    // pages): page rows are 32 (32-bit) or 64 (16-bit) pixels high and fbw*64
+    // pixels wide, so start at y0/64 and end after y1/32 to cover both.
+    void rowsRange(uint32_t baseBytes, uint32_t widthPixels, uint32_t y0, uint32_t y1, uint32_t &lo, uint32_t &hi)
+    {
+        const uint32_t pagesWide = std::max(1u, (widthPixels + 63u) / 64u);
+        const uint32_t base = baseBytes & ~(kPage - 1u);
+        lo = base + (y0 / 64u) * pagesWide * kPage;
+        hi = base + (y1 / 32u + 1u) * pagesWide * kPage;
+    }
+
+    PrimRanges primRanges(const GSPrimitiveBatch &batch)
+    {
+        PrimRanges r;
+        const GSContext &ctx = batch.state.context;
+        // Rows the primitive can touch: its vertices' y extent (as the draw
+        // loops compute it), clamped to the scissor.
+        const float ofy = static_cast<float>(ctx.xyoffset.ofy >> 4);
+        float minY = 1.0e30f, maxY = -1.0e30f;
+        const uint32_t count = std::max<uint32_t>(1u, std::min<uint32_t>(batch.vertexCount, 3u));
+        for (uint32_t i = 0; i < count; ++i)
+        {
+            minY = std::min(minY, batch.vertices[i].y - ofy);
+            maxY = std::max(maxY, batch.vertices[i].y - ofy);
+        }
+        const int sy0 = static_cast<int>(ctx.scissor.y0), sy1 = static_cast<int>(ctx.scissor.y1);
+        const int y0 = std::max(sy0, std::min(sy1, static_cast<int>(std::floor(minY)) - 1));
+        const int y1 = std::max(sy0, std::min(sy1, static_cast<int>(std::ceil(maxY)) + 1));
+        const uint32_t width = std::max<uint32_t>(ctx.frame.fbw, 1u) * 64u;
+        rowsRange(GSInternal::framePageBaseToBlock(ctx.frame.fbp) * 256u, width, static_cast<uint32_t>(y0),
+                  static_cast<uint32_t>(y1), r.flo, r.fhi);
+        r.ftag = (ctx.frame.fbp << 12) ^ (ctx.frame.fbw << 6) ^ ctx.frame.psm;
+        const uint32_t ztest = static_cast<uint32_t>((ctx.test >> 17) & 3u);
+        r.z = !ctx.zbuf.zmask || ztest >= 2u;
+        if (r.z)
+        {
+            rowsRange(GSInternal::framePageBaseToBlock(ctx.zbuf.zbp) * 256u, width, static_cast<uint32_t>(y0),
+                      static_cast<uint32_t>(y1), r.zlo, r.zhi);
+            r.ztag = 0x80000000u ^ (ctx.zbuf.zbp << 12) ^ (ctx.frame.fbw << 6) ^ ctx.zbuf.psm;
+        }
+        r.tex = batch.state.prim.tme;
+        if (r.tex)
+        {
+            // Page geometry of the texture's format (T8: 128x64, T4: 128x128,
+            // 16-bit: 64x64, everything else incl. T8H/T4HL/T4HH: 64x32).
+            const GSTex0Reg &tex = ctx.tex0;
+            uint32_t pageW = 64u, pageH = 32u;
+            switch (tex.psm)
+            {
+            case GS_PSM_T8:
+                pageW = 128u;
+                pageH = 64u;
+                break;
+            case GS_PSM_T4:
+                pageW = 128u;
+                pageH = 128u;
+                break;
+            case GS_PSM_CT16:
+            case GS_PSM_CT16S:
+            case GS_PSM_Z16:
+            case GS_PSM_Z16S:
