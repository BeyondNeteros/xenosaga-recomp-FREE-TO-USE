+    void vu0SaveShared(ThreadMap &threads, int threadId, size_t invocationDepth)
+    {
+        auto it = threads.find(threadId);
+        if (it == threads.end())
+            return;
+        auto &thread = it->second;
+        if (thread.invocations.size() < invocationDepth)
+            return; // the context that ran is gone
+        const R5900Context &ran = invocationDepth == 0 ? thread.context : thread.invocations[invocationDepth - 1].context;
+        std::memcpy(g_vu0Shared, reinterpret_cast<const uint8_t *>(&ran) + kVu0StateBegin, kVu0StateSize);
+        g_vu0SharedValid = true;
+    }
+}
