+    // A sprite that samples its own frame buffer (same address, width and
+    // format) but only ever reads pixels at or after the one being drawn, in
+    // top-to-bottom, left-to-right order: drawn alone it always sees the
+    // values from before the sprite, so it can be drawn from a VRAM copy on
+    // any number of threads. (Xenosaga's full-screen shift/blur passes.)
+    bool isForwardFeedbackSprite(const GSPrimitiveBatch &batch, const PrimRanges &r)
+    {
+        const GSDrawState &state = batch.state;
+        const GSContext &ctx = state.context;
+        const GSTex0Reg &tex = ctx.tex0;
