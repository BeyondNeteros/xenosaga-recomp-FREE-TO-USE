+// Executes one pair with results written straight into the registers: every
+// reader is held back (calculatePairReadyCycle or a static block's schedule)
+// until the value would have landed, so the delayed-write queues give the
+// same values.
+void VU1Interpreter::execPairDirect(const DecodedInstructionPair &decoded, uint8_t *vuData, uint32_t dataSize,
+                                    GS &gs, PS2Memory *memory, bool markWrites)
+{
+    uint8_t writtenVi = 0u;
+    int32_t oldVi = 0;
+    const uint16_t viWrite = decoded.lowerUsage.viWrite & 0xFFFEu;
+    if (viWrite != 0u)
+    {
+        writtenVi = static_cast<uint8_t>(__builtin_ctz(viWrite));
+        oldVi = m_state.vi[writtenVi];
+    }
