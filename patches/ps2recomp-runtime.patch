+// --- context ---------------------------------------------------------------
+
+bool GSGlBackend::create()
+{
+    WNDCLASSA wc{};
+    wc.lpfnWndProc = DefWindowProcA;
+    wc.hInstance = GetModuleHandleA(nullptr);
+    wc.lpszClassName = "XenosagaGsGl";
+    RegisterClassA(&wc);
+    m_hwnd = CreateWindowA(wc.lpszClassName, "gs", WS_OVERLAPPEDWINDOW, 0, 0, 16, 16, nullptr, nullptr, wc.hInstance, nullptr);
+    if (!m_hwnd)
+        return false;
+    m_hdc = GetDC(m_hwnd);
+    PIXELFORMATDESCRIPTOR pfd{};
+    pfd.nSize = sizeof(pfd);
+    pfd.nVersion = 1;
+    pfd.dwFlags = PFD_SUPPORT_OPENGL | PFD_DRAW_TO_WINDOW;
+    pfd.iPixelType = PFD_TYPE_RGBA;
+    pfd.cColorBits = 32;
+    if (!SetPixelFormat(m_hdc, ChoosePixelFormat(m_hdc, &pfd), &pfd))
+        return false;
+    HGLRC temp = wglCreateContext(m_hdc);
+    if (!temp || !wglMakeCurrent(m_hdc, temp))
+        return false;
+    auto createAttribs = reinterpret_cast<PFNWGLCREATECONTEXTATTRIBSARBPROC>(wglGetProcAddress("wglCreateContextAttribsARB"));
+    const int attribs[] = {WGL_CONTEXT_MAJOR_VERSION_ARB, 4, WGL_CONTEXT_MINOR_VERSION_ARB, 5,
+                           WGL_CONTEXT_PROFILE_MASK_ARB, WGL_CONTEXT_CORE_PROFILE_BIT_ARB, 0};
+    m_ctx = createAttribs ? createAttribs(m_hdc, nullptr, attribs) : nullptr;
+    wglMakeCurrent(nullptr, nullptr);
+    wglDeleteContext(temp);
+    if (!m_ctx || !wglMakeCurrent(m_hdc, m_ctx))
+        return false;
+
+#define X(type, name)                                            \
+    p_##name = reinterpret_cast<type>(wglGetProcAddress(#name)); \
+    if (!p_##name)                                               \
+    {                                                            \
+        std::fprintf(stderr, "[gs-gl] missing %s\n", #name);     \
+        return false;                                            \
+    }
+    XS_GL_FUNCS(X)
+#undef X
+
+    GLint extensions = 0;
+    glGetIntegerv(GL_NUM_EXTENSIONS, &extensions);
+    bool interlock = false;
+    for (GLint i = 0; i < extensions; ++i)
+        if (std::strcmp(reinterpret_cast<const char *>(p_glGetStringi(GL_EXTENSIONS, i)), "GL_ARB_fragment_shader_interlock") == 0)
+            interlock = true;
+    std::fprintf(stderr, "[gs-gl] %s, OpenGL %s, interlock %s\n", reinterpret_cast<const char *>(glGetString(GL_RENDERER)),
+                 reinterpret_cast<const char *>(glGetString(GL_VERSION)), interlock ? "yes" : "NO");
+    if (!interlock || !compileProgram())
+        return false;
+
+    p_glCreateVertexArrays(1, &m_vao);
+    p_glCreateFramebuffers(1, &m_fbo);
+    p_glNamedFramebufferParameteri(m_fbo, GL_FRAMEBUFFER_DEFAULT_WIDTH, kRtWidth);
+    p_glNamedFramebufferParameteri(m_fbo, GL_FRAMEBUFFER_DEFAULT_HEIGHT, kRtHeight);
+
+    const GLbitfield mapFlags = GL_MAP_WRITE_BIT | GL_MAP_PERSISTENT_BIT | GL_MAP_COHERENT_BIT;
+    p_glCreateBuffers(1, &m_vbo);
+    p_glNamedBufferStorage(m_vbo, kVertexRingBytes, nullptr, mapFlags);
+    m_vboMap = static_cast<uint8_t *>(p_glMapNamedBufferRange(m_vbo, 0, kVertexRingBytes, mapFlags));
+    p_glCreateBuffers(1, &m_ubo);
+    p_glNamedBufferStorage(m_ubo, kUniformRingBytes, nullptr, mapFlags);
+    m_uboMap = static_cast<uint8_t *>(p_glMapNamedBufferRange(m_ubo, 0, kUniformRingBytes, mapFlags));
+    glGetIntegerv(GL_UNIFORM_BUFFER_OFFSET_ALIGNMENT, &m_uboAlign);
+
+    p_glVertexArrayVertexBuffer(m_vao, 0, m_vbo, 0, sizeof(GpuVertex));
+    const struct
+    {
+        GLuint location;
+        GLint size;
+        GLenum type;
+        GLuint offset;
+    } attrs[] = {{0, 3, GL_FLOAT, offsetof(GpuVertex, x)},
+                 {1, 3, GL_FLOAT, offsetof(GpuVertex, s)},
+                 {2, 4, GL_UNSIGNED_BYTE, offsetof(GpuVertex, r)},
+                 {3, 1, GL_FLOAT, offsetof(GpuVertex, fog)}};
+    for (const auto &a : attrs)
+    {
+        p_glEnableVertexArrayAttrib(m_vao, a.location);
+        p_glVertexArrayAttribFormat(m_vao, a.location, a.size, a.type, GL_FALSE, a.offset);
+        p_glVertexArrayAttribBinding(m_vao, a.location, 0);
+    }
+
+    p_glCreateTextures(GL_TEXTURE_2D, 1, &m_clutTex);
+    p_glTextureStorage2D(m_clutTex, 1, GL_R32UI, 256, kClutRows);
+    p_glTextureParameteri(m_clutTex, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    p_glTextureParameteri(m_clutTex, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    p_glCreateTextures(GL_TEXTURE_2D, 1, &m_snapshotTex);
+    p_glTextureStorage2D(m_snapshotTex, 1, GL_R32UI, kRtWidth, kRtHeight);
+    p_glTextureParameteri(m_snapshotTex, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    p_glTextureParameteri(m_snapshotTex, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+
+    // The context moves to the thread that first draws.
+    wglMakeCurrent(nullptr, nullptr);
+    return true;
+}
+
+bool GSGlBackend::compileProgram()
+{
+    const auto compile = [](GLenum type, const char *source) -> GLuint
+    {
+        const GLuint shader = p_glCreateShader(type);
+        p_glShaderSource(shader, 1, &source, nullptr);
+        p_glCompileShader(shader);
+        GLint ok = 0;
+        p_glGetShaderiv(shader, GL_COMPILE_STATUS, &ok);
+        if (!ok)
+        {
+            char log[4096];
+            p_glGetShaderInfoLog(shader, sizeof(log), nullptr, log);
+            std::fprintf(stderr, "[gs-gl] shader error: %s\n", log);
+            return 0u;
+        }
+        return shader;
+    };
+    const GLuint vs = compile(GL_VERTEX_SHADER, kVertexShader);
+    const GLuint fs = compile(GL_FRAGMENT_SHADER, kFragmentShader);
+    if (!vs || !fs)
+        return false;
+    m_program = p_glCreateProgram();
+    p_glAttachShader(m_program, vs);
+    p_glAttachShader(m_program, fs);
+    p_glLinkProgram(m_program);
+    GLint ok = 0;
+    p_glGetProgramiv(m_program, GL_LINK_STATUS, &ok);
+    if (!ok)
+    {
+        char log[4096];
+        p_glGetProgramInfoLog(m_program, sizeof(log), nullptr, log);
+        std::fprintf(stderr, "[gs-gl] link error: %s\n", log);
+        return false;
+    }
+    return true;
+}
+
+// GL work happens on the thread that draws (the GS worker): the first draw
+// claims the context. Until then nothing has reached the GPU, so calls from
+// other threads (start-up resets) have nothing to do there.
+bool GSGlBackend::onGlThread()
+{
+    return m_current && std::this_thread::get_id() == m_glThread;
+}
+
+bool GSGlBackend::claimGlThread()
+{
+    if (!m_ctx)
+        return false;
+    if (!m_current)
+    {
+        if (!wglMakeCurrent(m_hdc, m_ctx))
+            return false;
+        m_glThread = std::this_thread::get_id();
+        m_current = true;
+        p_glUseProgram(m_program);
+        p_glBindVertexArray(m_vao);
+        p_glBindFramebuffer(GL_DRAW_FRAMEBUFFER, m_fbo);
+        glViewport(0, 0, kRtWidth, kRtHeight);
+        glEnable(GL_SCISSOR_TEST);
+        glDisable(GL_DEPTH_TEST);
+        glDisable(GL_CULL_FACE);
+        glDisable(GL_BLEND);
+        glColorMask(GL_FALSE, GL_FALSE, GL_FALSE, GL_FALSE);
+        p_glBindTextureUnit(1, m_clutTex);
+    }
+    return std::this_thread::get_id() == m_glThread;
+}
+
+// --- render targets --------------------------------------------------------
+
+void GSGlBackend::dropAllTargets()
+{
+    flushDraws();
+    for (auto &[key, t] : m_targets)
+        glDeleteTextures(1, &t.tex);
+    m_targets.clear();
+    for (auto &[key, t] : m_textures)
+        glDeleteTextures(1, &t.tex);
+    m_textures.clear();
+}
+
+GSGlBackend::Target &GSGlBackend::colorTarget(const GSFrameReg &frame)
+{
+    const uint64_t key = (static_cast<uint64_t>(frame.fbp) << 16) | (static_cast<uint64_t>(frame.fbw) << 8) | frame.psm;
+    auto it = m_targets.find(key);
+    if (it != m_targets.end())
+        return it->second;
+    Target t;
+    p_glCreateTextures(GL_TEXTURE_2D, 1, &t.tex);
+    p_glTextureStorage2D(t.tex, 1, GL_R32UI, kRtWidth, kRtHeight);
+    p_glTextureParameteri(t.tex, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    p_glTextureParameteri(t.tex, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    t.page = frame.fbp;
+    t.fbw = std::max<uint32_t>(frame.fbw, 1u);
+    t.psm = frame.psm;
+    return m_targets.emplace(key, t).first->second;
+}
+
+GSGlBackend::Target &GSGlBackend::depthTarget(const GSContext &ctx)
+{
+    const uint64_t key = (1ull << 40) | (static_cast<uint64_t>(ctx.zbuf.zbp) << 16) |
+                         (static_cast<uint64_t>(ctx.frame.fbw) << 8) | ctx.zbuf.psm;
+    auto it = m_targets.find(key);
+    if (it != m_targets.end())
+        return it->second;
+    Target t;
+    p_glCreateTextures(GL_TEXTURE_2D, 1, &t.tex);
+    p_glTextureStorage2D(t.tex, 1, GL_R32UI, kRtWidth, kRtHeight);
+    t.page = ctx.zbuf.zbp;
+    t.fbw = std::max<uint32_t>(ctx.frame.fbw, 1u);
+    t.psm = ctx.zbuf.psm;
+    t.isDepth = true;
+    return m_targets.emplace(key, t).first->second;
+}
+
+void GSGlBackend::loadFromMemory(Target &t, int y0, int y1)
+{
+    if (y1 <= y0)
+        return;
+    const uint32_t width = std::min<uint32_t>(t.fbw * 64u, kRtWidth);
+    const uint32_t block = t.page * 32u;
+    m_decode.resize(static_cast<size_t>(width) * (y1 - y0));
+    uint32_t *out = m_decode.data();
+    for (int y = y0; y < y1; ++y)
+        for (uint32_t x = 0; x < width; ++x)
+            *out++ = GSMem::ReadTexture(m_pageCache, m_vram, t.psm, block, t.fbw, x, static_cast<uint32_t>(y));
+    p_glTextureSubImage2D(t.tex, 0, 0, y0, width, y1 - y0, GL_RED_INTEGER, GL_UNSIGNED_INT, m_decode.data());
+}
+
+void GSGlBackend::ensureRows(Target &t, int rows)
+{
+    rows = std::min(rows, kRtHeight);
+    if (t.stale)
+    {
+        loadFromMemory(t, 0, std::max(t.rows, rows));
+        t.rows = std::max(t.rows, rows);
+        t.stale = false;
+        return;
+    }
+    if (rows > t.rows)
+    {
+        loadFromMemory(t, t.rows, rows);
+        t.rows = rows;
+    }
+}
+
+void GSGlBackend::markDirty(Target &t, int x0, int y0, int x1, int y1)
+{
+    if (!t.gpuDirty)
+    {
+        t.gpuDirty = true;
+        t.dx0 = x0;
+        t.dy0 = y0;
+        t.dx1 = x1;
+        t.dy1 = y1;
+        return;
+    }
+    t.dx0 = std::min(t.dx0, x0);
+    t.dy0 = std::min(t.dy0, y0);
+    t.dx1 = std::max(t.dx1, x1);
+    t.dy1 = std::max(t.dy1, y1);
+}
+
+void GSGlBackend::syncToMemory(Target &t)
+{
+    if (!t.gpuDirty)
+        return;
+    t.gpuDirty = false;
+    const int w = t.dx1 - t.dx0, h = t.dy1 - t.dy0;
+    if (w <= 0 || h <= 0)
+        return;
+    ++m_syncs;
+    p_glMemoryBarrier(GL_TEXTURE_UPDATE_BARRIER_BIT);
+    m_readback.resize(static_cast<size_t>(w) * h);
+    p_glGetTextureSubImage(t.tex, 0, t.dx0, t.dy0, 0, w, h, 1, GL_RED_INTEGER, GL_UNSIGNED_INT,
+                           static_cast<GLsizei>(m_readback.size() * 4u), m_readback.data());
+    const uint32_t block = t.page * 32u;
+    const uint32_t *in = m_readback.data();
+    for (int y = t.dy0; y < t.dy1; ++y)
+    {
+        if (t.isDepth)
+        {
+            if (t.psm == GS_PSM_Z24)
+                for (int x = t.dx0; x < t.dx1; ++x)
+                    GSMem::WriteZ24(m_vram, block, t.fbw, x, y, *in++);
+            else
+                for (int x = t.dx0; x < t.dx1; ++x)
+                    GSMem::WriteZ32(m_vram, block, t.fbw, x, y, *in++);
+        }
+        else
+        {
+            for (int x = t.dx0; x < t.dx1; ++x)
+                GSMem::WriteCT32(m_vram, block, t.fbw, x, y, *in++);
+        }
+    }
+    markPages(block, t.isDepth ? static_cast<uint8_t>(GS_PSM_Z32) : t.psm, t.fbw, t.dx0, t.dy0, w, h);
+}
+
+void GSGlBackend::syncAllToMemory()
+{
+    for (auto &[key, t] : m_targets)
+        syncToMemory(t);
+}
+
+// A local memory rectangle changed: textures over those pages decode again.
+void GSGlBackend::markPages(uint32_t blockBase, uint8_t psm, uint32_t bw, uint32_t x, uint32_t y, uint32_t w, uint32_t h)
+{
+    uint32_t pw, ph;
+    pageSize(psm, pw, ph);
+    const uint32_t wide = pagesWide(psm, bw);
+    const uint32_t basePage = blockBase / 32u;
+    const uint32_t extra = (blockBase % 32u) != 0u ? 1u : 0u;
+    for (uint32_t row = y / ph; row <= (y + h - 1u) / ph + extra; ++row)
+        for (uint32_t col = x / pw; col <= (x + w - 1u) / pw + extra; ++col)
+            ++m_pageVersions[(basePage + row * wide + col) % kPages];
+}
+
+bool GSGlBackend::targetOverlaps(const Target &t, uint32_t firstPage, uint32_t lastPage) const
+{
+    uint32_t pw, ph;
+    pageSize(t.psm, pw, ph);
+    const uint32_t rows = std::max(1, t.rows);
+    const uint32_t end = t.page + pagesWide(t.psm, t.fbw) * ((rows - 1u) / ph + 1u);
+    return firstPage < end && t.page <= lastPage;
+}
+
+// Something other than a draw wrote these pages: reload the targets over them
+// (keeping what they drew first, which reached memory before the write).
+void GSGlBackend::onMemoryWritten(uint32_t firstPage, uint32_t lastPage)
+{
+    for (auto &[key, t] : m_targets)
+        if (t.rows > 0 && targetOverlaps(t, firstPage, lastPage))
+            t.stale = true;
+}
+
+void GSGlBackend::BeginTransfer(const GSTransferCommand &command)
+{
+    if (onGlThread())
+    {
+        flushDraws();
+        // A transfer reads or partly overwrites local memory: it must be current.
+        if (command.direction == 1u || command.direction == 2u)
+            syncAllToMemory();
+        else
+        {
+            const uint32_t first = command.bitbltbuf.dbp / 32u;
+            const uint32_t last = first + pagesWide(command.bitbltbuf.dpsm, command.bitbltbuf.dbw) *
+                                              (command.trxreg.rrh / 32u + 1u);
+            for (auto &[key, t] : m_targets)
+                if (t.gpuDirty && targetOverlaps(t, first, last))
+                    syncToMemory(t);
+        }
+    }
+    m_cpu.BeginTransfer(command);
+    const auto &bb = command.bitbltbuf;
+    if (command.direction == 2u || command.direction == 0u)
+    {
+        markPages(bb.dbp, bb.dpsm, bb.dbw, command.trxpos.dsax, command.trxpos.dsay,
+                  std::max<uint32_t>(command.trxreg.rrw, 1u), std::max<uint32_t>(command.trxreg.rrh, 1u));
+        const uint32_t first = bb.dbp / 32u;
+        uint32_t pw, ph;
+        pageSize(bb.dpsm, pw, ph);
+        onMemoryWritten(first, first + pagesWide(bb.dpsm, bb.dbw) * ((command.trxpos.dsay + command.trxreg.rrh) / ph + 1u));
+    }
+    m_transferWrites = command.direction == 0u;
+    m_transferCommand = command;
+}
+
+void GSGlBackend::UploadImage(const uint8_t *data, uint32_t sizeBytes)
+{
+    m_cpu.UploadImage(data, sizeBytes);
+    if (m_transferWrites)
+    {
+        const auto &bb = m_transferCommand.bitbltbuf;
+        markPages(bb.dbp, bb.dpsm, bb.dbw, m_transferCommand.trxpos.dsax, m_transferCommand.trxpos.dsay,
+                  std::max<uint32_t>(m_transferCommand.trxreg.rrw, 1u), std::max<uint32_t>(m_transferCommand.trxreg.rrh, 1u));
+    }
+}
+
+bool GSGlBackend::ClearFramebuffer(const GSContext &context, uint32_t rgba)
+{
+    if (onGlThread())
+    {
+        flushDraws();
+        syncAllToMemory();
+    }
+    const bool ok = m_cpu.ClearFramebuffer(context, rgba);
+    const uint32_t first = context.frame.fbp;
+    onMemoryWritten(first, first + pagesWide(context.frame.psm, context.frame.fbw) * 32u);
+    return ok;
+}
+
+// --- textures --------------------------------------------------------------
+
+int GSGlBackend::clutRow(const GSDrawState &state)
+{
+    const auto &tex = state.context.tex0;
+    const uint64_t paramKey = m_clutVersion * 0x100000001B3ull ^
+                              (static_cast<uint64_t>(tex.cpsm) | (static_cast<uint64_t>(tex.csm) << 8) |
+                               (static_cast<uint64_t>(tex.csa) << 16) | (static_cast<uint64_t>(tex.psm) << 24) |
+                               (static_cast<uint64_t>(state.texa.ta0) << 32) | (static_cast<uint64_t>(state.texa.ta1) << 40) |
+                               (static_cast<uint64_t>(state.texa.aem) << 48));
+    if (paramKey == m_lastClutKey)
+        return m_lastClutRow;
+    uint32_t entries[256];
+    uint64_t hash = 0xCBF29CE484222325ull;
+    for (int i = 0; i < 256; ++i)
+    {
+        entries[i] = m_cpu.ClutEntryForGpu(state, static_cast<uint8_t>(i));
+        hash = (hash ^ entries[i]) * 0x100000001B3ull;
+    }
+    auto it = m_clutRows.find(hash);
+    int row;
+    if (it != m_clutRows.end())
+    {
+        row = it->second;
+    }
+    else
+    {
+        if (m_nextClutRow == kClutRows)
+        {
+            // All rows used: queued draws still read them, so draw those first.
+            flushDraws();
+            m_clutRows.clear();
+            m_nextClutRow = 0;
+        }
+        row = m_nextClutRow++;
+        p_glTextureSubImage2D(m_clutTex, 0, 0, row, 256, 1, GL_RED_INTEGER, GL_UNSIGNED_INT, entries);
+        m_clutRows[hash] = row;
+    }
+    m_lastClutKey = paramKey;
+    m_lastClutRow = row;
+    return row;
+}
+
+GSGlBackend::Texture &GSGlBackend::decodedTexture(const GSDrawState &state)
+{
+    const auto &tex = state.context.tex0;
+    const uint32_t width = state.textureWidth, height = state.textureHeight;
+    const bool indexed = isT8(tex.psm) || isT4(tex.psm);
+    const uint32_t texaKey = tex.psm == GS_PSM_CT32 || indexed
+                                 ? 0u
+                                 : (static_cast<uint32_t>(state.texa.ta0) | (static_cast<uint32_t>(state.texa.ta1) << 8) |
+                                    (static_cast<uint32_t>(state.texa.aem) << 16));
+    const uint64_t key = static_cast<uint64_t>(tex.tbp0) | (static_cast<uint64_t>(tex.tbw) << 14) |
+                         (static_cast<uint64_t>(tex.psm) << 20) | (static_cast<uint64_t>(tex.tw) << 26) |
+                         (static_cast<uint64_t>(tex.th) << 30) | (static_cast<uint64_t>(texaKey) << 34);
+    Texture &t = m_textures[key];
+    t.lastUse = ++m_useClock;
+    if (!t.tex)
+    {
+        p_glCreateTextures(GL_TEXTURE_2D, 1, &t.tex);
+        p_glTextureStorage2D(t.tex, 1, indexed ? GL_R8UI : GL_R32UI, width, height);
+        p_glTextureParameteri(t.tex, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+        p_glTextureParameteri(t.tex, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+        pageSize(tex.psm, t.cellW, t.cellH);
+        t.cols = (width + t.cellW - 1u) / t.cellW;
+        t.rows = (height + t.cellH - 1u) / t.cellH;
+        t.cellVersions.assign(static_cast<size_t>(t.cols) * t.rows, ~0ull);
+    }
+    // Decode the cells (one page of texels each) whose pages have changed.
+    const uint32_t basePage = tex.tbp0 / 32u;
+    const uint32_t wide = pagesWide(tex.psm, tex.tbw);
+    const bool unaligned = (tex.tbp0 % 32u) != 0u;
+    for (uint32_t row = 0; row < t.rows; ++row)
+        for (uint32_t col = 0; col < t.cols; ++col)
+        {
+            const uint32_t page = basePage + row * wide + col;
+            uint64_t version = m_pageVersions[page % kPages];
+            if (unaligned)
+                version += m_pageVersions[(page + 1u) % kPages] + m_pageVersions[(page + wide) % kPages] +
+                           m_pageVersions[(page + wide + 1u) % kPages];
+            uint64_t &seen = t.cellVersions[row * t.cols + col];
+            if (seen == version)
+                continue;
+            if (seen != ~0ull || !t.valid)
+                flushDraws(); // queued draws use the old texels
+            seen = version;
+            const uint32_t x0 = col * t.cellW, y0 = row * t.cellH;
+            const uint32_t w = std::min(t.cellW, width - x0), h = std::min(t.cellH, height - y0);
+            if (indexed)
+            {
+                std::vector<uint8_t> &out = m_decode8;
+                out.resize(static_cast<size_t>(w) * h);
+                uint8_t *o = out.data();
+                for (uint32_t y = y0; y < y0 + h; ++y)
+                    for (uint32_t x = x0; x < x0 + w; ++x)
+                        *o++ = static_cast<uint8_t>(GSMem::ReadTexture(m_pageCache, m_vram, tex.psm, tex.tbp0, tex.tbw, x, y));
+                p_glTextureSubImage2D(t.tex, 0, x0, y0, w, h, GL_RED_INTEGER, GL_UNSIGNED_BYTE, out.data());
+            }
+            else
+            {
+                m_decode.resize(static_cast<size_t>(w) * h);
+                uint32_t *o = m_decode.data();
+                for (uint32_t y = y0; y < y0 + h; ++y)
+                    for (uint32_t x = x0; x < x0 + w; ++x)
+                    {
+                        uint32_t texel = GSMem::ReadTexture(m_pageCache, m_vram, tex.psm, tex.tbp0, tex.tbw, x, y);
+                        if (tex.psm == GS_PSM_CT16 || tex.psm == GS_PSM_CT16S)
+                            texel = texaExpand(state.texa, tex.psm, expand5551(texel));
+                        else if (tex.psm != GS_PSM_CT32)
+                            texel = texaExpand(state.texa, tex.psm, texel);
+                        *o++ = texel;
+                    }
+                p_glTextureSubImage2D(t.tex, 0, x0, y0, w, h, GL_RED_INTEGER, GL_UNSIGNED_INT, m_decode.data());
+            }
+        }
+    t.valid = true;
+    return t;
+}
+
+GLuint GSGlBackend::bindTexture(const GSDrawState &state, Target &frame, StateBlock &block, const GSVertex *, uint32_t, bool &feedback)
+{
+    const auto &tex = state.context.tex0;
+    feedback = false;
+    uint32_t pw, ph;
+    pageSize(tex.psm, pw, ph);
+    const uint32_t firstPage = tex.tbp0 / 32u;
+    const uint32_t wide = pagesWide(tex.psm, tex.tbw);
+    const uint32_t lastPage = firstPage + wide * ((state.textureHeight - 1u) / ph + 1u) - 1u;
+
+    // The texture is a render target, same layout: read the GPU's copy.
+    if (tex.psm == GS_PSM_CT32 && (tex.tbp0 % 32u) == 0u)
+    {
+        const uint64_t key = (static_cast<uint64_t>(firstPage) << 16) | (static_cast<uint64_t>(tex.tbw) << 8) | GS_PSM_CT32;
+        const auto it = m_targets.find(key);
+        if (it != m_targets.end() && it->second.rows > 0)
+        {
+            Target &source = it->second;
+            ensureRows(source, source.rows);
+            block.s0[0] = 1;
+            if (&source == &frame)
+            {
+                feedback = true;
+                return m_snapshotTex;
+            }
+            return source.tex;
+        }
+    }
+    // Otherwise it decodes from local memory, which must hold what was drawn.
+    for (auto &[key, t] : m_targets)
+        if (t.gpuDirty && targetOverlaps(t, firstPage, lastPage))
+        {
+            flushDraws();
+            syncToMemory(t);
+        }
+    const bool indexed = isT8(tex.psm) || isT4(tex.psm);
+    block.s0[0] = indexed ? 2 : 1;
+    if (indexed)
+        block.s6[3] = clutRow(state);
+    return decodedTexture(state).tex;
+}
+
+// --- drawing ---------------------------------------------------------------
+
+void GSGlBackend::reserveVertices(GLsizeiptr bytes)
+{
+    if (m_vboOffset + bytes <= kVertexRingBytes)
+        return;
+    // Wrapping: wait until the GPU has used everything written so far.
+    flushDraws();
+    GLsync fence = p_glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+    p_glClientWaitSync(fence, GL_SYNC_FLUSH_COMMANDS_BIT, 5000000000ull);
+    p_glDeleteSync(fence);
+    m_vboOffset = 0;
+}
+
+void GSGlBackend::appendVertices(const GpuVertex *v, uint32_t count)
+{
+    std::memcpy(m_vboMap + m_vboOffset, v, sizeof(GpuVertex) * count);
+    m_vboOffset += sizeof(GpuVertex) * count;
+    m_batchCount += static_cast<GLsizei>(count);
+}
+
+void GSGlBackend::flushDraws()
+{
+    if (!m_batchOpen || m_batchCount == 0)
+    {
+        m_batchOpen = false;
+        return;
+    }
+    m_batchOpen = false;
+    const GLsizeiptr aligned = (sizeof(StateBlock) + m_uboAlign - 1) / m_uboAlign * m_uboAlign;
+    if (m_uboOffset + aligned > kUniformRingBytes)
+    {
+        GLsync fence = p_glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+        p_glClientWaitSync(fence, GL_SYNC_FLUSH_COMMANDS_BIT, 5000000000ull);
+        p_glDeleteSync(fence);
+        m_uboOffset = 0;
+    }
+    std::memcpy(m_uboMap + m_uboOffset, &m_key.block, sizeof(StateBlock));
+    p_glBindBufferRange(GL_UNIFORM_BUFFER, 0, m_ubo, m_uboOffset, sizeof(StateBlock));
+    m_uboOffset += aligned;
+
+    p_glBindImageTexture(0, m_key.frameTex, 0, GL_FALSE, 0, GL_READ_WRITE, GL_R32UI);
+    p_glBindImageTexture(1, m_key.depthTex, 0, GL_FALSE, 0, GL_READ_WRITE, GL_R32UI);
+    if (m_key.tex)
+    {
+        p_glBindTextureUnit(0, m_key.tex);
+        p_glMemoryBarrier(GL_TEXTURE_FETCH_BARRIER_BIT | GL_TEXTURE_UPDATE_BARRIER_BIT);
+    }
+    glScissor(m_key.scissor[0], m_key.scissor[1], m_key.scissor[2], m_key.scissor[3]);
+    p_glMemoryBarrier(GL_SHADER_IMAGE_ACCESS_BARRIER_BIT);
+    glDrawArrays(m_key.mode, m_batchFirst, m_batchCount);
+    ++m_draws;
+    m_batchCount = 0;
+}
+
+void GSGlBackend::Submit(const GSPrimitiveBatch &batch)
+{
+    if (!claimGlThread() || !m_vram || batch.vertexCount == 0u)
+        return;
+    const GSDrawState &state = batch.state;
+    const GSContext &ctx = state.context;
+    const float ofx = static_cast<float>(ctx.xyoffset.ofx >> 4);
+    const float ofy = static_cast<float>(ctx.xyoffset.ofy >> 4);
+
+    DrawKey key{};
+    StateBlock &b = key.block;
+    Target &frame = colorTarget(ctx.frame);
+    Target &depth = depthTarget(ctx);
+    const int rows = ctx.scissor.y1 + 1;
+    if (frame.stale || rows > frame.rows)
+    {
+        flushDraws();
+        ensureRows(frame, rows);
+    }
+    if (depth.stale || rows > depth.rows)
+    {
+        flushDraws();
+        ensureRows(depth, rows);
+    }
+    key.frameTex = frame.tex;
+    key.depthTex = depth.tex;
+    key.scissor[0] = ctx.scissor.x0;
+    key.scissor[1] = ctx.scissor.y0;
+    key.scissor[2] = ctx.scissor.x1 - ctx.scissor.x0 + 1;
+    key.scissor[3] = ctx.scissor.y1 - ctx.scissor.y0 + 1;
+
+    const auto &tex = ctx.tex0;
+    const uint64_t clamp = ctx.clamp;
+    b.s0[1] = tex.tfx;
+    b.s0[2] = tex.tcc;
+    b.s0[3] = state.linearFilter ? 1 : 0;
+    b.s1[0] = static_cast<int32_t>(clamp & 3u);
+    b.s1[1] = static_cast<int32_t>((clamp >> 2) & 3u);
+    b.s1[2] = state.textureWidth;
+    b.s1[3] = state.textureHeight;
+    b.s2[0] = static_cast<int32_t>((clamp >> 4) & 0x3FFu);
+    b.s2[1] = static_cast<int32_t>((clamp >> 14) & 0x3FFu);
+    b.s2[2] = static_cast<int32_t>((clamp >> 24) & 0x3FFu);
+    b.s2[3] = static_cast<int32_t>((clamp >> 34) & 0x3FFu);
+    const uint64_t test = ctx.test;
+    b.s3[0] = static_cast<int32_t>(test & 1u);
+    b.s3[1] = static_cast<int32_t>((test >> 1) & 7u);
+    b.s3[2] = static_cast<int32_t>((test >> 4) & 0xFFu);
+    b.s3[3] = static_cast<int32_t>((test >> 12) & 3u);
+    b.s4[0] = static_cast<int32_t>((test >> 17) & 3u);
+    b.s4[1] = ctx.zbuf.zmask ? 0 : 1;
+    b.s4[2] = state.prim.abe ? 1 : 0;
+    b.s4[3] = static_cast<int32_t>(ctx.fba & 1u);
+    const uint64_t alpha = ctx.alpha;
+    b.s5[0] = static_cast<int32_t>(alpha & 3u);
+    b.s5[1] = static_cast<int32_t>((alpha >> 2) & 3u);
+    b.s5[2] = static_cast<int32_t>((alpha >> 4) & 3u);
+    b.s5[3] = static_cast<int32_t>((alpha >> 6) & 3u);
+    b.s6[0] = static_cast<int32_t>((alpha >> 32) & 0xFFu);
+    b.s6[1] = state.prim.fst ? 1 : 0;
+    b.s6[2] = state.prim.iip ? 1 : 0;
+    b.s7[0] = static_cast<int32_t>((test >> 14) & 1u);
+    b.s7[1] = static_cast<int32_t>((test >> 15) & 1u);
+    b.s7[2] = state.pabe ? 1 : 0;
+    b.s8[0] = state.prim.fge ? 1 : 0;
+    b.s8[1] = state.fogR;
+    b.s8[2] = state.fogG;
+    b.s8[3] = state.fogB;
+    b.s9[0] = ctx.frame.fbmsk;
+    b.s9[1] = ctx.zbuf.psm == GS_PSM_Z32 ? 0xFFFFFFFFu : (ctx.zbuf.psm == GS_PSM_Z24 ? 0x00FFFFFFu : 0x0000FFFFu);
+
+    const auto vertex = [](const GSVertex &v, float x, float y) -> GpuVertex
+    {
+        return GpuVertex{x, y, static_cast<float>(v.z), v.s, v.t, v.q, v.r, v.g, v.b, v.a, static_cast<float>(v.fog)};
+    };
+
+    GpuVertex out[6];
+    uint32_t count = 0;
+    int bx0, by0, bx1, by1;
+    const GSPrimType type = state.prim.type;
+    if (type == GS_PRIM_SPRITE && batch.vertexCount >= 2u)
+    {
+        b.s7[3] = 1;
+        const GSVertex &v0 = batch.vertices[0], &v1 = batch.vertices[1];
+        int x0 = static_cast<int>(v0.x) - static_cast<int>(ofx), y0 = static_cast<int>(v0.y) - static_cast<int>(ofy);
+        int x1 = static_cast<int>(v1.x) - static_cast<int>(ofx), y1 = static_cast<int>(v1.y) - static_cast<int>(ofy);
+        if (x0 > x1)
+            std::swap(x0, x1);
+        if (y0 > y1)
+            std::swap(y0, y1);
+        const int spanX = std::max(1, x1 - x0), spanY = std::max(1, y1 - y0);
+        x1 = x0 + spanX;
+        y1 = y0 + spanY;
+        float u0, v0f, u1, v1f;
+        if (state.prim.fst)
+        {
+            u0 = static_cast<float>((v0.u >> 4) * 16);
+            v0f = static_cast<float>((v0.v >> 4) * 16);
+            u1 = static_cast<float>((v1.u >> 4) * 16);
+            v1f = static_cast<float>((v1.v >> 4) * 16);
+        }
+        else
+        {
+            const auto safeQ = [](float q) { return std::fabs(q) > 1.0e-8f ? q : 1.0f; };
+            u0 = v0.s / safeQ(v0.q);
+            v0f = v0.t / safeQ(v0.q);
+            u1 = v1.s / safeQ(v1.q);
+            v1f = v1.t / safeQ(v1.q);
+        }
+        const auto corner = [&](float x, float y, float s, float t) -> GpuVertex
+        {
+            return GpuVertex{x, y, std::floor(static_cast<float>(v1.z)), s, t, 1.0f, v1.r, v1.g, v1.b, v1.a, static_cast<float>(v1.fog)};
