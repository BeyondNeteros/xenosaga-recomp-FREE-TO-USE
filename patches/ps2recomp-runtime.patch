diff --git a/ps2xRuntime/include/runtime/ps2_profile.h b/ps2xRuntime/include/runtime/ps2_profile.h
new file mode 100644
index 0000000..5dc4984
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_profile.h
@@ -0,0 +1,36 @@
+#pragma once
+// Lightweight host-time counters for finding emulation bottlenecks.
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+
+namespace ps2_profile
+{
+    enum Counter : uint32_t
+    {
+        Vu1Exec,   // VU1 microprogram execution (includes XGKICK -> GS)
+        GsPacket,  // GS::processGIFPacket (GIF parsing + rasterization)
+        Vif1Parse, // VIF1 stream parsing (includes UNPACK, DIRECT -> GS)
+        GsSync,    // EE-side waits for the asynchronous GS queue (GS::sync)
+        EeIdle,    // EE scheduler waiting on host time (no guest thread ready / pacing)
+        Vif1Wait,  // EE waits for the asynchronous VIF1/VU1 worker (PS2Memory::syncVif1)
+        Count
+    };
+
+    inline std::atomic<uint64_t> g_ns[Count]{};
+    inline std::atomic<uint64_t> g_calls[Count]{};
+
+    struct Scope
+    {
+        Counter counter;
+        std::chrono::steady_clock::time_point start = std::chrono::steady_clock::now();
+        explicit Scope(Counter c) : counter(c) {}
+        ~Scope()
+        {
+            const auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                std::chrono::steady_clock::now() - start).count();
+            g_ns[counter].fetch_add(static_cast<uint64_t>(ns), std::memory_order_relaxed);
+            g_calls[counter].fetch_add(1, std::memory_order_relaxed);
+        }
+    };
+}
