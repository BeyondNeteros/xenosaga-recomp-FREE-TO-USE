new file mode 100644
index 0000000..46e0685
--- /dev/null
+++ b/ps2xIOP/src/emulator/core/iop_spu2.h
@@ -0,0 +1,160 @@
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <mutex>
+#include <vector>
+
+namespace ps2x::iop
+{
+    // SPU2 (the PS2 sound chip) as seen from the IOP: two cores of 24 voices,
+    // 2 MB of sound RAM filled by IOP DMA, and a 48 kHz stereo output that the
+    // host pulls with render() from its audio thread. Register reads and
+    // writes come from the IOP emulator thread; everything is guarded by one
+    // mutex.
+    //
+    // Implemented: voice registers, key on/off, ENDX/ENVX, PS-ADPCM decoding
+    // with loop flags, ADSR envelopes, pitch, fixed volumes, dry mixing,
+    // master volume, DMA and data-port transfers, transfer/voice IRQs.
+    // Not yet: reverb, noise, pitch modulation, volume sweeps, AutoDMA input.
+    class Spu2
+    {
+    public:
+        static constexpr uint32_t kRegisterBase = 0x1F900000u;
+        static constexpr uint32_t kRegisterSize = 0x800u;
+        static constexpr uint32_t kRamWords = 1024u * 1024u; // 2 MB of 16-bit words
+        static constexpr uint32_t kSampleRate = 48000u;
+
+        Spu2();
+
+        void reset();
+
+        [[nodiscard]] static bool isRegister(uint32_t physical) noexcept
+        {
+            return physical >= kRegisterBase && physical < kRegisterBase + kRegisterSize;
+        }
+        [[nodiscard]] uint16_t read16(uint32_t physical);
+        void write16(uint32_t physical, uint16_t value);
+
+        // IOP DMA channel 4 (core 0) / 7 (core 1): RAM <-> sound RAM at the
+        // core's transfer address (TSA), which advances.
+        void dmaWrite(int core, const uint8_t *source, size_t bytes);
+        void dmaRead(int core, uint8_t *destination, size_t bytes);
+
+        // Interleaved stereo, 48 kHz, called from the host audio thread.
+        // In synced mode (default; PS2X_SPU2_SYNC=0 turns it off) it plays
+        // what produce() rendered on IOP time, through a small cushion.
+        void render(int16_t *output, size_t frames);
+
+        // Synced mode: render the next frames on IOP time (the IOP thread
+        // calls this as its clock advances, so the sound driver's stream
+        // IRQs land when its code expects them).
+        void produce(size_t frames);
+        [[nodiscard]] static bool synced() noexcept;
+        // Counters for the heartbeat: frames dropped (ring full), underruns.
+        [[nodiscard]] uint64_t droppedFrames() const noexcept { return m_dropped.load(std::memory_order_relaxed); }
+        [[nodiscard]] uint64_t underruns() const noexcept { return m_underruns.load(std::memory_order_relaxed); }
+        // Stream chunks (driver stream area, 1 KB each) played again without
+        // a refill since their last play: an audible skip / repeat.
+        [[nodiscard]] uint64_t staleStreamChunks() const noexcept { return m_staleChunks.load(std::memory_order_relaxed); }
+        [[nodiscard]] uint64_t streamChunks() const noexcept { return m_streamChunks.load(std::memory_order_relaxed); }
+        [[nodiscard]] uint32_t bufferedFrames() const noexcept
+        {
+            return static_cast<uint32_t>(m_ringWrite.load(std::memory_order_acquire) - m_ringRead.load(std::memory_order_acquire));
+        }
+
+        // An SPU2 interrupt (IOP IRQ 9) became pending; clears the flag.
+        [[nodiscard]] bool takeInterrupt() noexcept { return m_interruptPending.exchange(false); }
+
+    private:
+        enum class EnvelopePhase : uint8_t
+        {
+            Off,
+            Attack,
+            Decay,
+            Sustain,
+            Release,
+        };
+
+        struct Voice
+        {
+            bool active = false;
+            uint32_t startAddress = 0;  // SSA (16-bit word address)
+            uint32_t loopAddress = 0;   // LSAX
+            uint32_t nextAddress = 0;   // NAX: block being played
+            bool loopSetBySoftware = false;
+            bool hasBlock = false;      // a block has been decoded since key on
+            uint32_t counter = 0;       // 4.12 fixed sample position within the block
+            int sampleIndex = 28;       // next sample to decode (28 = need a new block)
+            int16_t decoded[28]{};
+            uint8_t blockFlags = 0;
+            int32_t history1 = 0, history2 = 0;
+            int16_t previous = 0, current = 0; // for interpolation
+            EnvelopePhase phase = EnvelopePhase::Off;
+            int32_t level = 0;          // ENVX, 0..0x7FFF
+            int32_t envelopeWait = 0;
+        };
+
+        struct Core
+        {
+            std::array<Voice, 24> voices{};
+            uint32_t transferAddress = 0; // TSA
+            uint32_t endFlags = 0;        // ENDX
+            uint16_t status = 0;          // STATX: 0x80 = last DMA finished
+        };
+
+        uint16_t read16Locked(uint32_t physical);
+        void renderLocked(int16_t *output, size_t frames);
+        uint16_t &reg(uint32_t offset) { return m_regs[(offset & (kRegisterSize - 1u)) >> 1]; }
+        [[nodiscard]] uint16_t regValue(uint32_t offset) const { return m_regs[(offset & (kRegisterSize - 1u)) >> 1]; }
+        static uint32_t join(uint16_t high, uint16_t low) { return ((static_cast<uint32_t>(high) & 0xFu) << 16) | low; }
+
+        void keyOn(int core, int voice);
+        void keyOff(int core, int voice);
+        void decodeBlock(int core, Voice &v);
+        int16_t nextSample(int core, Voice &v);
+        void stepEnvelope(int core, int voiceIndex, Voice &v);
+        void checkIrq(int core, uint32_t address, uint32_t words);
+        static int32_t fixedVolume(uint16_t value);
+
+        std::mutex m_mutex;
+        std::array<uint16_t, kRegisterSize / 2u> m_regs{};
+        std::vector<uint16_t> m_ram;
+        std::array<Core, 2> m_cores{};
+
+        // Stand-in for the SPU2 reverb on each core's effect bus.
+        struct Reverb
+        {
+            static constexpr size_t kSize = 4096u;
+            static constexpr size_t kDelayA[2] = {1913u, 2113u}; // ~40-44 ms at 48 kHz
+            static constexpr size_t kDelayB[2] = {3187u, 3001u}; // ~62-66 ms
+            std::array<std::array<int32_t, kSize>, 2> line{};
+            size_t position = 0;
+        };
+        std::array<Reverb, 2> m_reverb{};
+        uint16_t m_irqInfo = 0; // 0x7C2: bit 2 + core
+        std::atomic<bool> m_interruptPending{false};
+
+        // Synced mode: single-producer (IOP thread) / single-consumer (audio
+        // thread) ring of stereo frames.
+        static constexpr uint32_t kRingFrames = 32768u; // ~680 ms
+        std::vector<int16_t> m_ring;
+        std::atomic<uint64_t> m_ringWrite{0};
+        std::atomic<uint64_t> m_ringRead{0};
+        std::atomic<uint64_t> m_dropped{0};
+        std::atomic<uint64_t> m_underruns{0};
+        static constexpr uint32_t kStreamBase = 0x3000u;  // words (byte 0x6000)
+        static constexpr uint32_t kStreamWords = 0x1000u; // 8 KB
+        void markStreamWritten(uint32_t address, uint32_t words);
+        std::array<bool, kStreamWords / 0x200u> m_chunkFresh{};
+        std::atomic<uint64_t> m_staleChunks{0};
+        std::atomic<uint64_t> m_streamChunks{0};
+        // Consumer state (audio thread only).
+        bool m_playing = false;
+        double m_fraction = 0.0;
+        double m_averageFill = 0.0;
+        int16_t m_last[2]{};
+    };
+}
