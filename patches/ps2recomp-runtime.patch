+        size_t start = 0;
+        if (text.size() > 2 && text[0] == '0' && (text[1] == 'x' || text[1] == 'X'))
+        {
+            base = 16;
+            start = 2;
+        }
+        char *end = nullptr;
+        const unsigned long value = std::strtoul(text.c_str() + start, &end, base);
+        if (!end || *end != '\0' || end == text.c_str() + start || value > max)
