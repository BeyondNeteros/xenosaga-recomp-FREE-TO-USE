+    // PS2X_VU_CAPTURE=1: record VU1 calls (state + code + data memory) to
+    // vu1_capture.bin for offline replay/profiling. Recording starts after
+    // PS2X_VU_CAPTURE_SKIP calls if that is set, or else the first time
+    // ps2x_armVu1Capture() is called (the heartbeat arms it when VU1 is the
+    // bottleneck); then 300 calls are recorded.
+    std::atomic<bool> g_vu1CaptureArmed{false};
+
+    void captureVu1Call(uint32_t kind, uint32_t startPC, uint32_t top, uint32_t itop,
+                        const VU1State &state, const uint8_t *code, const uint8_t *data)
+    {
+        static const bool enabled = [] { const char *v = std::getenv("PS2X_VU_CAPTURE"); return v && v[0] == '1'; }();
+        if (!enabled)
+            return;
+        static const uint64_t skip = [] { const char *v = std::getenv("PS2X_VU_CAPTURE_SKIP"); return v ? std::strtoull(v, nullptr, 10) : ~0ull; }();
+        // PS2X_VU_CAPTURE_FILES=N: keep capturing each time the heartbeat
+        // arms again, up to N files (vu1_capture.bin, vu1_capture_1.bin, ...).
+        static const uint32_t maxFiles = [] { const char *v = std::getenv("PS2X_VU_CAPTURE_FILES"); return v ? static_cast<uint32_t>(std::strtoul(v, nullptr, 10)) : 1u; }();
+        static uint64_t calls = 0;
+        static uint32_t recorded = 0;
+        static uint32_t files = 0;
+        static std::ofstream out;
+        if (!out.is_open())
+        {
+            if (files >= maxFiles)
+                return;
+            if (skip != ~0ull && files == 0)
+            {
+                if (++calls <= skip)
+                    return;
+            }
+            else if (!g_vu1CaptureArmed.exchange(false, std::memory_order_relaxed))
+                return;
+            const std::string name = files == 0 ? std::string("vu1_capture.bin") : "vu1_capture_" + std::to_string(files) + ".bin";
+            out.open(name, std::ios::binary);
+            const uint32_t header[4] = {0x31555658u /* XVU1 */, 1u, static_cast<uint32_t>(sizeof(VU1State)), 0u};
+            out.write(reinterpret_cast<const char *>(header), sizeof(header));
+        }
+        const uint32_t rec[4] = {kind, startPC, top, itop};
+        out.write(reinterpret_cast<const char *>(rec), sizeof(rec));
+        out.write(reinterpret_cast<const char *>(&state), sizeof(VU1State));
+        out.write(reinterpret_cast<const char *>(code), PS2_VU1_CODE_SIZE);
+        out.write(reinterpret_cast<const char *>(data), PS2_VU1_DATA_SIZE);
+        if (++recorded == 300u)
+        {
+            out.close();
+            std::printf("[vu-capture] wrote 300 VU1 calls to capture file %u\n", files);
+            ++files;
+            recorded = 0;
+        }
+    }
+
+    // Per-program VU1 statistics for the heartbeat: calls, VU cycles, host
+    // time, and how calls ended (E bit, cycle budget, or other stop).
+    struct Vu1ProgramStats
+    {
+        uint64_t calls = 0, cycles = 0, hostNs = 0, ended = 0, budget = 0, maxCycles = 0;
+    };
+    std::mutex g_vu1StatsMutex;
+    std::unordered_map<uint32_t, Vu1ProgramStats> g_vu1Stats;
+
+    void recordVu1Call(uint32_t startPC, uint64_t cycles, uint64_t hostNs, const VU1State &st, uint32_t budget)
+    {
+        std::lock_guard<std::mutex> lock(g_vu1StatsMutex);
+        Vu1ProgramStats &p = g_vu1Stats[startPC];
+        ++p.calls;
+        p.cycles += cycles;
+        p.hostNs += hostNs;
+        if (st.ebit)
+            ++p.ended;
+        else if (cycles >= budget)
+            ++p.budget;
+        if (cycles > p.maxCycles)
+            p.maxCycles = cycles;
+    }
+}
+
+void ps2x_armVu1Capture()
+{
+    g_vu1CaptureArmed.store(true, std::memory_order_relaxed);
+}
+
+// Top VU1 programs by host time since the last report, then resets.
+std::string ps2x_vu1StatsReport()
+{
+    std::vector<std::pair<uint32_t, Vu1ProgramStats>> rows;
+    {
+        std::lock_guard<std::mutex> lock(g_vu1StatsMutex);
+        rows.assign(g_vu1Stats.begin(), g_vu1Stats.end());
+        g_vu1Stats.clear();
+    }
+    std::sort(rows.begin(), rows.end(), [](const auto &a, const auto &b) { return a.second.hostNs > b.second.hostNs; });
+    std::string out;
+    char line[256];
+    for (size_t i = 0; i < rows.size() && i < 6; ++i)
+    {
+        const Vu1ProgramStats &p = rows[i].second;
+        std::snprintf(line, sizeof(line),
+                      "  vu1 prog 0x%04x: %llu calls, %.0f cyc/call (max %llu), %.1f us/call, %.1f ns/cyc, ebit %llu budget %llu\n",
+                      rows[i].first, (unsigned long long)p.calls, double(p.cycles) / p.calls, (unsigned long long)p.maxCycles,
+                      p.hostNs / 1000.0 / p.calls, p.cycles ? double(p.hostNs) / p.cycles : 0.0,
+                      (unsigned long long)p.ended, (unsigned long long)p.budget);
+        out += line;
+    }
+    return out;
+}
