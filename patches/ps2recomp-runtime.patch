+        fv = vStq.y / q * float(s1.w);
+    }
+    if (s10.x > 1 || s10.y > 1)
+        return sampleScaled(fu, fv);
+    if (s0.w == 0)
+        return ivec4(texel(int(fu), int(fv)));
+    float su = fu - 0.5, sv = fv - 0.5;
+    int u0 = int(floor(su)), v0 = int(floor(sv));
+    float fx = su - float(u0), fy = sv - float(v0);
+    vec4 c00 = vec4(texel(u0, v0)), c10 = vec4(texel(u0 + 1, v0));
+    vec4 c01 = vec4(texel(u0, v0 + 1)), c11 = vec4(texel(u0 + 1, v0 + 1));
+    vec4 top = c00 + (c10 - c00) * fx;
+    vec4 bottom = c01 + (c11 - c01) * fx;
