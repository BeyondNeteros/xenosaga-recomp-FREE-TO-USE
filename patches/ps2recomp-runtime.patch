+
+    // End of a plain pair that went through pair<>(): like plainEnd but
+    // keeps the branch-VI backup pair<>() may have recorded.
+    static PS2X_VU1_INLINE void plainEndKeepBackup(Vu &vu)
+    {
+        vu.m_state.vf[0][0] = 0.0f;
+        vu.m_state.vf[0][1] = 0.0f;
+        vu.m_state.vf[0][2] = 0.0f;
+        vu.m_state.vf[0][3] = 1.0f;
+        vu.m_state.vi[0] = 0;
+        vu.m_state.pc += 8u;
+    }
+
+    static inline bool generic(Vu &vu, uint32_t pairIndex, uint32_t codeSize, uint8_t *data, uint32_t dataSize,
+                               GS &gs, PS2Memory *memory)
+    {
+        const Vu::DecodedInstructionPair &decoded = vu.m_decodedCodeCache[pairIndex];
+        vu.execPairDirect(decoded, data, dataSize, gs, memory, false);
+        return vu.finishPair(decoded, codeSize);
+    }
+
+    static inline bool finish(Vu &vu, const Vu::StaticBlock &block, uint64_t entry, bool ended)
+    {
+        return vu.finishStaticBlock(block, entry, ended);
+    }
+
+    // ---- native programs (generated by port/tools/vu1prog.py)
+    //
+    // A native program runs a whole VU1 call (or the part of it the generator
+    // knows) with sequential semantics: every result lands at once and MAC /
+    // status / CLIP / Q / P commit immediately. That equals the cycle-accurate
+    // interpreter whenever every read sees the newest value, which the
+    // generator proves for each flag/Q/P read (writer at least its latency in
+    // pairs earlier on every path). Arithmetic is the interpreter's own: the
+    // vectorised fast paths above, else the generic path with its pipeline
+    // entries committed on the spot. Entered only with empty pipelines.
+
+    static PS2X_VU1_INLINE VU1State &st(Vu &vu) { return vu.m_state; }
+
+    // Commit everything queued by a generic instruction right now.
+    static inline void commitAllNow(Vu &vu)
+    {
+        const uint64_t saved = vu.m_cycle;
+        vu.m_cycle = ~0ull >> 2;
+        vu.commitFlagsUpTo(vu.m_cycle);
+        vu.commitReadyPipelines();
+        vu.commitFlagsUpTo(vu.m_cycle);
+        vu.m_cycle = saved;
+        vu.m_nextCommit = 0;
+    }
+
+    // MAC/status as commitFlagsUpTo applies an FMAC entry.
+    static PS2X_VU1_INLINE void commitFmacFlags(Vu &vu, int zeros, int signs, uint32_t extraSticky)
+    {
+        using namespace vu1fast;
+        vu.m_state.mac = static_cast<uint32_t>(kReverse4[zeros]) | (static_cast<uint32_t>(kReverse4[signs]) << 4);
+        const uint32_t current = (zeros ? 0x1u : 0u) | (signs ? 0x2u : 0u);
+        vu.m_state.status = (vu.m_state.status & 0xFF0u) | current | ((current | extraSticky) << 6);
+    }
+
+    // fmac() with the flag entry committed at once (same checks, same maths).
+    template <uint32_t I>
+    static PS2X_VU1_INLINE bool fmacNow(Vu &vu, vu1fast::FastOp fop, bool toAcc)
+    {
+        using namespace vu1fast;
+        constexpr uint32_t op = I & 0x3Fu;
+        constexpr uint8_t d = dest(I);
+        constexpr uint8_t fsr = fs(I);
+        constexpr uint8_t ftr = ft(I);
+        if constexpr (d == 0u)
