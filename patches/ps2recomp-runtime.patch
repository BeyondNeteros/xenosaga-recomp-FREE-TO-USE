+        const std::string dir = std::string(GetApplicationDirectory()) + "screenshots";
+        if (!DirectoryExists(dir.c_str()))
+            MakeDirectory(dir.c_str());
+        const std::time_t now = std::time(nullptr);
+        char stamp[32];
+        std::strftime(stamp, sizeof(stamp), "%Y%m%d_%H%M%S", std::localtime(&now));
+        static int sequence = 0;
+        const std::string path = dir + "/xenosaga_" + stamp + "_" + std::to_string(sequence++) + ".png";
+        // Encoding a PNG takes a moment; do it off the presentation thread.
+        std::thread([shot, path]() mutable
+                    {
+            ExportImage(shot, path.c_str());
+            UnloadImage(shot); })
+            .detach();
+        showNotice("Screenshot saved");
+    }
+
+    // Change one key in settings.ini, keeping its comments and layout; a key
+    // the file doesn't have yet goes at the end of its section.
+    void saveSettingValue(const std::string &key, const std::string &value)
+    {
+        if (g_settingsPath.empty())
+            return;
+        std::vector<std::string> lines;
+        {
+            std::ifstream in(g_settingsPath);
+            std::string line;
+            while (std::getline(in, line))
+                lines.push_back(line);
+        }
+        bool done = false;
+        for (std::string &line : lines)
+        {
+            const std::string t = trimCopy(line);
+            if (t.empty() || t[0] == ';' || t[0] == '#' || t[0] == '[')
+                continue;
+            const auto eq = t.find('=');
+            if (eq != std::string::npos && trimCopy(t.substr(0, eq)) == key)
+            {
+                line = key + " = " + value;
+                done = true;
+                break;
+            }
+        }
+        if (!done)
+        {
+            const std::string section = (key == "volume" || key == "mute_when_unfocused") ? "[audio]"
+                                        : (key == "one_hit_kill" || key == "no_encounters") ? "[debug]"
+                                                                                             : "[display]";
+            bool hasSection = false;
+            for (const std::string &line : lines)
+                hasSection = hasSection || trimCopy(line) == section;
+            if (!hasSection)
+            {
+                lines.push_back("");
+                lines.push_back(section);
+                lines.push_back("; Testing aids, also in the F1 menu.");
+            }
+            size_t at = lines.size();
+            for (size_t i = 0; i < lines.size(); ++i)
+                if (trimCopy(lines[i]) == section)
+                {
+                    at = i + 1;
+                    while (at < lines.size() && !trimCopy(lines[at]).empty() && trimCopy(lines[at])[0] != '[')
+                        ++at;
+                    break;
+                }
+            lines.insert(lines.begin() + static_cast<std::ptrdiff_t>(at), key + " = " + value);
+        }
+        std::ofstream out(g_settingsPath, std::ios::trunc);
+        for (const std::string &line : lines)
+            out << line << "\n";
+        g_rawSettings[key] = value;
+    }
+
+    void setAspect(const std::string &aspect)
+    {
+        g_hostSettings.aspect = aspect;
+        g_widescreen.store(aspect == "16:9");
+        // Widescreen also draws more pixels across (GPU renderer).
+        ps2x_glSetResolution(g_hostSettings.upscale, aspect == "16:9");
