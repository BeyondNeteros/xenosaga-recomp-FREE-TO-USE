+        const int spanY = std::max(1, y1 - y0);
+        if (x0 + spanX - 1 < ctx.scissor.x0 || x0 > ctx.scissor.x1 || y0 + spanY - 1 < ctx.scissor.y0 || y0 > ctx.scissor.y1)
