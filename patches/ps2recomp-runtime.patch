+int wrapCoord(int c, int size, int mode, int lo, int hi)
+{
+    if (mode == 0) return c & (size - 1);
+    if (mode == 1) return clamp(c, 0, size - 1);
+    if (mode == 2) return min(max(c, lo), hi);
+    return (c & lo) | hi;
+}
+uvec4 texel(int u, int v)
+{
+    u = wrapCoord(u, s1.z, s1.x, s2.x, s2.y);
+    v = wrapCoord(v, s1.w, s1.y, s2.z, s2.w);
+    uint raw = texelFetch(uTex, ivec2(u, v), 0).r;
+    if (s0.x == 2) raw = texelFetch(uClut, ivec2(int(raw & 255u), s6.w), 0).r;
+    return uvec4(raw & 255u, (raw >> 8) & 255u, (raw >> 16) & 255u, raw >> 24);
+}
+// A texel of an upscaled render target: (U, V) in scaled pixels. Wrapping
+// works on the native texel, the sub-pixel inside it is kept.
+uvec4 texelScaled(int U, int V)
+{
+    int SX = s10.x, SY = s10.y;
+    int nu = U >= 0 ? U / SX : -((SX - 1 - U) / SX);
+    int nv = V >= 0 ? V / SY : -((SY - 1 - V) / SY);
+    int u = wrapCoord(nu, s1.z, s1.x, s2.x, s2.y) * SX + (U - nu * SX);
+    int v = wrapCoord(nv, s1.w, s1.y, s2.z, s2.w) * SY + (V - nv * SY);
+    uint raw = texelFetch(uTex, ivec2(u, v), 0).r;
+    return uvec4(raw & 255u, (raw >> 8) & 255u, (raw >> 16) & 255u, raw >> 24);
