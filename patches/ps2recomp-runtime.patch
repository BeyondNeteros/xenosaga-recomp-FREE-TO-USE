+// Applies the block's final register readiness and the cycle after its last
+// pair (shared with generated native blocks).
+bool VU1Interpreter::finishStaticBlock(const StaticBlock &block, uint64_t entry, bool ended)
+{
+    const __m256i base = _mm256_set1_epi64x(static_cast<long long>(entry));
+    for (const FinalVf &f : block.finalVf)
+    {
+        const __m256i offs = _mm256_cvtepu16_epi64(_mm_loadl_epi64(reinterpret_cast<const __m128i *>(f.offset)));
+        const __m256i mask = _mm256_cmpgt_epi64(
+            _mm256_and_si256(_mm256_set1_epi64x(f.mask), _mm256_setr_epi64x(1, 2, 4, 8)), _mm256_setzero_si256());
+        // Load/blend/store: vpmaskmovq stores are microcoded and slow on some CPUs.
+        __m256i *lanes = reinterpret_cast<__m256i *>(m_vfReady[f.reg].data());
+        _mm256_storeu_si256(lanes, _mm256_blendv_epi8(_mm256_loadu_si256(lanes), _mm256_add_epi64(base, offs), mask));
+    }
+    for (const StaticLane &l : block.finalWrites)
+    {
+        const uint64_t readyCycle = entry + l.offset;
+        if (l.kind == 1)
+            m_viReady[l.reg] = readyCycle;
+        else
+            m_accReady[l.lane] = readyCycle;
+    }
+    m_readyMax = std::max(m_readyMax, entry + block.finalMax);
+    advanceOneCycle();
+    return ended;
+}
