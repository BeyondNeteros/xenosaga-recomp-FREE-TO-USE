+
+// Channel 4 (toIPU): the next quadword of the transfer, following DMA chain
+// tags like the DMAC (refe/cnt/next/ref/refs/end). False when the channel is
+// stopped or finished (STR cleared, D_STAT CIS4 set).
+bool PS2Memory::ipuFetchQword(uint8_t qword[16])
+{
+    constexpr uint32_t kBase = 0x1000B400u;
+    uint32_t &chcr = m_ioRegisters[kBase + 0x00u];
+    uint32_t &madr = m_ioRegisters[kBase + 0x10u];
+    uint32_t &qwc = m_ioRegisters[kBase + 0x20u];
+    uint32_t &tadr = m_ioRegisters[kBase + 0x30u];
+    const auto mem = [this](uint32_t address) -> uint8_t * {
+        if (address & 0x80000000u)
+            return m_scratchpad + (address & 0x3FF0u);
+        return m_rdram + (address & 0x01FFFFF0u);
+    };
+    const auto finish = [&]() {
+        chcr &= ~0x100u;
+        qwc = 0;
+        completeDmacChannel(kBase, 4u);
+        return false;
+    };
+    if (!(chcr & 0x100u))
+        return false;
+    static int logBudget = [] { const char *e = std::getenv("PS2X_IPU_LOG"); return e ? std::atoi(e) : 0; }();
+    if (logBudget > 0 && !m_d4AfterData)
+    {
+        --logBudget;
+        std::printf("[ipu-dma] fetch start chcr=0x%08x madr=0x%08x qwc=0x%x tadr=0x%08x\n", chcr, madr, qwc, tadr);
+    }
+    for (int guard = 0; guard < 1024; ++guard)
+    {
+        if ((qwc & 0xFFFFu) != 0u)
+        {
+            if (!qword) // prime only: the channel now points at data, as the DMAC would right after a start
+                return true;
+            std::memcpy(qword, mem(madr), 16u);
+            madr += 16u;
+            qwc = (qwc & ~0xFFFFu) | ((qwc - 1u) & 0xFFFFu);
+            m_d4AfterData = true;
+            return true;
+        }
+        if (((chcr >> 2) & 3u) != 1u) // normal mode: done
+            return finish();
+        const uint32_t lastId = (chcr >> 28) & 7u;
+        if (m_d4AfterData && (lastId == 0u || lastId == 7u)) // refe / end
+            return finish();
+        uint64_t tag = 0;
+        std::memcpy(&tag, mem(tadr), sizeof(tag));
+        if (logBudget > 0)
+        {
+            --logBudget;
+            std::printf("[ipu-dma] tag @0x%08x = 0x%016llx\n", tadr, static_cast<unsigned long long>(tag));
+            const uint32_t at = static_cast<uint32_t>(tag >> 32) & 0x01FFFFF0u;
+            for (uint32_t row = at - 32u; row < at + 32u; row += 16u)
+            {
+                std::printf("[ipu-dma]   %08x:", row);
+                for (uint32_t i = 0; i < 16u; ++i)
+                    std::printf(" %02x", m_rdram[(row + i) & 0x01FFFFFFu]);
+                std::printf("\n");
+            }
+        }
+        const uint32_t tagQwc = static_cast<uint32_t>(tag & 0xFFFFu);
+        const uint32_t id = static_cast<uint32_t>((tag >> 28) & 7u);
+        const uint32_t addr = static_cast<uint32_t>((tag >> 32) & 0xFFFFFFF0u);
+        chcr = (chcr & 0xFFFFu) | (static_cast<uint32_t>(tag >> 16) & 0xFFFF0000u);
+        m_d4AfterData = false;
+        switch (id)
+        {
+        case 0: // refe
+        case 3: // ref
+        case 4: // refs
+            madr = addr;
+            tadr += 16u;
+            break;
+        case 1: // cnt
+            madr = tadr + 16u;
+            tadr = madr + tagQwc * 16u;
+            break;
+        case 2: // next
+            madr = tadr + 16u;
+            tadr = addr;
+            break;
+        case 7: // end
+            madr = tadr + 16u;
+            break;
+        default: // call/ret: not used by IPU streams
+            return finish();
+        }
+        qwc = tagQwc;
+        if (tagQwc == 0u)
+            m_d4AfterData = true; // an empty refe/end still ends the chain
+    }
+    return finish();
+}
+
+// Channel 3 (fromIPU): copies decoded output while the channel runs.
+void PS2Memory::ipuServiceFromDma()
+{
+    constexpr uint32_t kBase = 0x1000B000u;
+    uint32_t &chcr = m_ioRegisters[kBase + 0x00u];
+    if (!(chcr & 0x100u))
+        return;
+    uint32_t &madr = m_ioRegisters[kBase + 0x10u];
+    uint32_t &qwc = m_ioRegisters[kBase + 0x20u];
+    static int logBudget = [] { const char *e = std::getenv("PS2X_IPU_LOG"); return e ? std::atoi(e) : 0; }();
+    if (logBudget > 0)
+    {
+        --logBudget;
+        std::printf("[ipu-out] madr=0x%08x qwc=0x%x available=%zu\n", madr, qwc, m_ipu->outputQwords());
+    }
+    uint8_t q[16];
+    while ((qwc & 0xFFFFu) != 0u && m_ipu->popOutput(q))
+    {
+        uint8_t *dst = (madr & 0x80000000u) ? m_scratchpad + (madr & 0x3FF0u) : m_rdram + (madr & 0x01FFFFF0u);
+        std::memcpy(dst, q, 16u);
+        madr += 16u;
+        qwc = (qwc & ~0xFFFFu) | ((qwc - 1u) & 0xFFFFu);
+    }
+    if ((qwc & 0xFFFFu) == 0u)
+    {
+        chcr &= ~0x100u;
+        completeDmacChannel(kBase, 3u);
+    }
+}
