+    void applySetting(HostSettings &s, const std::string &key, const std::string &value)
+    {
+        g_rawSettings[key] = value;
+        if (key == "fullscreen") s.fullscreen = parseBool(value, s.fullscreen);
+        else if (key == "aspect") s.aspect = value;
+        else if (key == "filter") s.filter = value;
+        else if (key == "renderer") s.renderer = value;
+        else if (key == "integer_scale") s.integerScale = parseBool(value, s.integerScale);
+        else if (key == "vsync") s.vsync = parseBool(value, s.vsync);
+        else if (key == "monitor") s.monitor = std::atoi(value.c_str());
+        else if (key == "show_fps") s.showFps = parseBool(value, s.showFps);
+        else if (key == "hide_cursor") s.hideCursor = parseBool(value, s.hideCursor);
+        else if (key == "volume") s.volume = std::clamp(std::atoi(value.c_str()), 0, 100);
+        else if (key == "mute_when_unfocused") s.muteWhenUnfocused = parseBool(value, s.muteWhenUnfocused);
+        else if (key == "window_width") s.windowWidth = std::atoi(value.c_str());
+        else if (key == "window_height") s.windowHeight = std::atoi(value.c_str());
+    }
